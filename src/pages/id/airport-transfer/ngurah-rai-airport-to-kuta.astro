---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppFloat from '../../../components/WhatsAppFloat.astro';

const pageTitle = 'Transfer Bandara Ngurah Rai ke Kuta | Antar Jemput Bandara Pribadi Bali';
const pageDescription = 'Pesan transfer pribadi dari Bandara Ngurah Rai ke Kuta — salah satu rute bandara terpendek di Bali, dengan supir yang menunggu di kedatangan dan antar langsung ke hotel atau villa Anda.';
const pageKeywords = 'transfer bandara ngurah rai ke kuta, bandara bali ke kuta, antar jemput bandara kuta, transfer bandara pribadi kuta, bandara DPS ke kuta, jemput bandara kuta bali, bali west transport';

const whatsappText = 'Halo, saya ingin memesan transfer dari Bandara Ngurah Rai ke Kuta. Mohon informasi penawaran terbaik Anda.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const keunggulan = [
  'Supir menunggu di area kedatangan dengan papan nama',
  'Salah satu transfer bandara terpendek di Bali',
  'Antar langsung ke hotel, villa, dan resort di seluruh Kuta',
  'Kendaraan pribadi ber-AC yang nyaman',
  'Bantuan pengangkatan bagasi termasuk',
  'Pemantauan penerbangan — penjemputan disesuaikan jika penerbangan terlambat',
  'Penjemputan bandara tersedia 24 jam',
  'Tanpa antri taksi atau tawar-menawar harga setelah penerbangan panjang'
];

const areaKuta = [
  'Pantai Kuta',
  'Jalan Legian',
  'Kuta Square',
  'Tuban',
  'Double Six Beach',
  'Pasar Seni Kuta'
];

const atraksiKuta = [
  'Sunset Pantai Kuta',
  'Waterbom Bali',
  'Beachwalk Shopping Centre',
  'Pasar Seni Kuta',
  'Pantai Legian',
  'Kuta Theatre'
];

const tabelRute = [
  { rute: 'Bandara Bali ke Pantai Kuta', jarak: '4–7 km', waktu: '10–20 mnt' },
  { rute: 'Bandara Bali ke Jalan Legian', jarak: '5–8 km', waktu: '12–22 mnt' },
  { rute: 'Bandara Bali ke Tuban', jarak: '2–4 km', waktu: '8–15 mnt' },
  { rute: 'Bandara Bali ke Kuta Square', jarak: '5–7 km', waktu: '12–20 mnt' },
  { rute: 'Bandara Bali ke Double Six Beach', jarak: '6–9 km', waktu: '15–25 mnt' },
];

const faq = [
  {
    pertanyaan: 'Berapa jauh Kuta dari Bandara Bali?',
    jawaban: 'Kuta berjarak sekitar 4 hingga 8 kilometer dari Bandara Internasional I Gusti Ngurah Rai, menjadikannya salah satu kawasan wisata terdekat dari bandara.'
  },
  {
    pertanyaan: 'Berapa lama perjalanan dari Bandara Bali ke Kuta?',
    jawaban: 'Perjalanan biasanya memakan waktu 10 hingga 20 menit dalam kondisi lalu lintas normal. Pada jam sibuk — terutama sore hari di sekitar Jalan Legian dan jalur pantai — bisa memakan waktu 30 hingga 40 menit.'
  },
  {
    pertanyaan: 'Apakah tetap worth it memesan transfer pribadi untuk rute sedekat ini?',
    jawaban: 'Banyak wisatawan tetap memilih transfer yang sudah dipesan sebelumnya untuk Kuta karena menghindari antrian taksi dan tawar-menawar harga tepat setelah mendarat. Supir Anda sudah menunggu di area kedatangan dengan papan nama, siap berangkat — tanpa perlu mencari kendaraan setelah penerbangan panjang, dan tanpa perlu jalan ke titik penjemputan ride-hailing tertentu sambil membawa bagasi.'
  },
  {
    pertanyaan: 'Apa cara terbaik dari Bandara Ngurah Rai ke Kuta?',
    jawaban: 'Transfer bandara pribadi adalah salah satu pilihan paling nyaman karena menyediakan supir yang menunggu di area kedatangan, bantuan bagasi, dan antar langsung ke hotel atau villa tanpa perlu antri taksi atau tawar-menawar harga.'
  },
  {
    pertanyaan: 'Apakah tersedia transfer ke Tuban dan Legian?',
    jawaban: 'Ya. Transfer bandara tersedia ke seluruh kawasan Kuta termasuk Tuban, Jalan Legian, Kuta Square, dan Double Six Beach.'
  },
  {
    pertanyaan: 'Bisakah memesan transfer bandara sebelum tiba di Bali?',
    jawaban: 'Ya. Pemesanan lebih awal sangat dianjurkan, terutama pada periode liburan padat, untuk memastikan supir sudah siap dan terkonfirmasi saat Anda mendarat.'
  }
];

const ruteTerkait = [
  { label: 'Hub Transfer Bandara', href: '/id/airport-transfer/' },
  { label: 'Bandara ke Nusa Dua', href: '/id/airport-transfer/ngurah-rai-airport-to-nusa-dua/' },
  { label: 'Bandara ke Seminyak', href: '/id/airport-transfer/ngurah-rai-airport-to-seminyak/' },
  { label: 'Bandara ke Ubud', href: '/id/airport-transfer/ngurah-rai-airport-to-ubud/' },
  { label: 'Gilimanuk ke Kuta', href: '/id/transfers/gilimanuk-to-kuta/' },
  { label: 'Semua Transfer Bali', href: '/id/transfers/' }
];

const pageUrl = 'https://baliwesttransport.com/id/airport-transfer/ngurah-rai-airport-to-kuta/';
const orgId = `${pageUrl}#organization`;
const agencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      address: { '@type': 'PostalAddress', addressLocality: 'Bali', addressCountry: 'ID' }
    },
    {
      '@type': 'TravelAgency',
      '@id': agencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: { '@type': 'AdministrativeArea', name: 'Bali, Indonesia' },
      parentOrganization: { '@id': orgId }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Transfer Bandara Ngurah Rai ke Kuta',
      alternateName: 'Ngurah Rai Airport to Kuta Transfer',
      description: pageDescription,
      serviceType: 'Transfer Bandara Pribadi',
      provider: { '@id': agencyId },
      availableLanguage: [{ '@type': 'Language', name: 'Indonesian' }, { '@type': 'Language', name: 'English' }],
      areaServed: [
        { '@type': 'Place', name: 'Bandara Ngurah Rai Internasional' },
        { '@type': 'Place', name: 'Kuta' },
        { '@type': 'Place', name: 'Tuban' },
        { '@type': 'Place', name: 'Legian' },
        { '@type': 'AdministrativeArea', name: 'Bali' }
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: { '@type': 'ContactPoint', telephone: '+6282247648944', contactType: 'customer service' }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.pertanyaan,
        acceptedAnswer: { '@type': 'Answer', text: item.jawaban }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://baliwesttransport.com/id/' },
        { '@type': 'ListItem', position: 2, name: 'Transfer Bandara', item: 'https://baliwesttransport.com/id/airport-transfer/' },
        { '@type': 'ListItem', position: 3, name: 'Transfer Bandara Ngurah Rai ke Kuta', item: pageUrl }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id',
      isPartOf: { '@id': orgId },
      about: { '@id': serviceId },
      mainEntity: [{ '@id': serviceId }, { '@id': faqId }],
      breadcrumb: { '@id': breadcrumbId },
      publisher: { '@id': orgId }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} includeOrgSchema={false}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/beach-sunset-swing.jpg"
          alt="Transfer pribadi dari Bandara Ngurah Rai ke Kuta Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Antar Jemput Bandara Pribadi — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Transfer Bandara Ngurah Rai ke Kuta</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Antar jemput door-to-door dari Bandara Bali ke Kuta — melayani Pantai Kuta, Jalan Legian, Tuban, dan Kuta Square.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan Transfer Sekarang
          </a>
          <a href="/id/airport-transfer/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Hub Transfer Bandara</a>
        </div>
      </div>
    </section>

    <!-- Intro + Info Cepat -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Antar Jemput Bandara Pribadi</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Transfer Pribadi dari Bandara Bali ke Kuta</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Pesan transfer dari Bandara Ngurah Rai ke Kuta bersama Bali West Transport. Perjalanan memakan waktu sekitar 10 hingga 20 menit tergantung lalu lintas, dengan layanan door-to-door yang nyaman untuk wisatawan yang tiba di Bandara Internasional I Gusti Ngurah Rai (DPS).
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Kuta adalah salah satu kawasan wisata terdekat dari bandara, dikenal dengan pantai sunset yang panjang, ombak surfing, kehidupan belanja dan malam di Jalan Legian, serta akses mudah ke Waterbom Bali. Karena rutenya pendek, sebagian wisatawan mengira transfer tidak diperlukan — tapi supir yang sudah dipesan sebelumnya tetap berarti tanpa antrian taksi, tanpa tawar-menawar harga, dan tanpa perlu jalan ke titik penjemputan ride-hailing tertentu setelah penerbangan panjang.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Baik Anda tiba larut malam, bepergian bersama keluarga, atau hanya ingin memulai liburan dengan mudah, memesan transfer bandara pribadi adalah salah satu cara termudah untuk langsung menuju Kuta dari Bandara Bali.
            </p>
          </div>
          <div class="bg-white p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-6">Informasi Cepat</p>
            <div class="space-y-4">
              {[
                ['Layanan', 'Transfer Bandara Bali ke Kuta'],
                ['Lokasi Jemput', 'Bandara Ngurah Rai Internasional (DPS)'],
                ['Tujuan', 'Kuta, Bali'],
                ['Jenis Kendaraan', 'Mobil Pribadi dengan Supir'],
                ['Estimasi Waktu Tempuh', '10–20 Menit'],
                ['Ketersediaan', '24 Jam'],
                ['Armada', 'Kendaraan Pribadi Ber-AC'],
                ['Jenis Layanan', 'Jemput Bandara & Antar ke Hotel'],
                ['Penyedia', 'Bali West Transport'],
              ].map(([label, value]) => (
                <div class="flex justify-between gap-4 border-b border-brand-dark/10 pb-4">
                  <span class="text-brand-dark/50 text-sm">{label}</span>
                  <span class="text-brand-dark font-medium text-sm text-right">{value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ringkasan Rute -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-cream p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Rute</p>
              <p class="font-serif text-2xl text-brand-dark">DPS → Kuta</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Jarak</p>
              <p class="font-serif text-2xl text-brand-dark">4–8 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Waktu</p>
              <p class="font-serif text-2xl text-brand-dark">10–20 mnt</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Penawaran Fleksibel</span>
              <p class="text-brand-dark/50 text-sm mt-1">Informasikan tanggal & jumlah penumpang.</p>
            </div>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
            >
              Minta Penawaran Terbaik
            </a>
          </div>
        </div>
        <div class="mt-6 bg-brand-cream p-6">
          <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Estimasi Waktu Tempuh</p>
          <div class="grid grid-cols-3 gap-3">
            {[
              'Dini hari: 8–12 mnt',
              'Lalu lintas normal: 15–20 mnt',
              'Jam sibuk: 30–40 mnt'
            ].map((item) => (
              <div class="bg-white p-3 text-brand-dark/70 text-sm text-center">{item}</div>
            ))}
          </div>
          <p class="text-brand-dark/50 text-sm mt-4">Kuta adalah salah satu rute bandara terpendek di Bali. Titik perlambatan utama adalah Jalan Legian dan jalur pantai saat sore hari, yang bisa menambah 15–20 menit ke perjalanan.</p>
        </div>
      </div>
    </section>

    <!-- Mengapa Pilih Transfer Pribadi -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Cara Terbaik Menuju Kuta</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Mengapa Pilih Transfer Bandara Pribadi ke Kuta</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Meski rutenya pendek, transfer bandara pribadi tetap berarti tanpa antrian taksi, tanpa tawar-menawar harga, dan supir yang sudah menunggu langsung di area kedatangan.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {keunggulan.map((item) => (
            <div class="flex items-start gap-4 p-6 bg-white">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Area Kuta yang Dilayani -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jangkauan Pengantaran</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Transfer Bandara ke Semua Area Kuta</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Bali West Transport menyediakan transfer bandara ke seluruh kawasan Kuta dan Tuban di sekitarnya. Baik Anda menginap dekat pantai, di Jalan Legian, maupun dekat Kuta Square, kami melayani semua area utama.
            </p>
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Area Kuta yang Dilayani</p>
            <div class="grid grid-cols-2 gap-3 mb-6">
              {areaKuta.map((area) => (
                <div class="bg-brand-cream p-4 text-brand-dark/70 text-sm">{area}</div>
              ))}
            </div>
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Atraksi Populer di Sekitar</p>
            <div class="grid grid-cols-2 gap-3">
              {atraksiKuta.map((atraksi) => (
                <div class="bg-brand-cream p-4 text-brand-dark/70 text-sm">{atraksi}</div>
              ))}
            </div>
          </div>
          <div class="space-y-4">
            <img
              src="/images/nusa-penida-viewpoint.jpg"
              alt="Transfer bandara ke Kuta Bali kawasan pantai"
              class="w-full h-64 object-cover"
              loading="lazy"
            />
            <img
              src="/images/kelingking-beach.jpg"
              alt="Pantai Kuta dan Jalan Legian Bali"
              class="w-full h-48 object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Perbandingan Pilihan Transportasi -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Perbandingan</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Cara dari Bandara Bali ke Kuta</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Tersedia beberapa pilihan transportasi dari Bandara Ngurah Rai ke Kuta. Berikut perbandingannya untuk membantu Anda memilih.</p>
        </div>
        <div class="grid md:grid-cols-4 gap-4 mb-12">
          {[
            { jenis: 'Transfer Bandara Pribadi', cocok: 'Keluarga, kedatangan malam, rombongan', bagasi: 'Ya', langsung: 'Ya' },
            { jenis: 'Taksi Bandara', cocok: 'Perjalanan fleksibel', bagasi: 'Ya', langsung: 'Ya' },
            { jenis: 'Ride-Hailing (Grab/Gojek)', cocok: 'Wisatawan hemat', bagasi: 'Terbatas', langsung: 'Ya' },
            { jenis: 'Jalan Kaki', cocok: 'Bagasi sangat ringan, hotel dekat Tuban', bagasi: 'Terbatas', langsung: 'Ya' },
          ].map((opt) => (
            <div class="bg-white p-6">
              <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">{opt.jenis}</p>
              <div class="space-y-3 text-sm">
                <div>
                  <span class="text-brand-dark/40 block text-xs mb-1">Cocok Untuk</span>
                  <span class="text-brand-dark/70">{opt.cocok}</span>
                </div>
                <div>
                  <span class="text-brand-dark/40 block text-xs mb-1">Ramah Bagasi</span>
                  <span class="text-brand-dark/70">{opt.bagasi}</span>
                </div>
                <div>
                  <span class="text-brand-dark/40 block text-xs mb-1">Transfer Langsung</span>
                  <span class="text-brand-dark/70">{opt.langsung}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
        <p class="text-brand-dark/60 text-sm text-center">Karena Kuta sangat dekat dengan bandara, sebagian wisatawan memilih jalan kaki atau ride-hailing — namun keluarga, kedatangan malam hari, dan wisatawan dengan bagasi umumnya tetap lebih memilih transfer pribadi yang sudah dipesan untuk kepastian supir yang menunggu di kedatangan.</p>
      </div>
    </section>

    <!-- Tabel Ringkasan Perjalanan -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Ikhtisar Rute</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Ringkasan Perjalanan Bandara Bali ke Kuta</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Jarak dan estimasi waktu tempuh dari Bandara Ngurah Rai ke masing-masing tujuan di kawasan Kuta.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-brand-dark text-brand-cream">
                <th class="text-left px-6 py-4 font-medium tracking-wide">Rute</th>
                <th class="text-left px-6 py-4 font-medium tracking-wide">Jarak</th>
                <th class="text-left px-6 py-4 font-medium tracking-wide">Estimasi Waktu Tempuh</th>
              </tr>
            </thead>
            <tbody>
              {tabelRute.map((baris, i) => (
                <tr class={i % 2 === 0 ? 'bg-brand-cream' : 'bg-white'}>
                  <td class="px-6 py-4 text-brand-dark font-medium">{baris.rute}</td>
                  <td class="px-6 py-4 text-brand-dark/70">{baris.jarak}</td>
                  <td class="px-6 py-4 text-brand-dark/70">{baris.waktu}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-brand-dark/50 text-sm mt-4">Waktu tempuh merupakan estimasi dan dapat bervariasi tergantung kondisi lalu lintas dan waktu perjalanan.</p>
      </div>
    </section>

    <!-- Penjemputan di Bandara -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jemput di Bandara</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Penjemputan di Bandara Bali</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Setibanya di Bandara Ngurah Rai, supir Anda akan menunggu di area setelah pengambilan bagasi dengan papan nama. Supir akan membantu membawa bagasi dan mengantar Anda ke kendaraan sebelum memulai perjalanan singkat ke Kuta.
            </p>
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Layanan Ini Sangat Berguna Untuk</p>
            <div class="grid grid-cols-2 gap-3">
              {[
                'Wisatawan pertama kali ke Bali',
                'Keluarga dengan anak-anak',
                'Kedatangan malam hari',
                'Penerbangan dini hari',
                'Rombongan dengan banyak koper',
                'Wisatawan yang tidak ingin antri'
              ].map((item) => (
                <div class="bg-white p-4 text-brand-dark/70 text-sm">{item}</div>
              ))}
            </div>
          </div>
          <div>
            <img
              src="/images/beach-sunset-swing.jpg"
              alt="Transfer ke Kuta Bali sunset"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Mengapa Bali West Transport -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Mengapa Pilih Kami</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Mengapa Memilih Bali West Transport?</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Bali West Transport menyediakan layanan transportasi pribadi di seluruh Bali untuk transfer bandara, transfer hotel, supir pribadi, dan tur Bali yang disesuaikan.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
          {[
            'Supir lokal profesional',
            'Layanan transportasi pribadi',
            'Kendaraan ber-AC yang nyaman',
            'Penjemputan bandara tersedia 24/7',
            'Antar langsung ke hotel dan villa',
            'Pemantauan penerbangan untuk keterlambatan',
            'Jangkauan layanan di seluruh Bali'
          ].map((alasan) => (
            <div class="flex items-start gap-4 p-6 bg-brand-cream">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{alasan}</span>
            </div>
          ))}
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          <a href="/id/airport-transfer/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Hub Transfer Bandara</span>
          </a>
          <a href="/id/tours/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Tur Pribadi Bali</span>
          </a>
          <a href="/id/about/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Tentang Bali West Transport</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Pertanyaan yang Sering Diajukan</h2>
        </div>
        <div class="space-y-4">
          {faq.map((item) => (
            <div class="bg-white p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.pertanyaan}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.jawaban}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 bg-brand-dark text-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12 text-center">
        <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pesan Sekarang</p>
        <h2 class="font-serif text-4xl md:text-5xl mb-6">Pesan Transfer Bandara Ngurah Rai ke Kuta</h2>
        <p class="text-brand-cream/70 text-lg mb-10 max-w-2xl mx-auto">
          Baik Anda menginap dekat Pantai Kuta, di Jalan Legian, maupun di Tuban, Bali West Transport menyediakan transfer bandara pribadi yang nyaman dan terpercaya langsung ke akomodasi Anda.
        </p>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-12 py-5 text-sm tracking-widest uppercase transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Pesan via WhatsApp
        </a>
      </div>
    </section>

    <!-- Rute Terkait -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Rute Transfer Bandara Lainnya</p>
          <h2 class="font-serif text-3xl text-brand-dark">Tujuan Transfer Bandara Bali Lainnya</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {ruteTerkait.map((rute) => (
            <a href={rute.href} class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
              <span class="text-brand-dark font-medium text-sm">{rute.label}</span>
            </a>
          ))}
        </div>
        <div class="mt-6 text-center">
          <a href="/airport-transfer/ngurah-rai-airport-to-kuta/" class="text-brand-dark/40 hover:text-brand-dark/70 text-sm transition-colors">
