---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';

const pageTitle = 'Ngurah Rai Airport to Kuta Transfer | Distance, Travel Time & Private Pickup';
const pageDescription = 'Travel from Ngurah Rai Airport to Kuta with a private airport transfer. Learn the real distance, honest travel time, and direct hotel pickup with Bali West Transport.';
const pageKeywords = 'Ngurah Rai Airport to Kuta, Bali Airport to Kuta, Denpasar Airport to Kuta, airport transfer Bali to Kuta, Kuta airport transfer, DPS Airport to Kuta, private airport transfer Kuta, Bali West Transport';

const whatsappText = 'Hi, I would like to book a private transfer from Ngurah Rai Airport to Kuta. Please send me your best offer.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const quickInfo = [
  ['Route', 'Ngurah Rai Airport (DPS) → Kuta'],
  ['Distance', '5–8 km'],
  ['Travel Time', '10–30 minutes'],
  ['Service Type', 'Private Airport Transfer'],
  ['Best For', 'First-time visitors, surfers, backpackers, short layovers'],
  ['Airport Code', 'DPS'],
  ['Destination Coverage', 'Kuta Beach, Kuta Square, Legian border, Tuban'],
];

const benefits = [
  'Driver waiting at arrivals area, no queueing at the taxi counter',
  'Fixed offer agreed before you land, no on-arrival haggling',
  'Comfortable air-conditioned vehicle with space for surfboards and extra luggage',
  'Flight monitoring for delayed arrivals',
  'Luggage assistance included',
  'Direct drop-off at your hotel, not a shared drop-off point',
  'Suitable for solo travellers, couples, and groups',
  'Useful for short layovers between flights or ferries'
];

const kutaReasons = [
  "Bali's original tourist beach and most beginner-friendly surf break",
  'The closest major tourist strip to Ngurah Rai Airport',
  'Widest range of budget and mid-range hotels in South Bali',
  'Beachwalk Mall, Discovery Shopping Mall, and Kuta Art Market',
  'One of the most famous sunset viewpoints on the island',
  'Restaurants and nightlife along Jalan Legian'
];

const routeTable = [
  { condition: 'Late Night', time: '8–15 minutes' },
  { condition: 'Normal Traffic', time: '15–25 minutes' },
  { condition: 'Peak Hours / Sunset Traffic', time: '30–45 minutes' },
];

const transferOptions = [
  {
    title: 'Private Airport Transfer',
    best: 'Travellers who want a fixed price and direct hotel drop-off',
    details: 'Even over a short distance, a pre-booked transfer means no walk to a pickup zone, no fare negotiation, and a driver who already knows your hotel.'
  },
  {
    title: 'Airport Taxi',
    best: 'Flexible travellers who prefer on-arrival transport',
    details: 'Official airport taxis are available just outside arrivals and are a reasonable option for the short hop into Kuta if you are happy to queue.'
  },
  {
    title: 'Grab and Gojek',
    best: 'Solo travellers with light luggage',
    details: 'Ride-hailing apps must collect you from a designated pickup zone away from the terminal, which can add more walking and waiting time than the drive itself.'
  },
  {
    title: 'Walking',
    best: 'Travellers staying in Tuban with no luggage',
    details: 'Parts of Tuban border the airport directly, so walking is technically possible for some hotels, but it is not practical with luggage or in Bali\'s heat and humidity.'
  },
];

const arrivalPeriods = [
  { period: 'Morning Arrivals', time: '10–20 minutes', note: 'Generally the quickest period for the short run into Kuta.' },
  { period: 'Afternoon Arrivals', time: '15–30 minutes', note: 'Traffic builds up gradually along Jalan Raya Tuban and Jalan Kartika Plaza.' },
  { period: 'Evening / Sunset Arrivals', time: '25–45 minutes', note: 'Beachfront roads get congested as visitors head to Kuta Beach for sunset.' },
  { period: 'Late-Night Arrivals', time: '8–15 minutes', note: 'The fastest time of day to reach Kuta from the airport.' },
];

const faqs = [
  {
    question: 'How far is Kuta from Bali Airport?',
    answer: 'Kuta is one of the closest tourist areas to Ngurah Rai Airport, roughly 5 to 8 kilometres away depending on your exact hotel between Tuban and central Kuta.'
  },
  {
    question: 'Can I walk from the airport to Kuta?',
    answer: 'Parts of Tuban, on the southern edge of Kuta, do border the airport, so walking is technically possible for a few hotels. It is not recommended with luggage, and most of Kuta is still a proper drive away.'
  },
  {
    question: 'How long does a transfer from the airport to Kuta actually take?',
    answer: 'Despite the short distance, travel time typically ranges from 10 to 30 minutes, and can stretch to 30 to 45 minutes during peak traffic or around sunset when beachfront roads get busy.'
  },
  {
    question: 'Why book a private transfer for such a short distance?',
    answer: 'For a trip this short, the value is convenience rather than comfort over a long ride: no queue at the taxi counter, a fixed price agreed before landing, and a direct drop-off at your hotel with your luggage or surfboard.'
  },
  {
    question: 'Is Kuta a good place for first-time visitors to Bali?',
    answer: 'Yes. Kuta has Bali\'s most beginner-friendly surf beach, the widest range of budget and mid-range accommodation, and is the closest tourist area to the airport, which makes arrival logistics simple.'
  },
  {
    question: 'What is the difference between Kuta, Legian, and Tuban?',
    answer: 'These three areas sit next to each other along the same stretch of coast. Tuban is quieter and closest to the airport, Kuta is the busiest and most central, and Legian to the north is generally calmer with a more upscale feel.'
  }
];

const relatedRoutes = [
  { label: 'Airport Transfer Hub', href: '/airport-transfer/' },
  { label: 'Airport to Seminyak', href: '/airport-transfer/ngurah-rai-airport-to-seminyak/' },
  { label: 'Airport to Canggu', href: '/airport-transfer/ngurah-rai-airport-to-canggu/' },
  { label: 'Airport to Uluwatu', href: '/airport-transfer/ngurah-rai-airport-to-uluwatu/' },
  { label: 'Airport to Nusa Dua', href: '/airport-transfer/ngurah-rai-airport-to-nusa-dua/' },
  { label: 'All Bali Transfers', href: '/transfers/' }
];

const pageUrl = 'https://baliwesttransport.com/airport-transfer/ngurah-rai-airport-to-kuta/';
const organizationId = `${pageUrl}#organization`;
const travelAgencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': organizationId, name: 'Bali West Transport', url: 'https://baliwesttransport.com/', logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png', telephone: '+6282247648944', sameAs: [] },
    { '@type': 'TravelAgency', '@id': travelAgencyId, name: 'Bali West Transport', url: 'https://baliwesttransport.com/', telephone: '+6282247648944', areaServed: { '@type': 'AdministrativeArea', name: 'Bali, Indonesia' }, parentOrganization: { '@id': organizationId } },
    { '@type': 'Service', '@id': serviceId, name: 'Ngurah Rai Airport to Kuta Transfer', description: pageDescription, serviceType: 'Private Airport Transfer', provider: { '@id': travelAgencyId }, areaServed: [{ '@type': 'Place', name: 'I Gusti Ngurah Rai International Airport' }, { '@type': 'Place', name: 'Kuta' }, { '@type': 'Place', name: 'Tuban' }, { '@type': 'Place', name: 'Legian' }, { '@type': 'AdministrativeArea', name: 'Bali' }], availableChannel: { '@type': 'ServiceChannel', serviceUrl: pageUrl, servicePhone: { '@type': 'ContactPoint', telephone: '+6282247648944', contactType: 'customer service' } } },
    { '@type': 'FAQPage', '@id': faqId, mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
    { '@type': 'BreadcrumbList', '@id': breadcrumbId, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://baliwesttransport.com/' }, { '@type': 'ListItem', position: 2, name: 'Airport Transfer', item: 'https://baliwesttransport.com/airport-transfer/' }, { '@type': 'ListItem', position: 3, name: 'Ngurah Rai Airport to Kuta Transfer', item: pageUrl }] },
    { '@type': 'WebPage', '@id': webPageId, url: pageUrl, name: pageTitle, description: pageDescription, isPartOf: { '@id': organizationId }, about: { '@id': serviceId }, mainEntity: [{ '@id': serviceId }, { '@id': faqId }], breadcrumb: { '@id': breadcrumbId }, publisher: { '@id': organizationId } }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} includeOrgSchema={false}>
  <Header />

  <main>
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img src="/images/beach-sunset-swing.jpg" alt="Ngurah Rai Airport to Kuta private transfer Bali" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Private Airport Transfer — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Ngurah Rai Airport to Kuta Transfer</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-3xl mx-auto font-light drop-shadow-md">Private airport pickup from Bali Airport to Kuta Beach, Kuta Square, and the Legian border.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors">Book Your Transfer</a>
          <a href="/airport-transfer/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Airport Transfer Hub</a>
        </div>
      </div>
    </section>

    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Quick Answer</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Travelling from Bali Airport to Kuta</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">Kuta is one of the shortest transfers in Bali, sitting only 5 to 8 kilometres from Ngurah Rai Airport. In light traffic the drive can take as little as 10 minutes, though it commonly takes 15 to 30 minutes, and can stretch past 30 minutes around sunset when the beachfront roads fill up. We would rather tell you that honestly than oversell a five-minute hop.</p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">For a distance this short, the point of a private transfer isn't a long, comfortable ride, it's skipping the taxi queue, having a fixed price agreed before you land, and getting a direct drop-off at your hotel instead of a shared pickup point.</p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">This route suits first-time visitors, surfers with boards or extra gear, backpackers, and anyone with a short layover between flights or ferries who wants one less thing to figure out after landing.</p>
          </div>
          <div class="bg-white p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-6">Quick Information</p>
            <div class="space-y-4">
              {quickInfo.map(([label, value]) => (
                <div class="flex justify-between gap-4 border-b border-brand-dark/10 pb-4">
                  <span class="text-brand-dark/50 text-sm">{label}</span>
                  <span class="text-brand-dark font-medium text-sm text-right">{value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-cream p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div><p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Route</p><p class="font-serif text-2xl text-brand-dark">DPS → Kuta</p></div>
            <div><p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Distance</p><p class="font-serif text-2xl text-brand-dark">5–8 km</p></div>
            <div><p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Time</p><p class="font-serif text-2xl text-brand-dark">10–30 min</p></div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div><span class="font-serif text-4xl text-brand-gold">Best Offer</span><p class="text-brand-dark/50 text-sm mt-1">Tell us your date, flight time, and hotel name.</p></div>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap">Ask Best Offer</a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Why Kuta</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Stay in Kuta?</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Kuta is Bali's original beach resort town and still its most accessible, sitting right next to the airport with the island's widest spread of budget and mid-range places to stay.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {kutaReasons.map((reason) => (
            <div class="flex items-start gap-4 p-6 bg-white"><div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5"><svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg></div><span class="text-brand-dark/70">{reason}</span></div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Distance & Route</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">How Far Is Bali Airport from Kuta?</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">The distance from Bali Airport to Kuta is only about 5 to 8 kilometres, making it one of the closest tourist areas to Ngurah Rai Airport. There is no toll road on this route; traffic runs via Jalan Raya Tuban, Jalan Kartika Plaza, and Jalan Legian.</p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">Because the distance is so short, traffic conditions matter more than kilometres. A near-empty road at 3am can mean an 8-minute ride, while the same route around sunset, when everyone heads to Kuta Beach, can take three or four times as long.</p>
          </div>
          <div class="bg-brand-cream p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-6">Average Travel Times</p>
            <div class="space-y-4">
              {routeTable.map((row) => (
                <div class="flex justify-between gap-4 border-b border-brand-dark/10 pb-4"><span class="text-brand-dark/50 text-sm">{row.condition}</span><span class="text-brand-dark font-medium text-sm text-right">{row.time}</span></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16"><p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Transfer Options</p><h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Best Ways to Get from Ngurah Rai Airport to Kuta</h2></div>
        <div class="grid md:grid-cols-4 gap-4">
          {transferOptions.map((option) => (
            <div class="bg-white p-6"><p class="text-brand-gold text-xs tracking-widest uppercase mb-3">{option.title}</p><p class="text-brand-dark font-medium mb-3">{option.best}</p><p class="text-brand-dark/70 text-sm leading-relaxed">{option.details}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Kuta, Legian & Tuban</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Which Part of Kuta Are You Staying In?</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">Kuta, Legian, and Tuban run along one continuous stretch of coast, so "Kuta" on a hotel booking can mean very different transfer times. Tuban sits closest to the airport and is generally quieter, central Kuta is the busiest with the most nightlife and shopping, and Legian to the north is calmer with a slightly more upscale feel.</p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">Telling your driver the exact hotel name and area, rather than just "Kuta", helps avoid confusion at drop-off since street numbering in this part of Bali is not always straightforward.</p>
          </div>
          <img src="/images/nusa-penida-viewpoint.jpg" alt="South Bali beach area near Kuta" class="w-full h-auto object-cover" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16"><p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Arrival Periods</p><h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Bali Airport to Kuta Travel Time by Arrival Period</h2></div>
        <div class="grid md:grid-cols-4 gap-4">
          {arrivalPeriods.map((item) => (
            <div class="bg-white p-6"><p class="font-serif text-2xl text-brand-dark mb-2">{item.period}</p><p class="text-brand-gold text-xl mb-3">{item.time}</p><p class="text-brand-dark/70 text-sm leading-relaxed">{item.note}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16"><p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Why Choose Us</p><h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Choose Bali West Transport?</h2><p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Bali West Transport provides private transportation services across Bali for airport transfers, hotel transfers, private drivers, and customised Bali tours.</p></div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
          {benefits.map((benefit) => (
            <div class="flex items-start gap-4 p-6 bg-brand-cream"><div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5"><svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg></div><span class="text-brand-dark/70">{benefit}</span></div>
          ))}
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          <a href="/airport-transfer/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors"><span class="text-brand-dark font-medium">Airport Transfer Hub</span></a>
          <a href="/airport-transfer/ngurah-rai-airport-to-seminyak/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors"><span class="text-brand-dark font-medium">Airport to Seminyak</span></a>
          <a href="/airport-transfer/ngurah-rai-airport-to-nusa-dua/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors"><span class="text-brand-dark font-medium">Airport to Nusa Dua</span></a>
        </div>
      </div>
    </section>

    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16"><p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p><h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Frequently Asked Questions</h2></div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="bg-white p-8"><h3 class="font-serif text-2xl text-brand-dark mb-3">{faq.question}</h3><p class="text-brand-dark/70 leading-relaxed">{faq.answer}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 bg-brand-dark text-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12 text-center">
        <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Book Now</p>
        <h2 class="font-serif text-4xl md:text-5xl mb-6">Book Your Ngurah Rai Airport to Kuta Transfer</h2>
        <p class="text-brand-cream/70 text-lg mb-10 max-w-2xl mx-auto">Whether you are staying near Kuta Beach, Kuta Square, or on the Legian border, Bali West Transport provides a fixed-price, no-queue private transfer from Ngurah Rai Airport straight to your hotel.</p>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-12 py-5 text-sm tracking-widest uppercase transition-colors">Book Via WhatsApp</a>
      </div>
    </section>

    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12"><p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Related Airport Transfer Routes</p><h2 class="font-serif text-3xl text-brand-dark">Other Bali Airport Transfer Destinations</h2></div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {relatedRoutes.map((route) => (
            <a href={route.href} class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors"><span class="text-brand-dark font-medium text-sm">{route.label}</span></a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>
