---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = t('meta.home.desc'), keywords = t('meta.home.keywords') } = Astro.props;
const rawPathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonicalURL = new URL(rawPathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/baliwesttransport-favicon.png" />
    <link rel="apple-touch-icon" href="/baliwesttransport-favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Hreflang for multilingual SEO -->
    <link rel="alternate" hreflang="en" href={new URL(rawPathname.replace(/^\/id\//, '/'), Astro.site)} />
    <link rel="alternate" hreflang="id" href={new URL(`/id${rawPathname.replace(/^\/id\//, '/') === '/' ? '/' : rawPathname.replace(/^\/id\//, '/')}`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(rawPathname.replace(/^\/id\//, '/'), Astro.site)} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.jpg" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Microsoft Clarity -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "x3lt2dcq1d");
    </script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5BG4D25WBF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5BG4D25WBF');
    </script>

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TravelAgency",
      "name": "Bali West Transport",
      "description": description,
      "url": "https://baliwesttransport.com",
      "telephone": ["+6282247648944", "+6285737866348"],
      "email": "info@baliwesttransport.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Gilimanuk",
        "addressRegion": "Bali",
        "addressCountry": "ID"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "-8.1622",
        "longitude": "114.4417"
      },
      "areaServed": [
        { "@type": "Place", "name": "Bali" },
        { "@type": "Place", "name": "Gilimanuk" },
        { "@type": "Place", "name": "Ubud" },
        { "@type": "Place", "name": "Seminyak" },
        { "@type": "Place", "name": "Kuta" },
        { "@type": "Place", "name": "Nusa Penida" }
      ],
      "priceRange": "$$",
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      },
      "sameAs": [
        "https://wa.me/6282247648944"
      ]
    })} />
  </head>
  <body class="font-sans antialiased text-brand-dark bg-brand-cream">
    <slot />

    <!-- GA4 Button Tracking + Session Attribution -->
    <script is:inline>
      (function () {
        // --- 1. Save UTM + referrer + landing page on first visit of session ---
        var SESSION_KEY = 'bwt_session';
        var stored = sessionStorage.getItem(SESSION_KEY);
        if (!stored) {
          var params = new URLSearchParams(window.location.search);
          var referrer = document.referrer || '';
          var source = params.get('utm_source') || '';

          // Infer source from referrer when no UTM
          if (!source && referrer) {
            if (referrer.includes('google')) source = 'google_organic';
            else if (referrer.includes('bing')) source = 'bing_organic';
            else if (referrer.includes('facebook') || referrer.includes('fb.com')) source = 'facebook';
            else if (referrer.includes('instagram')) source = 'instagram';
            else if (referrer.includes('chatgpt') || referrer.includes('openai')) source = 'chatgpt';
            else if (referrer.includes('gemini') || referrer.includes('bard')) source = 'gemini';
            else if (referrer.includes('perplexity')) source = 'perplexity';
            else source = referrer.split('/')[2] || 'direct';
          }
          if (!source) source = 'direct';

          sessionStorage.setItem(SESSION_KEY, JSON.stringify({
            source: source,
            medium: params.get('utm_medium') || '',
            campaign: params.get('utm_campaign') || '',
            referrer: referrer,
            landing_page: window.location.pathname
          }));
        }

        // --- 2. Button tracking after DOM ready ---
        document.addEventListener('DOMContentLoaded', function () {
          if (typeof gtag === 'undefined') return;

          function getSession() {
            try { return JSON.parse(sessionStorage.getItem(SESSION_KEY)) || {}; }
            catch (e) { return {}; }
          }

          function getLocation(el) {
            if (el.closest('header')) return 'header';
            if (el.closest('footer')) return 'footer';
            if (el.closest('.fixed')) return 'float_button';
            var sections = Array.from(document.querySelectorAll('main section'));
            var idx = sections.findIndex(function (s) { return s.contains(el); });
            if (idx === 0) return 'hero';
            if (idx === sections.length - 1 && idx > 0) return 'cta_bottom';
            if (idx > 0) return 'section_' + (idx + 1);
            return 'page';
          }

          // Track all WhatsApp button clicks
          document.querySelectorAll('a[href*="wa.me"]').forEach(function (el) {
            el.addEventListener('click', function () {
              var session = getSession();
              var eventName = el.dataset.gaEvent || 'whatsapp_click';
              var location = el.dataset.gaLocation || getLocation(el);
              gtag('event', eventName, {
                event_category: 'lead',
                button_location: location,
                button_text: (el.textContent.trim() || 'icon').substring(0, 60),
                page_path: window.location.pathname,
                source: session.source || '',
                medium: session.medium || '',
                campaign: session.campaign || '',
                referrer: session.referrer || '',
                landing_page: session.landing_page || ''
              });
            });
          });

          // Track phone call clicks
          document.querySelectorAll('a[href^="tel:"]').forEach(function (el) {
            el.addEventListener('click', function () {
              var session = getSession();
              gtag('event', 'phone_call', {
                event_category: 'lead',
                button_location: el.dataset.gaLocation || getLocation(el),
                page_path: window.location.pathname,
                source: session.source || '',
                landing_page: session.landing_page || ''
              });
            });
          });

          // Track internal navigation cards/buttons with data-ga-event
          document.querySelectorAll('[data-ga-event]').forEach(function (el) {
            if (el.href && (el.href.includes('wa.me') || el.href.startsWith('tel:'))) return;
            el.addEventListener('click', function () {
              gtag('event', el.dataset.gaEvent, {
                event_category: el.dataset.gaCategory || 'navigation',
                event_label: el.dataset.gaLabel || '',
                page_path: window.location.pathname
              });
            });
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  .font-serif {
    font-family: 'Playfair Display', Georgia, serif;
  }
</style>
