---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const videos = [
  { src: "/videos/bali-tour-1.mp4", title: lang === 'en' ? "Scenic Drive" : "Perjalanan Indah" },
  { src: "/videos/bali-tour-2.mp4", title: lang === 'en' ? "Beach Views" : "Pemandangan Pantai" },
  { src: "/videos/bali-tour-3.mp4", title: lang === 'en' ? "Temple Visit" : "Kunjungan Pura" },
  { src: "/videos/bali-tour-4.mp4", title: lang === 'en' ? "Rice Terraces" : "Sawah Terasering" },
];
---

<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">
        {lang === 'en' ? "Real Moments" : "Momen Nyata"}
      </p>
      <h2 class="font-serif text-4xl md:text-5xl font-medium text-brand-dark">
        {lang === 'en' ? "Experience the Journey" : "Rasakan Perjalanannya"}
      </h2>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {videos.map((video) => (
        <div class="relative group overflow-hidden aspect-[9/16] bg-brand-dark/5">
          <video 
            src={video.src}
            class="w-full h-full object-cover"
            muted
            loop
            playsinline
            preload="metadata"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
            <p class="text-white text-sm font-medium">{video.title}</p>
          </div>
          <button 
            class="video-play-btn absolute inset-0 flex items-center justify-center bg-black/20 hover:bg-black/30 transition-colors"
            aria-label="Play video"
          >
            <div class="w-12 h-12 rounded-full bg-white/90 flex items-center justify-center group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5 text-brand-dark ml-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </button>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.video-play-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const container = (e.currentTarget as HTMLElement).parentElement;
      const video = container?.querySelector('video');
      const playBtn = e.currentTarget as HTMLElement;
      
      if (video) {
        if (video.paused) {
          // Pause all other videos first
          document.querySelectorAll('video').forEach(v => {
            if (v !== video) {
              v.pause();
              const otherBtn = v.parentElement?.querySelector('.video-play-btn') as HTMLElement;
              if (otherBtn) otherBtn.style.opacity = '1';
            }
          });
          
          video.play();
          playBtn.style.opacity = '0';
        } else {
          video.pause();
          playBtn.style.opacity = '1';
        }
      }
    });
  });
  
  // Pause video when it ends or when clicking outside
  document.querySelectorAll('video').forEach((video) => {
    video.addEventListener('ended', () => {
      const playBtn = video.parentElement?.querySelector('.video-play-btn') as HTMLElement;
      if (playBtn) playBtn.style.opacity = '1';
    });
  });
</script>
