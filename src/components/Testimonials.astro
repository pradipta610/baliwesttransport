---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const testimonials = [
  {
    name: "Sarah Mitchell",
    location: "London, UK",
    text: lang === 'en' 
      ? "An absolutely magical experience. Our guide knew all the hidden spots away from the crowds. The sunrise at Lempuyang was breathtaking."
      : "Pengalaman yang benar-benar ajaib. Pemandu kami tahu semua tempat tersembunyi yang jauh dari keramaian. Matahari terbit di Lempuyang sangat memukau.",
    rating: 5,
    image: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&fit=crop&crop=face"
  },
  {
    name: "James & Emily",
    location: "Sydney, Australia",
    text: lang === 'en'
      ? "We've traveled extensively, but this was something special. The attention to detail and personalized service made our honeymoon unforgettable."
      : "Kami sudah sering bepergian, tapi ini sesuatu yang istimewa. Perhatian terhadap detail dan layanan personal membuat bulan madu kami tak terlupakan.",
    rating: 5,
    image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop&crop=face"
  },
  {
    name: "Michael Chen",
    location: "San Francisco, USA",
    text: lang === 'en'
      ? "Professional, punctual, and incredibly knowledgeable. They crafted a perfect itinerary that balanced adventure with relaxation."
      : "Profesional, tepat waktu, dan sangat berpengetahuan. Mereka menyusun rencana perjalanan sempurna yang menyeimbangkan petualangan dengan relaksasi.",
    rating: 5,
    image: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&fit=crop&crop=face"
  },
  {
    name: "Anna Bergström",
    location: "Stockholm, Sweden",
    text: lang === 'en'
      ? "The private transfer from Gilimanuk was seamless. Clean car, friendly driver, and they even had cold water waiting for us."
      : "Antar jemput pribadi dari Gilimanuk sangat mulus. Mobil bersih, supir ramah, dan mereka bahkan menyediakan air dingin untuk kami.",
    rating: 5,
    image: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&fit=crop&crop=face"
  },
];
---

<section class="py-24 bg-brand-dark text-brand-cream">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">{t('testimonials.subtitle')}</p>
      <h2 class="font-serif text-4xl md:text-5xl font-medium">{t('testimonials.title')}</h2>
    </div>
    
    <div class="grid md:grid-cols-2 gap-8">
      {testimonials.map((testimonial) => (
        <div class="bg-white/5 backdrop-blur p-8 md:p-10">
          <div class="flex gap-1 mb-6">
            {[...Array(testimonial.rating)].map(() => (
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-brand-cream/80 text-lg leading-relaxed mb-8 italic">"{testimonial.text}"</p>
          <div class="flex items-center gap-4">
            <img 
              src={testimonial.image} 
              alt={testimonial.name}
              class="w-12 h-12 rounded-full object-cover"
              loading="lazy"
            />
            <div>
              <p class="font-medium">{testimonial.name}</p>
              <p class="text-brand-cream/60 text-sm">{testimonial.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
