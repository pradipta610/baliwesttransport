---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppFloat from '../../../components/WhatsAppFloat.astro';

const pageTitle = 'Transfer Pribadi Gilimanuk ke Tanah Lot | Bali West Transport';
const pageDescription = 'Pesan transfer pribadi dari Pelabuhan Gilimanuk ke Pura Tanah Lot. Rute tersingkat Bali West Transport — sekitar 110 km, 2,5–3,5 jam. Booking via WhatsApp, penawaran terbaik tersedia.';
const pageKeywords = 'transfer gilimanuk ke tanah lot, taksi gilimanuk tanah lot, transfer pribadi gilimanuk tanah lot, transportasi pelabuhan ke pura tanah lot';

const whatsappText = 'Halo, saya ingin memesan transfer pribadi dari Gilimanuk ke Tanah Lot. Mohon informasi penawaran terbaik Anda.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const keunggulan = [
  'Rute transfer tersingkat dan tercepat di jaringan Gilimanuk',
  'Tanpa perpindahan antara ferry, bus, dan taksi — satu perjalanan langsung',
  'Waktu fleksibel memungkinkan Anda merencanakan sesuai jadwal matahari terbenam dan pasang surut di Tanah Lot',
  'Antar langsung ke pintu masuk temple, resor golf, atau vila terdekat',
  'Pengemudi berbahasa Inggris yang menguasai rute Gilimanuk–Tanah Lot',
  'Layanan door-to-door dengan harga pasti — tanpa tawar-menawar saat tiba'
];

const lokasiJemput = [
  'Pelabuhan Gilimanuk',
  'Kota Gilimanuk dan hotel-hotel sekitarnya',
  'Area Pantai Karangsewu',
  'Titik penjemputan khusus di sepanjang jalur ferry Jawa–Bali atas permintaan'
];

const lokasiAntar = [
  'Pintu masuk utama dan area parkir Pura Tanah Lot',
  'Area Nirwana Bali Golf Club (bersebelahan dengan Tanah Lot)',
  'Vila dan akomodasi di Beraban dan Kediri, Kabupaten Tabanan',
  'Lanjutan pengantaran menuju Canggu atau Seminyak tersedia atas permintaan jika ingin melanjutkan perjalanan setelah matahari terbenam'
];

const pemandanganRute = [
  'Jalan raya pesisir Negara',
  'Sawah terasering Jembrana',
  'Pedesaan Kabupaten Tabanan',
  'Garis pantai Tanah Lot',
  'Nirwana Bali Golf Club (landmark bersebelahan)'
];

const faq = [
  {
    pertanyaan: 'Berapa lama transfer Gilimanuk ke Tanah Lot?',
    jawaban: 'Perjalanan memakan waktu sekitar 2,5 hingga 3,5 jam dengan mobil pribadi — rute Gilimanuk tersingkat dari Bali West Transport, karena menghindari lalu lintas Denpasar dan jalan sempit Semenanjung Bukit.'
  },
  {
    pertanyaan: 'Berapa jauh Tanah Lot dari Gilimanuk?',
    jawaban: 'Tanah Lot berjarak sekitar 110 km dari Pelabuhan Gilimanuk, menjadikannya rute transfer tersingkat Bali West Transport.'
  },
  {
    pertanyaan: 'Berapa jam buka dan tiket masuk Pura Tanah Lot?',
    jawaban: 'Pura Tanah Lot buka setiap hari dari jam 07:00 hingga 19:00. Per tahun 2026, tiket masuk untuk wisatawan asing adalah IDR 75.000 untuk dewasa dan IDR 40.000 untuk anak-anak, dibayar tunai di gerbang. Parkir terpisah sebesar IDR 5.000 untuk mobil. Tarif dapat berubah sewaktu-waktu, sebaiknya konfirmasi langsung di gerbang.'
  },
  {
    pertanyaan: 'Jam berapa sebaiknya saya tiba untuk menyaksikan matahari terbenam?',
    jawaban: 'Matahari terbenam di Tanah Lot biasanya antara jam 18:15 dan 18:45 sepanjang tahun, dengan sedikit variasi musiman. Kami sarankan tiba sekitar jam 16:00 untuk mendapatkan tempat menyaksikan yang baik di tebing sebelum keramaian.'
  },
  {
    pertanyaan: 'Bisakah saya diantar ke tempat lain selain temple itu sendiri?',
    jawaban: 'Bisa. Kami juga melayani vila dan area resor golf dekat Tanah Lot, dan dapat melanjutkan perjalanan Anda menuju Canggu atau Seminyak setelahnya jika diperlukan — cukup beri tahu kami saat memesan.'
  },
  {
    pertanyaan: 'Bagaimana cara memesan transfer ini?',
    jawaban: 'Hubungi kami langsung via WhatsApp dengan waktu kedatangan ferry dan jumlah penumpang untuk mendapatkan penawaran terbaik.'
  }
];

const ruteTerkait = [
  { label: 'Gilimanuk ke Canggu', href: '/id/transfers/gilimanuk-to-canggu/' },
  { label: 'Gilimanuk ke Seminyak', href: '/id/transfers/gilimanuk-to-seminyak/' },
  { label: 'Gilimanuk ke Ubud', href: '/id/transfers/gilimanuk-to-ubud/' },
  { label: 'Gilimanuk ke Uluwatu', href: '/id/transfers/gilimanuk-to-uluwatu/' },
  { label: 'Gilimanuk ke Kuta', href: '/id/transfers/gilimanuk-to-kuta/' },
  { label: 'Gilimanuk ke Sanur', href: '/id/transfers/gilimanuk-to-sanur/' }
];

const pageUrl = 'https://baliwesttransport.com/id/transfers/gilimanuk-to-tanah-lot/';
const orgId = `${pageUrl}#organization`;
const agencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Bali',
        addressCountry: 'ID',
      },
    },
    {
      '@type': 'TravelAgency',
      '@id': agencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: { '@type': 'AdministrativeArea', name: 'Bali, Indonesia' },
      parentOrganization: { '@id': orgId },
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Transfer Gilimanuk ke Tanah Lot',
      alternateName: 'Gilimanuk to Tanah Lot Transfer',
      description: pageDescription,
      serviceType: 'Transfer pribadi',
      provider: { '@id': agencyId },
      availableLanguage: [
        { '@type': 'Language', name: 'Indonesian' },
        { '@type': 'Language', name: 'English' },
      ],
      areaServed: [
        { '@type': 'Place', name: 'Gilimanuk' },
        { '@type': 'Place', name: 'Tanah Lot' },
        { '@type': 'Place', name: 'Kabupaten Tabanan' },
        { '@type': 'AdministrativeArea', name: 'Bali' },
        { '@type': 'Country', name: 'Indonesia' },
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: {
          '@type': 'ContactPoint',
          telephone: '+6282247648944',
          contactType: 'customer service',
          availableLanguage: ['Indonesian', 'English'],
        },
      },
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.pertanyaan,
        acceptedAnswer: { '@type': 'Answer', text: item.jawaban },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://baliwesttransport.com/id/' },
        { '@type': 'ListItem', position: 2, name: 'Transfer', item: 'https://baliwesttransport.com/id/transfers/' },
        { '@type': 'ListItem', position: 3, name: 'Transfer Gilimanuk ke Tanah Lot', item: pageUrl },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id',
      isPartOf: { '@id': orgId },
      about: { '@id': serviceId },
      mainEntity: [{ '@id': serviceId }, { '@id': faqId }],
      breadcrumb: { '@id': breadcrumbId },
      publisher: { '@id': orgId },
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="https://images.unsplash.com/photo-1555400038-63f5ba517a47?w=1920&h=1080&fit=crop"
          alt="Transfer pribadi dari Gilimanuk ke Tanah Lot Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Transfer Pribadi — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Transfer Gilimanuk ke Tanah Lot</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Layanan antar jemput door-to-door dari Pelabuhan Gilimanuk ke Pura Tanah Lot — rute Gilimanuk tersingkat dan tercepat kami.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan Transfer Sekarang
          </a>
          <a href="/id/transfers/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Lihat Semua Transfer</a>
        </div>
      </div>
    </section>

    <!-- Intro -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jawaban Cepat</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Transfer Pribadi dari Gilimanuk ke Tanah Lot</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Pesan transfer pribadi dari Gilimanuk ke Tanah Lot bersama Bali West Transport. Perjalanan menempuh sekitar 110 km dan memakan waktu 2,5 hingga 3,5 jam — rute Gilimanuk tersingkat dan tercepat kami, karena Tanah Lot berada tepat di jalur utama lintas pulau Bali.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Nikmati perjalanan door-to-door dengan mobil pribadi yang nyaman langsung dari Pelabuhan Gilimanuk menuju Pura Tanah Lot, cocok untuk menyaksikan matahari terbenam paling terkenal di Bali pada hari kedatangan Anda.
            </p>
          </div>
          <div class="space-y-4">
            <img src="/images/nusa-penida-viewpoint.jpg" alt="Pemandangan Bali di rute Gilimanuk ke Tanah Lot" class="w-full h-auto" loading="lazy" />
            <div class="grid grid-cols-2 gap-4">
              <img src="/images/kelingking-beach.jpg" alt="Garis pantai Bali dekat Kabupaten Tabanan" class="w-full h-48 object-cover" loading="lazy" />
              <img src="https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=400&h=300&fit=crop" alt="Sawah terasering dekat Tabanan Bali" class="w-full h-48 object-cover" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ringkasan Rute -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Rute</p>
              <p class="font-serif text-2xl text-brand-dark">Gilimanuk ke Tanah Lot</p>
              <span class="inline-block mt-2 bg-brand-gold/20 text-brand-gold text-[10px] tracking-widest uppercase px-2 py-1">Rute Tersingkat</span>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Jarak</p>
              <p class="font-serif text-2xl text-brand-dark">~110 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Waktu</p>
              <p class="font-serif text-2xl text-brand-dark">2,5–3,5 jam</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Penawaran Terbaik</span>
              <p class="text-brand-dark/50 text-sm mt-1">Informasikan tanggal & jumlah penumpang.</p>
            </div>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
            >
              Minta Penawaran Terbaik
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Keunggulan -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Mengapa Memilih Kami</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Keunggulan Transfer Gilimanuk ke Tanah Lot Kami</h2>
        </div>
        <p class="text-brand-dark/70 text-lg leading-relaxed max-w-3xl mx-auto text-center mb-12">
          Tanah Lot adalah salah satu landmark paling ikonik di Bali, dan berbeda dari sebagian besar rute Gilimanuk lainnya, lokasinya berada tepat di jalur utama Denpasar–Gilimanuk — tanpa perlu memutar lewat kemacetan Denpasar, tanpa perlu mendaki ke Semenanjung Bukit. Ini menjadikannya rute transfer ferry-ke-tujuan tersingkat dan paling langsung dari Bali West Transport.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {keunggulan.map((item) => (
            <div class="flex items-start gap-4 p-6 bg-brand-cream">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Lokasi Jemput & Antar -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Penjemputan</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Lokasi Penjemputan di Gilimanuk</h2>
            <p class="text-brand-dark/70 mb-6">Kami dapat menjemput dari:</p>
            <div class="space-y-3 mb-6">
              {lokasiJemput.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <p class="text-brand-dark/50 text-sm">Supir kami akan berkoordinasi sebelum keberangkatan untuk memastikan proses penjemputan berjalan lancar.</p>
          </div>
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pengantaran</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Lokasi Pengantaran di Tanah Lot</h2>
            <p class="text-brand-dark/70 mb-6">Kami mengantarkan langsung ke:</p>
            <div class="space-y-3 mb-8">
              {lokasiAntar.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <p class="text-brand-dark/50 text-sm">Pura Tanah Lot buka setiap hari dari jam 07:00 hingga 19:00. Tiket masuk (2026): IDR 75.000 dewasa / IDR 40.000 anak-anak, tunai di gerbang.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Siapa yang Menggunakan -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Siapa yang Menggunakan Transfer Ini</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Ideal untuk Kedatangan Sore & Koneksi Ferry Langsung</h2>
            <ul class="space-y-3 text-brand-dark/70 text-lg leading-relaxed mb-8">
              <li>Wisatawan yang tiba melalui ferry Gilimanuk–Ketapang dari Jawa yang ingin menyaksikan matahari terbenam di Tanah Lot pada hari kedatangan sebelum melanjutkan ke akomodasi terdekat</li>
              <li>Tamu yang menginap di vila atau resor golf dekat Tanah Lot</li>
              <li>Wisatawan harian yang menginginkan transfer ferry-ke-tujuan paling singkat dan langsung yang tersedia di jaringan rute ini</li>
              <li>Siapa pun yang mengatur waktu penyeberangan ferry secara khusus di sekitar jam matahari terbenam di Tanah Lot</li>
            </ul>
            <div>
              <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Sepanjang Rute</p>
              <div class="grid grid-cols-2 gap-3">
                {pemandanganRute.map((item) => (
                  <div class="bg-brand-cream p-3 text-brand-dark/70 text-sm">{item}</div>
                ))}
              </div>
            </div>
          </div>
          <div>
            <img
              src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&h=600&fit=crop"
              alt="Wisatawan tiba dari Jawa ke Bali via Pelabuhan Gilimanuk"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Gambaran Perjalanan -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Gambaran Perjalanan</p>
          <h2 class="font-serif text-4xl text-brand-dark mb-6">Dari Gilimanuk Menuju Pura Laut Paling Ikonik di Bali</h2>
          <p class="text-brand-dark/70 text-lg leading-relaxed">
            Dari Gilimanuk, rute mengikuti jalan raya pesisir utama ke timur melewati Negara, melintasi sawah dan kota-kota kecil di Jembrana, sebelum mencapai Kabupaten Tabanan. Dari sini, tinggal jarak pendek terakhir menuju Tanah Lot di tepi pantai. Karena rute ini menghindari kemacetan kota Denpasar dan jalan sempit Semenanjung Bukit, perjalanan ini terasa jauh lebih lancar dan singkat dibandingkan transfer Gilimanuk lainnya. Atur waktu keberangkatan Anda agar tiba dengan cukup waktu siang untuk menjelajah sebelum matahari terbenam — kami sarankan memberi waktu cadangan untuk tiba pada sore hari.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Pertanyaan yang Sering Diajukan</h2>
        </div>
        <div class="space-y-4">
          {faq.map((item) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-xl text-brand-dark mb-3">{item.pertanyaan}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.jawaban}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="font-serif text-2xl text-brand-dark mb-2">Pesan Transfer Gilimanuk ke Tanah Lot Anda</h3>
            <p class="text-brand-dark/60">Hubungi kami via WhatsApp sekarang untuk penawaran terbaik dan rute tercepat serta paling langsung dari Bali West Transport.</p>
          </div>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan Transfer Sekarang
          </a>
        </div>
      </div>
    </section>

    <!-- Rute Terkait -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Rute Transfer Lainnya</p>
          <h2 class="font-serif text-3xl text-brand-dark">Rute Transfer dari Gilimanuk</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {ruteTerkait.map((rute) => (
            <a href={rute.href} class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
              <span class="text-brand-dark font-medium text-sm">{rute.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Jelajahi Lebih -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jelajahi Lebih</p>
          <h2 class="font-serif text-3xl text-brand-dark">Layanan Lainnya dari Bali West Transport</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-4">
          <a href="/id/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Beranda</span>
          </a>
          <a href="/id/transfers/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Semua Transfer</span>
          </a>
          <a href="/id/tours/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Tur Pribadi Bali</span>
          </a>
          <a href="/id/about/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Tentang Kami</span>
          </a>
        </div>
        <div class="mt-6 text-center">
          <a href="/transfers/gilimanuk-to-tanah-lot/" class="text-brand-dark/40 hover:text-brand-dark/70 text-sm transition-colors">
            View this page in English
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>
