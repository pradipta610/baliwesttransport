---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';

const pageTitle = 'Ngurah Rai Airport to Canggu Transfer | Private Airport Transfer Bali';
const pageDescription = 'Book a private transfer from Ngurah Rai Airport to Canggu with Bali West Transport. Professional local drivers, air-conditioned vehicles, and direct hotel or villa drop-off service. Available 24 hours.';
const pageKeywords = 'Ngurah Rai Airport to Canggu transfer, private airport transfer Bali to Canggu, DPS airport to Canggu, Bali airport pickup Canggu, airport transfer Canggu Bali, Bali West Transport';

const whatsappText = 'Hi, I would like to book a private transfer from Ngurah Rai Airport to Canggu. Please send me your best offer.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const benefits = [
  'Driver waiting upon arrival at the airport',
  'Fixed pricing with no hidden fees',
  'No taxi negotiation required',
  'Direct villa or hotel drop-off throughout Canggu',
  'Private vehicle exclusively for your group',
  'Better luggage handling',
  'Airport pickup available 24 hours',
  'Convenient for first-time Bali visitors'
];

const cangguAreas = [
  'Batu Bolong',
  'Berawa',
  'Echo Beach',
  'Pererenan',
  'Babakan',
  'Kayu Tulang',
  'Padonan',
  'Tumbak Bayuh'
];

const cangguBeaches = [
  'Batu Bolong Beach',
  'Echo Beach',
  'Berawa Beach',
  'Pererenan Beach'
];

const privateTransferBenefits = [
  'Airport pickup included',
  'Fixed price',
  'Private vehicle',
  'Flight monitoring',
  'Less arrival stress'
];

const faqs = [
  {
    question: 'What is the best way to get from Bali Airport to Canggu?',
    answer: 'For most travellers, a private airport transfer is the easiest option because it provides direct pickup, fixed pricing, and hotel drop-off service without the need for taxi negotiations or ride-hailing app confusion.'
  },
  {
    question: 'How long does it take from Ngurah Rai Airport to Canggu?',
    answer: 'Travel time is usually between 45 minutes and 2 hours depending on traffic conditions. During peak periods and busy holidays, it may take longer due to Canggu\'s notorious traffic congestion.'
  },
  {
    question: 'Is Canggu far from Bali Airport?',
    answer: 'Not particularly. The distance is only around 16â€“20 km, but traffic congestion around Canggu often increases travel time significantly, especially during morning and evening peak hours.'
  },
  {
    question: 'Can I book airport transfer to Canggu before arriving?',
    answer: 'Yes. Pre-booking airport transportation is recommended, especially during peak travel seasons and busy arrival periods, to ensure your driver is confirmed and ready upon landing.'
  },
  {
    question: 'Is airport pickup available late at night?',
    answer: 'Yes. Bali West Transport provides airport pickup services based on your flight arrival schedule, including late-night and early-morning arrivals.'
  }
];

const relatedRoutes = [
  { label: 'Airport Transfer Hub', href: '/airport-transfer/' },
  { label: 'Airport to Ubud', href: '/airport-transfer/ngurah-rai-airport-to-ubud/' },
  { label: 'Airport to Seminyak', href: '/airport-transfer/ngurah-rai-airport-to-seminyak/' },
  { label: 'Airport to Uluwatu', href: '/airport-transfer/ngurah-rai-airport-to-uluwatu/' },
  { label: 'Airport to Sanur', href: '/airport-transfer/ngurah-rai-airport-to-sanur/' },
  { label: 'Gilimanuk to Canggu Transfer', href: '/transfers/gilimanuk-to-canggu/' }
];

const pageUrl = 'https://baliwesttransport.com/airport-transfer/ngurah-rai-airport-to-canggu/';
const organizationId = `${pageUrl}#organization`;
const travelAgencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      sameAs: []
    },
    {
      '@type': 'TravelAgency',
      '@id': travelAgencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Bali, Indonesia'
      },
      parentOrganization: { '@id': organizationId }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Ngurah Rai Airport to Canggu Transfer',
      description: pageDescription,
      serviceType: 'Private Airport Transfer',
      provider: { '@id': travelAgencyId },
      areaServed: [
        { '@type': 'Place', name: 'Ngurah Rai International Airport' },
        { '@type': 'Place', name: 'Canggu' },
        { '@type': 'AdministrativeArea', name: 'Bali' }
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: {
          '@type': 'ContactPoint',
          telephone: '+6282247648944',
          contactType: 'customer service'
        }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://baliwesttransport.com/' },
        { '@type': 'ListItem', position: 2, name: 'Airport Transfer', item: 'https://baliwesttransport.com/airport-transfer/' },
        { '@type': 'ListItem', position: 3, name: 'Ngurah Rai Airport to Canggu Transfer', item: pageUrl }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': organizationId },
      about: { '@id': serviceId },
      mainEntity: [{ '@id': serviceId }, { '@id': faqId }],
      breadcrumb: { '@id': breadcrumbId },
      publisher: { '@id': organizationId }
    }
  ]
};
---

