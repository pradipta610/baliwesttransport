# Media Library (/admin/media/) — set these in Vercel > Settings > Environment Variables
# Password the owner types to open /admin/media/
ADMIN_PASSWORD=
# Long random string used to sign the login cookie (e.g. `openssl rand -hex 32`)
MEDIA_SESSION_SECRET=
# Fine-grained GitHub token: only this repo, permission "Contents: Read and write"
GITHUB_TOKEN=
# Optional overrides
# GITHUB_REPO=pradipta610/baliwesttransport
# GITHUB_BRANCH=main
