---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { getLangFromUrl } from '../i18n/utils';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  heroImage: string;
  heroAlt: string;
  category: string;
  publishDate: string;
  readTime: string;
  articleTitle: string;
  articleSubtitle?: string;
  relatedServices?: Array<{ label: string; href: string }>;
  schemaGraph: object;
}

const {
  title,
  description,
  keywords = '',
  heroImage,
  heroAlt,
  category,
  publishDate,
  readTime,
  articleTitle,
  articleSubtitle,
  relatedServices = [],
  schemaGraph,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const isID = lang === 'id';

const waText = isID
  ? 'Halo, saya membaca panduan wisata Anda dan ingin memesan transfer pribadi di Bali. Mohon informasi penawaran terbaik Anda.'
  : 'Hi, I read your travel guide and would like to book a private transfer in Bali. Please send me your best offer.';
const waUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(waText)}`;

const ui = {
  breadcrumbHome: isID ? 'Beranda' : 'Home',
  breadcrumbHomeHref: isID ? '/id/' : '/',
  breadcrumbBlog: isID ? 'Panduan Wisata' : 'Travel Guides',
  breadcrumbBlogHref: isID ? '/id/blog/' : '/blog/',
  sidebarLabel: isID ? 'Pesan Sekarang' : 'Book Now',
  sidebarHeading: isID ? 'Siap Memesan Transfer?' : 'Ready to Book Your Transfer?',
  sidebarDesc: isID
    ? 'Hindari antrean. Pesan transfer bandara pribadi dengan supir lokal Bali via WhatsApp.'
    : 'Skip the queue. Book a private airport transfer with a local Bali driver.',
  sidebarBtn: isID ? 'Pesan via WhatsApp' : 'Book via WhatsApp',
  relatedLabel: isID ? 'Layanan Terkait' : 'Related Services',
  ctaLabel: isID ? 'Pesan Sekarang' : 'Book Now',
  ctaHeading: isID ? 'Pesan Transfer Pribadi Bali Anda' : 'Book Your Private Bali Transfer',
  ctaDesc: isID
    ? 'Supir lokal profesional, kendaraan ber-AC, dan antar langsung ke hotel di seluruh Bali — tersedia 24 jam.'
    : 'Professional local drivers, air-conditioned vehicles, and direct hotel drop-off across Bali — available 24 hours.',
  ctaBtn: isID ? 'Pesan via WhatsApp' : 'Book via WhatsApp',
};
---

<Layout title={title} description={description} keywords={keywords}>
  <Header />

  <main>

    <!-- Hero -->
    <section class="relative bg-brand-dark pt-40 pb-24 overflow-hidden">
      <div class="absolute inset-0">
        <img src={heroImage} alt={heroAlt} class="w-full h-full object-cover opacity-20" />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/60 to-brand-dark"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-12">
        <div class="mb-6">
          <span class="inline-block bg-brand-gold/20 text-brand-gold text-xs tracking-[0.2em] uppercase px-4 py-2 border border-brand-gold/30">{category}</span>
        </div>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-brand-cream mb-6 leading-tight max-w-3xl">{articleTitle}</h1>
        {articleSubtitle && (
          <p class="text-brand-cream/60 text-lg md:text-xl mb-10 max-w-2xl leading-relaxed">{articleSubtitle}</p>
        )}
        <div class="flex items-center gap-4 text-brand-cream/40 text-sm">
          <span>{publishDate}</span>
          <span class="w-px h-3 bg-brand-cream/20"></span>
          <span>{readTime}</span>
        </div>
      </div>
    </section>

    <!-- Article + Sidebar -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-brand-dark/40 tracking-[0.15em] uppercase mb-12">
          <a href={ui.breadcrumbHomeHref} class="hover:text-brand-dark transition-colors">{ui.breadcrumbHome}</a>
          <span>/</span>
          <a href={ui.breadcrumbBlogHref} class="hover:text-brand-dark transition-colors">{ui.breadcrumbBlog}</a>
          <span>/</span>
          <span class="text-brand-dark/60">{category}</span>
        </nav>

        <div class="grid lg:grid-cols-[1fr_300px] gap-16 items-start">

          <!-- Main Article -->
          <article class="blog-content min-w-0">
            <slot />
          </article>

          <!-- Sidebar -->
          <aside>
            <div class="sticky top-28 space-y-4">

              <!-- Book Now CTA -->
              <div class="bg-brand-dark p-8">
                <p class="text-brand-gold text-xs tracking-[0.2em] uppercase mb-4">{ui.sidebarLabel}</p>
                <h3 class="font-serif text-2xl text-brand-cream mb-3 leading-snug">{ui.sidebarHeading}</h3>
                <p class="text-brand-cream/50 text-sm leading-relaxed mb-6">{ui.sidebarDesc}</p>
                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-2 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-6 py-3 text-xs tracking-[0.2em] uppercase transition-colors w-full font-medium"
                >
                  <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  {ui.sidebarBtn}
                </a>
              </div>

              <!-- Related Services -->
              {relatedServices.length > 0 && (
                <div class="bg-brand-cream p-6">
                  <p class="text-brand-gold text-xs tracking-[0.2em] uppercase mb-4">{ui.relatedLabel}</p>
                  <ul class="space-y-3">
                    {relatedServices.map((s) => (
                      <li>
                        <a href={s.href} class="group text-brand-dark/70 hover:text-brand-dark text-sm transition-colors flex items-center gap-2">
                          <svg class="w-3 h-3 text-brand-gold flex-shrink-0 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                          </svg>
                          {s.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="py-24 bg-brand-dark text-brand-cream">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <p class="text-brand-gold text-sm tracking-[0.2em] uppercase mb-4">Bali West Transport</p>
        <h2 class="font-serif text-4xl md:text-5xl mb-6 leading-tight">{ui.ctaHeading}</h2>
        <p class="text-brand-cream/60 text-lg mb-10 max-w-xl mx-auto">{ui.ctaDesc}</p>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-12 py-5 text-sm tracking-[0.2em] uppercase transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {ui.ctaBtn}
        </a>
      </div>
    </section>

  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>

<style>
  /* ── Base typography ── */
  .blog-content :global(h2) {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.875rem;
    line-height: 1.2;
    color: var(--color-brand-dark, #1a1a1a);
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(0,0,0,0.07);
  }
  .blog-content :global(h3) {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--color-brand-dark, #1a1a1a);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .blog-content :global(p) {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: rgba(26,26,26,0.70);
    margin-bottom: 1.375rem;
  }
  .blog-content :global(ul) {
    margin-bottom: 1.375rem;
    list-style: none;
    padding: 0;
  }
  .blog-content :global(ul li) {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(26,26,26,0.70);
    padding: 0.375rem 0;
  }
  .blog-content :global(ul li::before) {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    background-color: #c9a84c;
    border-radius: 50%;
    margin-top: 0.65rem;
    flex-shrink: 0;
  }
  .blog-content :global(ol) {
    margin-bottom: 1.375rem;
    padding-left: 1.5rem;
  }
  .blog-content :global(ol li) {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(26,26,26,0.70);
    margin-bottom: 0.5rem;
    padding-left: 0.5rem;
  }
  .blog-content :global(strong) {
    font-weight: 600;
    color: #1a1a1a;
  }
  .blog-content :global(a) {
    color: #1a1a1a;
    text-decoration: underline;
    text-decoration-color: #c9a84c;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }
  .blog-content :global(a:hover) {
    color: #c9a84c;
  }

  /* ── Special blocks ── */

  /* Quick Answer Box */
  .blog-content :global(.quick-answer) {
    background-color: #f5f0e8;
    border-left: 4px solid #c9a84c;
    padding: 1.75rem 2rem;
    margin-bottom: 2.5rem;
    margin-top: 0.5rem;
  }
  .blog-content :global(.quick-answer p) {
    margin-bottom: 0;
    font-size: 1.0625rem;
  }

  /* Comparison grid */
  .blog-content :global(.comparison-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2rem 0;
  }
  @media (max-width: 640px) {
    .blog-content :global(.comparison-grid) {
      grid-template-columns: 1fr;
    }
  }
  .blog-content :global(.comparison-card) {
    padding: 1.5rem;
    background: #f5f0e8;
  }
  .blog-content :global(.comparison-card-title) {
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c9a84c;
    margin-bottom: 0.75rem;
    display: block;
  }
  .blog-content :global(.comparison-card h3) {
    margin-top: 0;
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .blog-content :global(.comparison-card p) {
    font-size: 0.9375rem;
    margin-bottom: 0;
  }

  /* Highlight / info box */
  .blog-content :global(.info-box) {
    background-color: #1a1a1a;
    padding: 2rem;
    margin: 2.5rem 0;
  }
  .blog-content :global(.info-box h3) {
    color: #f5f0e8;
    margin-top: 0;
    border-bottom: none;
  }
  .blog-content :global(.info-box p) {
    color: rgba(245,240,232,0.65);
    margin-bottom: 0;
  }

  /* Tip box */
  .blog-content :global(.tip-box) {
    background: white;
    border: 1px solid rgba(0,0,0,0.07);
    padding: 1.5rem 2rem;
    margin: 2rem 0;
  }
  .blog-content :global(.tip-box p) {
    margin-bottom: 0;
  }

  /* Inline CTA link */
  .blog-content :global(.cta-inline) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #1a1a1a;
    color: #f5f0e8 !important;
    text-decoration: none !important;
    padding: 0.75rem 1.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0.5rem 0 2rem;
    transition: background 0.15s;
  }
  .blog-content :global(.cta-inline:hover) {
    background: #2d2d2d;
    color: #f5f0e8 !important;
  }

  /* First h2 has no top margin */
  .blog-content :global(h2:first-of-type) {
    margin-top: 0;
  }
</style>
