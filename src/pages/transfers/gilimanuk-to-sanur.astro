---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';

const pageTitle = 'Gilimanuk to Sanur Transfer — Private Door-to-Door | Bali West Transport';
const pageDescription = 'Private transfer from Gilimanuk Ferry Port to Sanur. Door-to-door, 130–140 km, 4–4.5 hours. Timed for your Nusa Penida/Lembongan fast boat. Book on WhatsApp.';
const pageKeywords = 'gilimanuk to sanur transfer, gilimanuk sanur private transfer, gilimanuk ferry port to sanur, transfer from gilimanuk to sanur bali, gilimanuk sanur harbour, sanur fast boat nusa penida';

const whatsappText = 'Hi, I would like to book a private Gilimanuk to Sanur transfer. Please send me your best offer.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const pickupLocations = [
  'Gilimanuk Ferry Port (Pelabuhan Gilimanuk)',
  'Hotels and guesthouses in Gilimanuk town',
  'Ketapang Port area on the Java side (for pre-arranged, cross-strait itineraries)'
];

const dropoffAreas = [
  'Sanur Beach and the Jl. Danau Tamblingan hotel strip',
  'Sanur Harbour (fast boat terminal for Nusa Penida, Lembongan, and the Gili Islands)',
  'Mertasari Beach and Segara Ayu Beach',
  'Renon (Denpasar\'s government/residential district, popular with longer-stay visitors)'
];

const harbourFacts = [
  { fact: 'Operating hours', detail: '06:00–18:00 daily (closed on Nyepi)' },
  { fact: 'Crossing time to Nusa Penida / Lembongan', detail: 'Approx. 30–45 minutes' },
  { fact: 'Crossing time to Gili Islands', detail: 'Approx. 3 hours' },
  { fact: 'Earliest departure', detail: 'Around 06:30' },
  { fact: 'Last departure (Nusa Penida / Lembongan)', detail: 'Around 17:00' },
  { fact: 'Recommended check-in', detail: '45–60 minutes before departure' }
];

const userTypes = [
  {
    title: 'Nusa Penida, Lembongan & Gili-Bound Travellers',
    description: "The largest group on this route. Crossing from Java, through Gilimanuk, straight to Sanur Harbour for a same-day or next-morning fast boat — tell us your boat time and we build the pickup around it."
  },
  {
    title: 'Travellers Crossing from Java',
    description: 'Arriving via the Ketapang–Gilimanuk ferry from Banyuwangi, Surabaya, or Ijen, with Sanur as either a final base or a stepping stone to the islands.'
  },
  {
    title: 'Families and Long-Stay Visitors',
    description: 'Sanur is quieter than Kuta or Seminyak, with a walkable beachfront promenade and a more residential feel — a common choice for families and travellers staying several weeks.'
  },
  {
    title: 'Retirees and Repeat Visitors',
    description: 'Sanur has long been popular with longer-term and older travellers who want a relaxed base without nightlife noise. A private transfer with no terminal changes and no queueing matters more for this group, not less.'
  }
];

const benefits = [
  {
    title: 'No Connections',
    description: 'Public transport from Gilimanuk to Sanur requires at least one change at a Denpasar terminal, plus a further taxi leg. Private transfer is point-to-point.'
  },
  {
    title: 'Timed Around Your Boat, Not the Other Way Around',
    description: "If you're catching a fast boat from Sanur Harbour, your pickup time is built around that departure — not the reverse."
  },
  {
    title: 'Door-to-Door to Your Hotel or the Harbour',
    description: 'Whether Sanur is your destination or a stepping stone to the islands, your driver delivers you exactly where you need to be.'
  },
  {
    title: 'Luggage Flexibility',
    description: "Long-stay and island-hopping travellers routinely carry more than a shared shuttle's weight allowance. A private vehicle carries what your group brings."
  },
  {
    title: 'WhatsApp-First Booking and Contact',
    description: 'Confirm your ferry details, share your fast boat time, and track your driver — all via WhatsApp, no app or account required.'
  }
];

const faqs = [
  {
    question: 'How long does the transfer from Gilimanuk to Sanur take?',
    answer: "Approximately 4 to 4.5 hours by private vehicle. This is the longest of our standard Gilimanuk routes, since Sanur sits on Bali's east coast, on the far side of Denpasar from the ferry port."
  },
  {
    question: 'How far is Gilimanuk from Sanur?',
    answer: 'Approximately 130–140 km by road, following the main western corridor through Negara and Tabanan before continuing past Denpasar toward the east coast.'
  },
  {
    question: 'Can you time my pickup around a fast boat departure from Sanur Harbour?',
    answer: 'Yes. Tell us your fast boat time and operator when booking, and we build your Gilimanuk pickup time backward from that departure, with buffer for the recommended 45–60 minute check-in.'
  },
  {
    question: 'What time does Sanur Harbour operate?',
    answer: 'Sanur Harbour runs from 06:00 to 18:00 daily, closed on Nyepi. The last fast boat departure to Nusa Penida and Lembongan is typically around 17:00.'
  },
  {
    question: 'Is there a direct bus from Gilimanuk to Sanur?',
    answer: 'No direct bus exists. Public buses go to a Denpasar terminal, where a further taxi or ride-share is needed to reach Sanur — typically exceeding 6 hours total.'
  },
  {
    question: 'Do I need to book my fast boat ticket separately?',
    answer: 'Yes. We handle your land transfer from Gilimanuk to Sanur Harbour; fast boat tickets to Nusa Penida, Lembongan, or the Gili Islands are booked separately through a boat operator.'
  },
  {
    question: 'Where does the driver meet me at Gilimanuk?',
    answer: 'At Gilimanuk Ferry Port (Pelabuhan Gilimanuk), on the western side of the harbour as you disembark from the Ketapang crossing.'
  },
  {
    question: 'Can I make a stop at Tanah Lot on the way to Sanur?',
    answer: 'Yes, on request. Tanah Lot sits close to the route before Mengwi. A planned stop adds to total journey time — confirm when booking.'
  }
];

const relatedRoutes = [
  { label: 'Gilimanuk to Kuta Transfer', href: '/transfers/gilimanuk-to-kuta/' },
  { label: 'Gilimanuk to Seminyak Transfer', href: '/transfers/gilimanuk-to-seminyak/' },
  { label: 'Gilimanuk to Ubud Transfer', href: '/transfers/gilimanuk-to-ubud/' },
  { label: 'Gilimanuk to Canggu Transfer', href: '/transfers/gilimanuk-to-canggu/' },
  { label: 'All Gilimanuk Transfers', href: '/transfers/' },
  { label: 'All Transfer Routes', href: '/transfers/' }
];

const pageUrl = 'https://baliwesttransport.com/transfers/gilimanuk-to-sanur/';
const organizationId = `${pageUrl}#organization`;
const travelAgencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://baliwesttransport.com/logo.png'
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Customer Service',
        availableLanguage: ['English', 'Indonesian'],
        url: 'https://wa.me/6282247648944'
      },
      areaServed: {
        '@type': 'Place',
        name: 'Bali, Indonesia'
      }
    },
    {
      '@type': 'TravelAgency',
      '@id': travelAgencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      parentOrganization: {
        '@id': organizationId
      },
      areaServed: {
        '@type': 'Place',
        name: 'Bali, Indonesia'
      }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Gilimanuk to Sanur Private Transfer',
      description: 'Private door-to-door transfer from Gilimanuk Ferry Port to Sanur, Bali. Driver meets you at the harbour. Journey approximately 130–140 km, 4–4.5 hours. Timed for onward fast boats to Nusa Penida, Lembongan, and the Gili Islands.',
      provider: {
        '@id': travelAgencyId
      },
      serviceType: 'Private ferry port transfer',
      areaServed: [
        {
          '@type': 'Place',
          name: 'Gilimanuk, Jembrana, Bali, Indonesia'
        },
        {
          '@type': 'Place',
          name: 'Sanur, Denpasar, Bali, Indonesia'
        }
      ],
      audience: {
        '@type': 'Audience',
        audienceType: 'Travelers arriving via Ketapang-Gilimanuk ferry, connecting to Sanur or onward fast boats to Nusa Penida, Lembongan and the Gili Islands'
      },
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: 'https://wa.me/6282247648944',
        servicePhone: '+6282247648944',
        availableLanguage: ['English', 'Indonesian']
      },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
        seller: {
          '@id': travelAgencyId
        }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://baliwesttransport.com/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Transfers',
          item: 'https://baliwesttransport.com/transfers/'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Gilimanuk to Sanur Transfer',
          item: pageUrl
        }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'en',
      about: {
        '@id': serviceId
      },
      mainEntity: [
        { '@id': serviceId },
        { '@id': faqId }
      ],
      breadcrumb: {
        '@id': breadcrumbId
      },
      publisher: {
        '@id': organizationId
      },
      datePublished: '2026-07-05',
      dateModified: '2026-07-05'
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} includeOrgSchema={false}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/kelingking-beach.jpg"
          alt="Private transfer from Gilimanuk to Sanur Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Private Transfer — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Private Transfer Gilimanuk to Sanur</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Door-to-Door from the Ferry Port — Timed for Your Onward Boat if You Need It
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Book Your Transfer
          </a>
          <a href="/transfers/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">View All Transfers</a>
        </div>
      </div>
    </section>

    <!-- Quick Answer Block -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Quick Answer</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Private Transfer from Gilimanuk to Sanur</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Book a private transfer from Gilimanuk to Sanur with Bali West Transport. Your driver meets you at Gilimanuk Ferry Port as you disembark the Ketapang crossing from Java. The journey covers approximately 130–140 km and takes 4 to 4.5 hours by private vehicle, following the route through Negara, Tabanan, and Mengwi before continuing along Denpasar's outer ring toward the east coast. Door-to-door delivery to any hotel or villa in Sanur — and if you're continuing on to Nusa Penida, Nusa Lembongan, or the Gili Islands, we time your pickup so you reach Sanur Harbour with room to check in before your fast boat departs.
            </p>
          </div>
          <div class="space-y-4">
            <img src="/images/nusa-penida-viewpoint.jpg" alt="Scenic Bali landscape on the way to Sanur" class="w-full h-auto" loading="lazy" />
            <div class="grid grid-cols-2 gap-4">
              <img src="/images/beach-sunset-swing.jpg" alt="Bali beach sunset" class="w-full h-48 object-cover" loading="lazy" />
              <img src="https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=400&h=300&fit=crop" alt="Bali rice terraces" class="w-full h-48 object-cover" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Route Overview Card -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Route</p>
              <p class="font-serif text-2xl text-brand-dark">Gilimanuk to Sanur</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Distance</p>
              <p class="font-serif text-2xl text-brand-dark">130–140 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Time</p>
              <p class="font-serif text-2xl text-brand-dark">4–4.5 hrs</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Flexible Offer</span>
              <p class="text-brand-dark/50 text-sm mt-1">Tell us your date, group size & onward boat time.</p>
            </div>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap">Ask Best Offer</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose This Transfer -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Why Choose This Transfer</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Why a Private Transfer from Gilimanuk to Sanur?</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Gilimanuk sits at Bali's far western tip, and Sanur sits on the east coast — this is the longest of our standard Gilimanuk routes, with no direct public transport connecting the two. Buses from Gilimanuk terminate at a Denpasar terminal (Ubung or Mengwi), and Sanur is still a separate taxi ride beyond that, on top of an unpredictable wait for the bus itself to depart.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              A private transfer solves the distance problem and the timing problem at once. Your driver is waiting at the port when your ferry docks, and if you're heading onward by fast boat, we build your pickup time around your boat's departure window rather than a generic arrival estimate — which matters, because Sanur Harbour's fast boats run on a fixed schedule that won't wait for a delayed bus connection.
            </p>
          </div>
          <div>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              The route runs through Negara and Tabanan on Bali's main west-coast highway, then joins the Mengwi bypass before skirting Denpasar's southern ring toward Sanur — the same corridor used for Kuta and Seminyak transfers, extended further east.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Traffic tends to build around Denpasar's Sanur-bound arterials (Jl. Bypass Ngurah Rai, Jl. Hang Tuah) during afternoon peak, and again near Sanur's harbour-front roads when a fast boat has just docked. A driver who knows to avoid the harbour car park at boat-arrival peaks saves real time on the final approach.
            </p>
            <div class="bg-brand-cream p-6 mt-4">
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Traffic Risk</p>
              <p class="text-brand-dark/70 text-sm">High: Denpasar's Sanur-bound arterials and the harbour-front road, especially when a fast boat has just arrived (roughly on the hour, mid-morning to mid-afternoon)</p>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2 mt-4">Best Departure</p>
              <p class="text-brand-dark/70 text-sm">Morning ferry arrivals (06:00–09:00) give the most buffer if you're catching a same-day fast boat — Sanur Harbour's last Nusa Penida/Lembongan departure is around 17:00</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Compare Your Options -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Compare Your Options</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Private Transfer vs. Public Bus vs. On-Arrival Taxi</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full bg-white border border-brand-dark/10">
            <thead>
              <tr class="border-b border-brand-dark/10">
                <th class="p-4 text-left text-brand-dark/40 text-xs uppercase tracking-widest"></th>
                <th class="p-4 text-left text-brand-dark font-serif text-lg">Private Transfer<br/><span class="text-brand-gold text-xs uppercase tracking-widest font-sans">Bali West Transport</span></th>
                <th class="p-4 text-left text-brand-dark/70 font-serif text-lg">Public Bus via Denpasar</th>
                <th class="p-4 text-left text-brand-dark/70 font-serif text-lg">On-Arrival Taxi / Ride-share</th>
              </tr>
            </thead>
            <tbody class="text-brand-dark/70">
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Total time</td>
                <td class="p-4 font-medium text-brand-dark">4–4.5 hrs, direct</td>
                <td class="p-4">6+ hrs, with terminal transfer</td>
                <td class="p-4">Unpredictable — no fixed pickup at port</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Timed to fast boat</td>
                <td class="p-4 font-medium text-brand-dark">Yes — pickup built around your boat schedule</td>
                <td class="p-4">No — bus schedule is fixed, boat isn't</td>
                <td class="p-4">No — you negotiate on arrival</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Driver at ferry port</td>
                <td class="p-4 font-medium text-brand-dark">Yes, tracked to your crossing</td>
                <td class="p-4">No</td>
                <td class="p-4">No — you queue and negotiate on arrival</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Price known before travel</td>
                <td class="p-4 font-medium text-brand-dark">Yes, fixed offer confirmed on WhatsApp</td>
                <td class="p-4">Ticket price only; taxi leg still unknown</td>
                <td class="p-4">No — negotiated on the spot</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Drop-off point</td>
                <td class="p-4 font-medium text-brand-dark">Sanur Harbour, or your exact hotel/villa door</td>
                <td class="p-4">Denpasar terminal, then a second ride</td>
                <td class="p-4">Depends on driver, often not door-to-door</td>
              </tr>
              <tr>
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Booking method</td>
                <td class="p-4 font-medium text-brand-dark">WhatsApp, confirmed within minutes</td>
                <td class="p-4">Buy ticket at terminal</td>
                <td class="p-4">None — arrange after you land</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Sanur Harbour Info -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Onward Travel</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Connecting to Nusa Penida, Lembongan, or the Gili Islands from Sanur</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Sanur Harbour is Bali's main fast-boat terminal for the southeastern islands, and it runs on a fixed daily schedule — this is the one part of your trip a delayed transfer can genuinely wreck, so it's worth planning around.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Boat tickets are booked separately from your land transfer — we don't sell fast boat tickets, but we do build your Gilimanuk pickup time around whichever departure you've already booked, so you land in Sanur with buffer, not a sprint to the dock.
            </p>
          </div>
          <div>
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-6">Sanur Harbour Facts</h3>
              <div class="space-y-4">
                {harbourFacts.map((item) => (
                  <div class="flex justify-between items-start gap-4 border-b border-brand-dark/10 pb-4">
                    <span class="text-brand-dark/40 text-xs uppercase tracking-widest font-medium">{item.fact}</span>
                    <span class="text-brand-dark font-medium text-right">{item.detail}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pickup & Drop-off -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pickup</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Pickup at Gilimanuk Ferry Port</h2>
            <p class="text-brand-dark/70 mb-6">Your driver meets you at <strong>Gilimanuk Ferry Port (Pelabuhan Gilimanuk)</strong> on the western side of the harbour as you disembark. Send your ferry booking reference and estimated arrival time when you book, along with your onward fast boat time if relevant — we track both and adjust your departure accordingly.</p>
            <p class="text-brand-dark/70 mb-6">Additional pickup is available from:</p>
            <div class="space-y-3 mb-6">
              {pickupLocations.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
          </div>
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Drop-off</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Drop-off Locations in Sanur</h2>
            <p class="text-brand-dark/70 mb-6">Door-to-door delivery to any address in Sanur, including:</p>
            <div class="space-y-3 mb-8">
              {dropoffAreas.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <p class="text-brand-dark/50 text-sm">If your accommodation is on a small gang off the main beach walk, confirm the exact address when booking so your driver can plan the final approach.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Uses This Transfer -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Who Uses This Transfer</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Popular with Island-Hoppers, Families, and Java Overlanders</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {userTypes.map((item) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.title}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Journey Overview -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Journey Overview</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">The Route from Gilimanuk to Sanur</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              The drive follows Bali's main west-coast highway from Gilimanuk through the rice-field plains of Jembrana Regency, passing Negara — the regional capital and a natural halfway rest stop — before continuing into Tabanan Regency.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              From Tabanan the road joins the Mengwi bypass and continues past Denpasar's outer arterials rather than into the airport corridor used for Kuta and Seminyak transfers. This is the longest of the three routes, and the final stretch through Denpasar's southern ring toward Sanur is where most of the journey's traffic variability sits — particularly around midday and late afternoon.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              If you'd like a stop, Negara is the best halfway point for food or a break. Some travellers on this route also ask about a short detour to Tanah Lot, which sits close to the corridor before Mengwi — this can be arranged on request and adds to total journey time.
            </p>
          </div>
          <div>
            <img
              src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&h=600&fit=crop"
              alt="Scenic Bali landscape along the Gilimanuk to Sanur route"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits of Private Transfer -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Private Transfer Benefits</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Choose a Private Transfer?</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {benefits.map((item) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.title}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Frequently Asked Questions</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="bg-white p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{faq.question}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-dark p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="font-serif text-2xl text-brand-cream mb-2">Ready to book? Send us your ferry details — and your fast boat time if you're island-hopping — on WhatsApp.</h3>
            <p class="text-brand-cream/60">We'll confirm your driver, vehicle, and pickup time within minutes.</p>
          </div>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Book on WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Related Gilimanuk Transfers -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Other Gilimanuk Transfer Routes</p>
          <h2 class="font-serif text-3xl text-brand-dark">Travelling to a Different Part of Bali?</h2>
          <p class="text-brand-dark/60 mt-4">View all available routes from the ferry port.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {relatedRoutes.map((route) => (
            <a href={route.href} class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
              <span class="text-brand-dark font-medium text-sm">{route.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Explore More -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Explore More</p>
          <h2 class="font-serif text-3xl text-brand-dark">More from Bali West Transport</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-4">
          <a href="/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Home</span>
          </a>
          <a href="/airport-transfer/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Airport Transfer</span>
          </a>
          <a href="/tours/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Private Tours</span>
          </a>
          <a href="/about/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">About Us</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>
