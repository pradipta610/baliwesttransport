---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';

const pageTitle = 'Gilimanuk to Canggu Transfer | Private Transfer from Gilimanuk Ferry Port';
const pageDescription = 'Book a private Gilimanuk to Canggu transfer with Bali West Transport. Door-to-door service from Gilimanuk Ferry Port to hotels, villas, resorts, surf camps, and co-working spaces in Canggu.';
const pageKeywords = 'Gilimanuk to Canggu transfer, private transfer Gilimanuk to Canggu, Gilimanuk Ferry Port to Canggu, Bali private transfer, Canggu transfer, Ketapang Gilimanuk ferry transfer, Bali West Transport';

const whatsappText = 'Hi, I would like to book a private Gilimanuk to Canggu transfer. Please send me your best offer.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const benefits = [
  'Private vehicle exclusively for your group',
  'Direct pickup from Gilimanuk Ferry Port',
  'Door-to-door service to Canggu',
  'Professional local drivers',
  'Air-conditioned vehicles',
  'Flexible departure times',
  'Comfortable travel with luggage',
  'Suitable for solo travellers, couples, families, and groups',
  'No waiting for shared transport or multiple connections'
];

const pickupLocations = [
  'Gilimanuk Ferry Port',
  'Hotels in Gilimanuk',
  'Guesthouses and accommodations',
  'Nearby locations in West Bali'
];

const dropoffLocations = [
  'Hotels',
  'Villas',
  'Resorts',
  'Guesthouses',
  'Co-working spaces',
  'Restaurants and cafes',
  'Tourist attractions'
];

const popularDestinations = [
  'Batu Bolong',
  'Berawa',
  'Pererenan',
  'Echo Beach',
  'Nelayan',
  'Babakan',
  'Cemagi',
  'Tumbak Bayuh',
  'Seseh'
];

const userTypes = [
  {
    title: 'Travellers Arriving from Java',
    description: 'Many visitors travel from Banyuwangi to Bali via the Ketapang–Gilimanuk Ferry and continue directly to Canggu.'
  },
  {
    title: 'Digital Nomads',
    description: 'Canggu is one of Bali\'s leading remote work destinations, attracting digital nomads from around the world.'
  },
  {
    title: 'Surfers',
    description: 'Canggu is home to some of Bali\'s most popular surf beaches, making private transfers convenient for travellers carrying surfboards and luggage.'
  },
  {
    title: 'Families and Groups',
    description: 'Private transportation eliminates the need to coordinate multiple taxis or public transport options.'
  }
];

const journeyHighlights = [
  'West Bali countryside',
  'Traditional Balinese villages',
  'Rice fields and plantations',
  'Mountain scenery',
  'Local markets',
  'Coastal regions approaching South Bali'
];

const transferOptions = [
  {
    title: 'Greater Convenience',
    description: 'Travel directly from your pickup location to your accommodation without changing vehicles.'
  },
  {
    title: 'More Comfort',
    description: 'Enjoy air-conditioned transportation and ample luggage space throughout the journey.'
  },
  {
    title: 'Better Time Efficiency',
    description: 'Avoid waiting for buses, shuttle schedules, or ride-hailing availability.'
  },
  {
    title: 'Safer Travel Experience',
    description: 'Professional drivers familiar with Bali\'s roads help ensure a smooth and reliable trip.'
  }
];

const faqs = [
  {
    question: 'How long does it take to get from Gilimanuk to Canggu?',
    answer: 'The journey typically takes between 4 and 5 hours depending on traffic conditions and your final destination within Canggu.'
  },
  {
    question: 'Is this a private transfer?',
    answer: 'Yes. All transfers are private and reserved exclusively for you and your group.'
  },
  {
    question: 'Can I be picked up directly from Gilimanuk Ferry Port?',
    answer: 'Yes. We provide direct pickup from Gilimanuk Ferry Port and can coordinate with your ferry arrival time.'
  },
  {
    question: 'Can I stop along the way?',
    answer: 'Yes. Short stops for refreshments, meals, or rest breaks can usually be arranged upon request.'
  },
  {
    question: 'Is this service available for groups?',
    answer: 'Yes. Bali West Transport offers vehicle options suitable for individuals, couples, families, and larger groups.'
  },
  {
    question: 'Can I book a transfer in advance?',
    answer: 'Yes. Advance booking is recommended to secure your preferred travel schedule.'
  }
];

const relatedRoutes = [
  { label: 'Gilimanuk to Ubud Transfer', href: '/transfers/gilimanuk-to-ubud/' },
  { label: 'Gilimanuk to Seminyak Transfer', href: '/transfers/gilimanuk-to-seminyak/' },
  { label: 'Gilimanuk to Kuta Transfer', href: '/transfers/gilimanuk-to-kuta/' },
  { label: 'Gilimanuk to Sanur Transfer', href: '/transfers/gilimanuk-to-sanur/' },
  { label: 'Gilimanuk to Uluwatu Transfer', href: '/transfers/' },
  { label: 'Airport to Canggu Transfer', href: '/airport-transfer/ngurah-rai-airport-to-canggu/' }
];

const pageUrl = 'https://baliwesttransport.com/transfers/gilimanuk-to-canggu/';
const organizationId = `${pageUrl}#organization`;
const travelAgencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      sameAs: []
    },
    {
      '@type': 'TravelAgency',
      '@id': travelAgencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Bali, Indonesia'
      },
      parentOrganization: {
        '@id': organizationId
      }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Gilimanuk to Canggu Transfer',
      description: pageDescription,
      serviceType: 'Private transfer',
      provider: {
        '@id': travelAgencyId
      },
      areaServed: [
        {
          '@type': 'Place',
          name: 'Gilimanuk'
        },
        {
          '@type': 'Place',
          name: 'Canggu'
        },
        {
          '@type': 'AdministrativeArea',
          name: 'Bali'
        }
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: {
          '@type': 'ContactPoint',
          telephone: '+6282247648944',
          contactType: 'customer service'
        }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://baliwesttransport.com/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Transfers',
          item: 'https://baliwesttransport.com/transfers/'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Gilimanuk to Canggu Transfer',
          item: pageUrl
        }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: {
        '@id': organizationId
      },
      about: {
        '@id': serviceId
      },
      mainEntity: [
        {
          '@id': serviceId
        },
        {
          '@id': faqId
        }
      ],
      breadcrumb: {
        '@id': breadcrumbId
      },
      publisher: {
        '@id': organizationId
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main>
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/kelingking-beach.jpg"
          alt="Private transfer from Gilimanuk to Canggu Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Private Transfer — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Gilimanuk to Canggu Transfer</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Door-to-door private transfer from Gilimanuk Ferry Port to hotels, villas, surf camps, and co-working spaces in Canggu.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Book Your Transfer
          </a>
          <a href="/transfers/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">View All Transfers</a>
        </div>
      </div>
    </section>

    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Quick Answer</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Private Transfer from Gilimanuk to Canggu</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              The fastest and most convenient way to travel from Gilimanuk to Canggu is by private transfer. The journey takes approximately 4–5 hours depending on traffic and provides direct door-to-door transportation from Gilimanuk Ferry Port to your accommodation in Canggu.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              This service is ideal for travellers arriving from Java via the Ketapang–Gilimanuk Ferry who want a hassle-free journey to one of Bali's most popular coastal destinations.
            </p>
          </div>
          <div class="space-y-4">
            <img src="/images/nusa-penida-viewpoint.jpg" alt="Scenic Bali landscape on the way to Canggu" class="w-full h-auto" loading="lazy" />
            <div class="grid grid-cols-2 gap-4">
              <img src="/images/beach-sunset-swing.jpg" alt="Bali beach sunset" class="w-full h-48 object-cover" loading="lazy" />
              <img src="https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=400&h=300&fit=crop" alt="Bali rice terraces" class="w-full h-48 object-cover" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Route</p>
              <p class="font-serif text-2xl text-brand-dark">Gilimanuk to Canggu</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Distance</p>
              <p class="font-serif text-2xl text-brand-dark">135–150 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Time</p>
              <p class="font-serif text-2xl text-brand-dark">4–5 hours</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Flexible Offer</span>
              <p class="text-brand-dark/50 text-sm mt-1">Tell us your date & group size.</p>
            </div>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap">Ask Best Offer</a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Why Choose Us</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Choose Our Gilimanuk to Canggu Transfer?</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {benefits.map((benefit) => (
            <div class="flex items-start gap-4 p-6 bg-brand-cream">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{benefit}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pickup</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Pickup Locations in Gilimanuk</h2>
            <p class="text-brand-dark/70 mb-6">We can arrange pickup from:</p>
            <div class="space-y-3 mb-6">
              {pickupLocations.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <p class="text-brand-dark/50 text-sm">Our driver will coordinate pickup details before your journey for a seamless travel experience.</p>
          </div>
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Drop-off</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Drop-off Locations in Canggu</h2>
            <p class="text-brand-dark/70 mb-6">We provide direct drop-off throughout the Canggu area, including:</p>
            <div class="grid grid-cols-2 gap-3 mb-8">
              {popularDestinations.map((destination) => (
                <div class="bg-white p-3 text-brand-dark/60 text-sm">{destination}</div>
              ))}
            </div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Direct Drop-off To</p>
            <div class="space-y-3">
              {dropoffLocations.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Who Uses This Transfer</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Popular with Java Arrivals, Surfers, Digital Nomads, and Families</h2>
            <div class="space-y-6">
              {userTypes.map((item) => (
                <div>
                  <h3 class="font-serif text-2xl text-brand-dark mb-2">{item.title}</h3>
                  <p class="text-brand-dark/70 leading-relaxed">{item.description}</p>
                </div>
              ))}
            </div>
          </div>
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Journey Overview</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">What You May See Along the Route</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-8">The route from Gilimanuk to Canggu takes you through diverse landscapes across Bali. Optional stops for refreshments, rest breaks, meals, or scenic viewpoints may be arranged upon request.</p>
            <div class="grid grid-cols-2 gap-3">
              {journeyHighlights.map((item) => (
                <div class="bg-brand-cream p-3 text-brand-dark/70 text-sm">{item}</div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Private Transfer Benefits</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Choose a Private Transfer Instead of Public Transport?</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {transferOptions.map((item) => (
            <div class="bg-white p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.title}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Frequently Asked Questions</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{faq.question}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="font-serif text-2xl text-brand-dark mb-2">Book Your Gilimanuk to Canggu Transfer</h3>
            <p class="text-brand-dark/60">Travel across Bali comfortably with Bali West Transport's private transfer service.</p>
          </div>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap">Book Your Transfer Now</a>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Related Transfer Services</p>
          <h2 class="font-serif text-3xl text-brand-dark">You May Also Be Interested In</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {relatedRoutes.map((route) => (
            <a href={route.href} class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
              <span class="text-brand-dark font-medium text-sm">{route.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Explore More -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Explore More</p>
          <h2 class="font-serif text-3xl text-brand-dark">More from Bali West Transport</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-4">
          <a href="/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Home</span>
          </a>
          <a href="/airport-transfer/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Airport Transfer</span>
          </a>
          <a href="/tours/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Private Tours</span>
          </a>
          <a href="/about/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">About Us</span>
          </a>
        </div>
      </div>
    </section>
  </main>

