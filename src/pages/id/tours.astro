---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import ImageGallery from '../../components/ImageGallery.astro';

import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const highlights = [
  lang === 'en' ? "Temples & sacred sites" : "Pura & tempat suci",
  lang === 'en' ? "Rice terraces" : "Sawah terasering",
  lang === 'en' ? "Waterfalls" : "Air terjun",
  lang === 'en' ? "Local villages" : "Desa lokal",
  lang === 'en' ? "Beaches" : "Pantai",
  lang === 'en' ? "Cultural experiences" : "Pengalaman budaya"
];
---

<Layout 
  title={t('meta.tours.title')}
  description={t('meta.tours.desc')}
  keywords={t('meta.tours.keywords')}
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[70vh] flex items-center justify-center">
      <div class="absolute inset-0">
        <img 
          src="/images/kelingking-beach.jpg" 
          alt="Kelingking Beach Nusa Penida"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 text-center text-white px-6">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">{t('tours.hero.subtitle')}</p>
        <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-medium mb-6 drop-shadow-lg">{t('tours.hero.title')}</h1>
        <p class="text-xl text-white/90 max-w-xl mx-auto font-light mb-8 drop-shadow-md">
          {t('tours.hero.desc')}
        </p>
        <p class="text-brand-gold text-lg tracking-widest uppercase drop-shadow-md">{lang === 'en' ? "Ask for a flexible offer" : "Minta penawaran fleksibel"}</p>
      </div>
    </section>
    
    <!-- Tour Details -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <!-- Left: Images -->
          <div class="space-y-4">
            <img 
              src="/images/nusa-penida-viewpoint.jpg" 
              alt="Nusa Penida viewpoint"
              class="w-full h-auto"
              loading="lazy"
            />
            <div class="grid grid-cols-2 gap-4">
              <img 
                src="https://images.unsplash.com/photo-1573790387438-4da905039392?w=400&h=300&fit=crop" 
                alt="Bali waterfall"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <img 
                src="/images/beach-sunset-swing.jpg" 
                alt="Beach sunset swing"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
            </div>
          </div>
          
          <!-- Right: Details -->
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">{lang === 'en' ? "Our Signature Experience" : "Pengalaman Khas Kami"}</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">{t('tours.hero.title')}</h2>
            
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-8">
              {lang === 'en' ? "Discover Bali at your own pace with our full-day private tour. Your personal driver will take you to the destinations of your choice, from ancient temples to hidden waterfalls, rice terraces to pristine beaches." : "Jelajahi Bali sesuai keinginan Anda dengan tur pribadi seharian penuh kami. Supir pribadi Anda akan membawa Anda ke tujuan pilihan Anda, dari pura kuno hingga air terjun tersembunyi, sawah terasering hingga pantai yang masih asli."}
            </p>
            
            <!-- What's Included -->
            <div class="mb-8">
              <h3 class="font-serif text-xl text-brand-dark mb-4">{lang === 'en' ? "What's Included" : "Termasuk"}</h3>
              <div class="grid grid-cols-2 gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{lang === 'en' ? "Private car" : "Mobil pribadi"}</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{lang === 'en' ? "Personal driver" : "Supir pribadi"}</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{lang === 'en' ? "Drinks included" : "Termasuk minum"}</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{lang === 'en' ? "Snacks included" : "Makanan ringan"}</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{lang === 'en' ? "8 hours duration" : "Durasi 8 jam"}</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{lang === 'en' ? "Flexible itinerary" : "Rute fleksibel"}</span>
                </div>
              </div>
            </div>
            
            <!-- Price & CTA -->
            <div class="bg-white p-8 mb-8">
              <div class="mb-4">
                <span class="font-serif text-4xl text-brand-gold">{lang === 'en' ? "Custom Offer" : "Penawaran Khusus"}</span>
              </div>
              <p class="text-brand-dark/50 text-sm mb-6">{lang === 'en' ? "Tell us your route, group size, and travel date. We'll suggest the best available offer." : "Beri tahu rute, jumlah tamu, dan tanggal perjalanan Anda. Kami akan bantu berikan penawaran terbaik."}</p>
              <a 
                href={`https://wa.me/6282247648944?text=${encodeURIComponent(t('whatsapp.book_tour'))} ${encodeURIComponent(lang === 'en' ? 'Please send me your best offer.' : 'Tolong kirimkan penawaran terbaik.')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                {lang === 'en' ? "Ask Best Offer" : "Minta Penawaran"}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Where to Go -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">{lang === 'en' ? "Possibilities" : "Kemungkinan"}</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark mb-6">{lang === 'en' ? "Where Would You Like to Go?" : "Ke Mana Anda Ingin Pergi?"}</h2>
          <p class="text-brand-dark/60 max-w-2xl mx-auto">
            {lang === 'en' ? "Your tour is fully customizable. Tell us your interests and we'll suggest the perfect itinerary." : "Tur Anda sepenuhnya dapat disesuaikan. Beri tahu kami minat Anda dan kami akan menyarankan rencana perjalanan yang sempurna."}
          </p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {highlights.map((item) => (
            <div class="bg-brand-cream p-6 text-center">
              <p class="text-brand-dark font-medium">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Gallery -->
    <ImageGallery />
    
    <!-- Related Services -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">{lang === 'en' ? "More Services" : "Layanan Lainnya"}</p>
          <h2 class="font-serif text-3xl text-brand-dark">{lang === 'en' ? "Explore Bali West Transport" : "Jelajahi Bali West Transport"}</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          <a href={lang === 'en' ? '/' : `/${lang}/`} class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">{lang === 'en' ? "Home" : "Beranda"}</span>
          </a>
          <a href={lang === 'en' ? '/transfers' : `/${lang}/transfers`} class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">{lang === 'en' ? "Private Transfers" : "Transfer Pribadi"}</span>
          </a>
          <a href={lang === 'en' ? '/about' : `/${lang}/about`} class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">{lang === 'en' ? "About Us" : "Tentang Kami"}</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppFloat />
</Layout>
