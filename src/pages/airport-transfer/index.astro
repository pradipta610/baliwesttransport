---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';

const pageTitle = 'Bali Airport Transfer – Private Transfers from Ngurah Rai Airport | Bali West Transport';
const pageDescription = 'Book a private Bali airport transfer from Ngurah Rai International Airport (DPS) to Ubud, Canggu, Seminyak, Uluwatu, Sanur, and all Bali areas. Professional local drivers, fixed pricing, 24-hour service, and direct hotel drop-off.';
const pageKeywords = 'Bali airport transfer, Ngurah Rai airport transfer, private airport transfer Bali, Bali airport to Ubud, Bali airport to Canggu, Bali airport to Seminyak, Bali airport to Uluwatu, Bali airport to Sanur, DPS airport transfer, Bali private car transfer';

const whatsappText = 'Hi, I would like to book a private Bali airport transfer. Please send me your best offer.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const quickInfo = [
  { label: 'Service', value: 'Bali Private Airport Transfer' },
  { label: 'Airport', value: 'Ngurah Rai International Airport (DPS)' },
  { label: 'Service Area', value: 'Ubud, Canggu, Seminyak, Uluwatu, Sanur & all Bali areas' },
  { label: 'Transport Type', value: 'Private Car with Driver' },
  { label: 'Availability', value: '24 Hours' },
  { label: 'Pickup', value: 'Airport Pickup & Hotel Drop-Off' },
  { label: 'Vehicle', value: 'Air-Conditioned Private Vehicle' },
  { label: 'Provider', value: 'Bali West Transport' },
];

const benefits = [
  'Fixed and transparent pricing',
  'Professional local driver waiting at arrival area',
  'No need to negotiate taxi fares',
  'Comfortable air-conditioned vehicles',
  'Direct transfer to hotel or villa',
  'Suitable for solo travelers, couples, families, and groups',
  'Available for late-night and early-morning flights',
  'Easier transportation experience for first-time Bali visitors',
];

const destinations = [
  {
    name: 'Ubud',
    description: 'Ubud is one of the most popular destinations in Bali, known for rice terraces, jungle resorts, yoga retreats, waterfalls, and Balinese culture.',
    time: '1.5–2.5 hours',
    bestFor: 'Couples, wellness travelers, families, culture lovers',
    areas: 'Central Ubud, Tegallalang, Sayan, Kedewatan',
    note: 'Private airport transfers to Ubud are recommended because the journey can be long and traffic conditions often vary throughout the day.',
    href: '/ngurah-rai-airport-to-ubud/',
    linkLabel: 'Ngurah Rai Airport to Ubud transfer details',
  },
  {
    name: 'Canggu',
    description: 'Canggu is famous for surfing, beach cafes, nightlife, coworking spaces, and digital nomad culture.',
    time: '1–2 hours',
    bestFor: 'Surfers, remote workers, long-stay travelers',
    areas: 'Berawa, Batu Bolong, Pererenan, Echo Beach',
    note: 'Traffic to Canggu can become busy during peak hours, making private transfers one of the easiest transportation options from the airport.',
    href: '/ngurah-rai-airport-to-canggu/',
    linkLabel: 'Ngurah Rai Airport to Canggu transfer details',
  },
  {
    name: 'Seminyak',
    description: 'Seminyak is known for luxury villas, shopping, beach clubs, and restaurants.',
    time: '30–60 minutes',
    bestFor: 'Luxury travelers, couples, nightlife visitors',
    areas: 'Petitenget, Oberoi, Batu Belig',
    note: 'Seminyak is one of the closest major tourist areas from Bali Airport, making airport transfers relatively quick and convenient.',
    href: '/ngurah-rai-airport-to-seminyak/',
    linkLabel: 'Ngurah Rai Airport to Seminyak transfer details',
  },
  {
    name: 'Uluwatu',
    description: "Uluwatu is located on Bali's southern peninsula and is famous for cliffs, beaches, surfing, and luxury resorts.",
    time: '45–90 minutes',
    bestFor: 'Surfers, honeymooners, luxury travelers',
    areas: 'Bingin, Pecatu, Balangan, Ungasan',
    note: 'Private airport transfers to Uluwatu are popular because many resorts are located far from main transportation areas.',
    href: '/ngurah-rai-airport-to-uluwatu/',
    linkLabel: 'Ngurah Rai Airport to Uluwatu transfer details',
  },
  {
    name: 'Sanur',
    description: 'Sanur offers a quieter atmosphere and is a popular destination for families and travelers heading to Nusa Penida.',
    time: '30–45 minutes',
    bestFor: 'Families, relaxed vacations, island connections',
    areas: 'Sanur Beach, Sindhu, Mertasari',
    note: 'Sanur is also commonly used as a departure point for fast boats to nearby islands.',
    href: '/ngurah-rai-airport-to-sanur/',
    linkLabel: 'Ngurah Rai Airport to Sanur transfer details',
  },
];

const services = [
  'Bali airport transfer',
  'Hotel transfer',
  'Private Bali driver',
  'Full-day Bali tour',
  'Customized Bali transportation',
  'Group transportation services',
];

const faqs = [
  {
    question: 'How do I get from Bali Airport to my hotel?',
    answer: 'The easiest option is booking a private airport transfer. Your driver will pick you up at Ngurah Rai International Airport and take you directly to your hotel or villa.',
  },
  {
    question: 'Is private airport transfer in Bali worth it?',
    answer: 'Yes. Many travelers prefer private airport transfers because they are more comfortable, easier, and less stressful after a long flight.',
  },
  {
    question: 'Can I book airport transfer before arriving in Bali?',
    answer: 'Yes. Pre-booking airport transfer is recommended, especially during busy travel seasons in Bali.',
  },
  {
    question: 'Are Bali airport transfers available 24 hours?',
    answer: 'Yes. Bali West Transport provides airport pickup services based on your flight arrival schedule.',
  },
  {
    question: 'Which destinations are most popular from Ngurah Rai Airport?',
    answer: 'The most common Bali airport transfer destinations include Ubud, Canggu, Seminyak, Uluwatu, Sanur, Kuta, Nusa Dua, and Jimbaran.',
  },
];

const pageUrl = 'https://baliwesttransport.com/airport-transfer/';
const organizationId = `${pageUrl}#organization`;
const travelAgencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      sameAs: [],
    },
    {
      '@type': 'TravelAgency',
      '@id': travelAgencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Bali, Indonesia',
      },
      parentOrganization: {
        '@id': organizationId,
      },
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Bali Airport Transfer',
      description: pageDescription,
      serviceType: 'Private airport transfer',
      provider: {
        '@id': travelAgencyId,
      },
      areaServed: [
        { '@type': 'Place', name: 'Ngurah Rai International Airport' },
        { '@type': 'Place', name: 'Ubud' },
        { '@type': 'Place', name: 'Canggu' },
        { '@type': 'Place', name: 'Seminyak' },
        { '@type': 'Place', name: 'Uluwatu' },
        { '@type': 'Place', name: 'Sanur' },
        { '@type': 'AdministrativeArea', name: 'Bali' },
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: {
          '@type': 'ContactPoint',
          telephone: '+6282247648944',
          contactType: 'customer service',
        },
      },
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://baliwesttransport.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Bali Airport Transfer',
          item: pageUrl,
        },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': organizationId },
      about: { '@id': serviceId },
      mainEntity: [{ '@id': serviceId }, { '@id': faqId }],
      breadcrumb: { '@id': breadcrumbId },
      publisher: { '@id': organizationId },
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=1920&h=1080&fit=crop"
          alt="Private airport transfer Bali – Ngurah Rai International Airport"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/55"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Private Transfer — Bali West Transport</p>
        <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl font-medium mb-8 leading-tight drop-shadow-lg">
          Bali Airport Transfer
        </h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-3xl mx-auto font-light drop-shadow-md">
          Private transfers from Ngurah Rai Airport to Ubud, Canggu, Seminyak, Uluwatu, Sanur, and all areas across Bali.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Book Airport Transfer
          </a>
          <a href="/transfers/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">
            View All Transfers
          </a>
        </div>
      </div>
    </section>

    <!-- Intro -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Ngurah Rai International Airport (DPS)</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Reliable Private Airport Transfer in Bali</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Looking for a reliable Bali airport transfer after arriving at Ngurah Rai International Airport (DPS)? Bali West Transport provides private airport transfers from Bali Airport to Ubud, Canggu, Seminyak, Uluwatu, Sanur, and other popular destinations across Bali.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Whether you are visiting Bali for a holiday, honeymoon, surfing trip, family vacation, or business travel, booking a private airport transfer helps make your arrival easier, safer, and more comfortable.
            </p>
          </div>
          <div>
            <img
              src="/images/nusa-penida-viewpoint.jpg"
              alt="Bali private transfer service"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Info -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Service Overview</p>
          <h2 class="font-serif text-3xl text-brand-dark">Quick Information</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {quickInfo.map((item) => (
            <div class="bg-brand-cream p-6">
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">{item.label}</p>
              <p class="text-brand-dark font-medium leading-snug">{item.value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Private Transfer -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Benefits</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Choose a Private Bali Airport Transfer?</h2>
          <p class="text-brand-dark/60 mt-6 max-w-2xl mx-auto text-lg">
            After landing in Bali, many travelers prefer pre-booked airport transfers instead of searching for taxis or ride-hailing apps.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {benefits.map((benefit) => (
            <div class="flex items-start gap-4 p-6 bg-white">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{benefit}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Popular Destinations -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Airport Transfer Routes</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Popular Bali Airport Transfer Destinations</h2>
        </div>
        <div class="space-y-8">
          {destinations.map((dest) => (
            <div class="bg-brand-cream p-8 md:p-12">
              <div class="grid lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2">
                  <h3 class="font-serif text-3xl text-brand-dark mb-3">Ngurah Rai Airport to {dest.name}</h3>
                  <p class="text-brand-dark/70 leading-relaxed mb-6">{dest.description}</p>
                  <div class="grid sm:grid-cols-3 gap-4 mb-6">
                    <div>
                      <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-1">Est. Travel Time</p>
                      <p class="text-brand-dark font-medium">{dest.time}</p>
                    </div>
                    <div>
                      <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-1">Best For</p>
                      <p class="text-brand-dark font-medium">{dest.bestFor}</p>
                    </div>
                    <div>
                      <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-1">Popular Areas</p>
                      <p class="text-brand-dark font-medium">{dest.areas}</p>
                    </div>
                  </div>
                  <p class="text-brand-dark/60 text-sm italic mb-6">{dest.note}</p>
                  <a
                    href={dest.href}
                    class="inline-flex items-center gap-2 text-brand-dark hover:text-brand-gold transition-colors text-sm tracking-widest uppercase font-medium"
                  >
                    {dest.linkLabel}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </a>
                </div>
                <div class="flex flex-col justify-center items-start lg:items-center gap-4">
                  <a
                    href={`https://wa.me/6282247648944?text=${encodeURIComponent(`Hi, I would like to book a private Bali Airport to ${dest.name} transfer. Please send me your best offer.`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors w-full lg:w-auto text-center"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                    Book to {dest.name}
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
