---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const privateTransfers = [
  { from: "Gilimanuk Harbour", to: "Ubud", price: "IDR 950,000", time: "~3 hours" },
  { from: "Gilimanuk Harbour", to: "Canggu", price: "IDR 800,000", time: "~2.5 hours" },
  { from: "Gilimanuk Harbour", to: "Kuta", price: "IDR 950,000", time: "~3 hours" },
  { from: "Gilimanuk Harbour", to: "Uluwatu", price: "IDR 1,200,000", time: "~3.5 hours" },
  { from: "Gilimanuk Harbour", to: "Lovina", price: "IDR 650,000", time: "~2 hours" },
  { from: "Gilimanuk Harbour", to: "Amed", price: "IDR 1,300,000", time: "~4 hours" },
];

const minibusInfo = {
  seats: 19,
  pricePerPerson: "IDR 165,000",
  description: lang === 'en' 
    ? "Perfect for groups traveling together. Comfortable seating with air conditioning."
    : "Sempurna untuk grup yang bepergian bersama. Tempat duduk nyaman dengan AC."
};

const features = [
  { 
    title: lang === 'en' ? "Punctual" : "Tepat Waktu", 
    desc: lang === 'en' ? "We track ferry arrivals" : "Kami memantau jadwal feri" 
  },
  { 
    title: lang === 'en' ? "Premium Vehicles" : "Kendaraan Premium", 
    desc: lang === 'en' ? "Clean, air-conditioned cars" : "Mobil bersih dan ber-AC" 
  },
  { 
    title: lang === 'en' ? "Fixed Pricing" : "Harga Tetap", 
    desc: lang === 'en' ? "No hidden charges" : "Tanpa biaya tersembunyi" 
  },
  { 
    title: lang === 'en' ? "24/7 Available" : "Tersedia 24/7", 
    desc: lang === 'en' ? "Book anytime via WhatsApp" : "Pesan kapan saja via WhatsApp" 
  },
];
---

<Layout 
  title={t('meta.transfers.title')}
  description={t('meta.transfers.desc')}
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[50vh] flex items-center justify-center">
      <div class="absolute inset-0">
        <img 
          src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=1920&h=1080&fit=crop" 
          alt="Luxury car transfer"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 text-center text-white px-6">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-4 drop-shadow-md">{t('transfers.hero.subtitle')}</p>
        <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-medium mb-6 drop-shadow-lg">{t('transfers.hero.title')}</h1>
        <p class="text-xl text-white/90 max-w-xl mx-auto font-light drop-shadow-md">
          {t('transfers.hero.desc')}
        </p>
      </div>
    </section>
    
    <!-- Private Transfers -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">{lang === 'en' ? "From Gilimanuk Harbour" : "Dari Pelabuhan Gilimanuk"}</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">{t('transfers.hero.title')}</h2>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {privateTransfers.map((transfer) => (
            <div class="bg-white p-8 group hover:shadow-lg transition-shadow">
              <div class="flex justify-between items-start mb-6">
                <div>
                  <p class="text-brand-dark/50 text-sm mb-1">{lang === 'en' ? "To" : "Ke"}</p>
                  <h3 class="font-serif text-2xl text-brand-dark">{transfer.to}</h3>
                </div>
                <div class="text-right">
                  <p class="font-serif text-2xl text-brand-gold">{transfer.price}</p>
                  <p class="text-brand-dark/50 text-sm">{transfer.time}</p>
                </div>
              </div>
              <div class="flex items-center gap-2 text-brand-dark/60 text-sm mb-6">
                <span>{lang === 'en' ? "Up to 4 passengers" : "Hingga 4 penumpang"}</span>
                <span>•</span>
                <span>{lang === 'en' ? "Air-conditioned" : "Ber-AC"}</span>
              </div>
              <a 
                href={`https://wa.me/6281234567890?text=${encodeURIComponent(t('whatsapp.book_transfer'))} ${encodeURIComponent(transfer.to)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm tracking-widest uppercase text-brand-dark hover:text-brand-gold transition-colors"
              >
                <div class="bg-brand-dark-lighter/10 p-3 rounded-xl">
                  <svg class="w-6 h-6 text-brand-dark-lighter" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"/>
                  </svg>
                </div>
                <h2 class="text-2xl font-bold text-brand-dark">{t('nav.book')}</h2>
              </a>
            </div>
          ))}
        </div>
        
        <div class="bg-gradient-to-br from-brand-dark-lighter/5 to-brand-dark/5 rounded-2xl p-8 border border-brand-dark-lighter/10">
          <p class="text-center text-brand-dark/50 text-sm mt-8">
            {lang === 'en' ? "Additional destinations available on request" : "Tujuan tambahan tersedia sesuai permintaan"}
          </p>
        </div>
      </div>
    </section>
    
    <!-- Group Transfer -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <img 
              src="https://images.unsplash.com/photo-1570125909232-eb263c188f7e?w=800&h=600&fit=crop" 
              alt="Group minibus"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">{lang === 'en' ? "Group Travel" : "Perjalanan Grup"}</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">{lang === 'en' ? "19-Seat Minibus" : "Minibus 19 Kursi"}</h2>
            <div class="flex items-baseline gap-2 mb-6">
              <span class="font-serif text-4xl text-brand-gold">{minibusInfo.pricePerPerson}</span>
              <span class="text-brand-dark/60">{lang === 'en' ? "per person" : "per orang"}</span>
            </div>
            <p class="text-brand-dark/70 mb-8 leading-relaxed">
              {minibusInfo.description}
            </p>
            <div class="grid grid-cols-2 gap-4 mb-8">
              {features.map((feature) => (
                <div>
                  <p class="font-medium text-brand-dark">{feature.title}</p>
                  <p class="text-brand-dark/60 text-sm">{feature.desc}</p>
                </div>
              ))}
            </div>
            <a 
              href={`https://wa.me/6281234567890?text=${encodeURIComponent(t('whatsapp.book_minibus'))}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              {lang === 'en' ? "Book Minibus" : "Pesan Minibus"}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppFloat />
</Layout>
