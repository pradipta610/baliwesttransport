---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppFloat from '../../../components/WhatsAppFloat.astro';

const pageTitle = 'Transfer Gilimanuk ke Kuta — Antar Jemput Pribadi Door-to-Door | Bali West Transport';
const pageDescription = 'Pesan transfer pribadi dari Pelabuhan Gilimanuk ke Kuta Bali. Layanan door-to-door, 120–130 km, 3–4 jam. Dekat Bandara Ngurah Rai. Booking via WhatsApp.';
const pageKeywords = 'transfer gilimanuk ke kuta, antar jemput gilimanuk kuta, transfer pribadi gilimanuk kuta, pelabuhan gilimanuk ke kuta, mobil sewa gilimanuk kuta bali, gilimanuk kuta bandara';

const whatsappText = 'Halo, saya ingin memesan transfer pribadi Gilimanuk ke Kuta. Mohon kirimkan penawaran terbaik.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const pickupLocations = [
  'Pelabuhan Gilimanuk (Pelabuhan Penyeberangan)',
  'Hotel dan penginapan di kota Gilimanuk',
  'Area Pelabuhan Ketapang di sisi Jawa (untuk perjalanan lintas selat yang sudah diatur sebelumnya)'
];

const dropoffAreas = [
  'Jl. Legian dan koridor Poppies Lane I & II',
  'Pantai Kuta dan jalur hotel Jl. Pantai Kuta',
  'Kuta Square, Beachwalk, dan area Discovery Mall',
  'Tuban (Kuta selatan, paling dekat Bandara Ngurah Rai)',
  'Kuta Art Market dan penginapan sekitarnya'
];

const userTypes = [
  {
    title: 'Wisatawan dari Jawa',
    description: 'Tiba melalui feri Ketapang–Gilimanuk dari Banyuwangi, Surabaya, atau Ijen. Transfer pribadi adalah pilihan paling langsung dari pelabuhan, dan Kuta adalah pemberhentian pertama yang alami jika langkah selanjutnya adalah penerbangan.'
  },
  {
    title: 'Wisatawan Pertama Kali ke Bali',
    description: 'Kuta adalah kawasan wisata asli Bali — familiar, mudah dijalan kaki, dan dekat ke mana-mana. Kebanyakan wisatawan pertama kali ingin sopir yang bisa dihubungi langsung daripada mencari-cari rute bus lalu taksi di hari pertama.'
  },
  {
    title: 'Penumpang yang Akan Terbang Hari Itu Juga',
    description: 'Kuta berjarak beberapa menit dari Bandara Ngurah Rai. Jika perjalanan darat Jawa–Bali Anda berakhir dengan penerbangan, ini adalah jarak terpendek antara feri dan bandara, dengan satu sopir menangani kedua segmen jika diperlukan.'
  },
  {
    title: 'Wisatawan Surf',
    description: 'Pantai Kuta adalah ombak klasik untuk pemula di Bali. Pengangkutan papan selancar tersedia di kendaraan yang lebih besar — konfirmasi ukuran dan jumlah papan saat booking.'
  },
  {
    title: 'Keluarga dan Rombongan dengan Anggaran Terjangkau',
    description: 'Pasar akomodasi Kuta lebih luas dan ramah anggaran dibanding jalur villa Seminyak. Kendaraan pribadi menampung banyak koper tanpa batasan berat shuttle, dengan harga yang dikonfirmasi sebelum berangkat.'
  }
];

const benefits = [
  {
    title: 'Tanpa Pindah Kendaraan',
    description: 'Transportasi bersama dari Gilimanuk ke Kuta memerlukan minimal satu kali pindah di terminal Denpasar. Transfer pribadi langsung tanpa berhenti kecuali Anda yang meminta.'
  },
  {
    title: 'Jadwal Anda, Bukan Jadwal Bus',
    description: 'Berangkat segera setelah turun dari feri — tidak perlu menunggu kendaraan bersama penuh, dan tidak ada risiko ketinggalan penerbangan karena shuttle terlambat.'
  },
  {
    title: 'Door-to-Door ke Hotel atau Bandara',
    description: 'Baik Kuta adalah tujuan akhir atau transit sebelum Ngurah Rai, sopir mengantar tepat ke tempat yang Anda tuju.'
  },
  {
    title: 'Fleksibilitas Bagasi',
    description: 'Keluarga dan wisatawan long-stay sering membawa lebih dari batas berat shuttle. Kendaraan pribadi membawa semua barang bawaan rombongan Anda.'
  },
  {
    title: 'Booking dan Kontak via WhatsApp',
    description: 'Konfirmasi perjalanan, bagikan waktu kedatangan feri, dan hubungi sopir — semua melalui WhatsApp sebelum dan selama perjalanan. Tidak perlu install aplikasi atau buat akun.'
  }
];

const faqs = [
  {
    question: 'Berapa lama transfer dari Gilimanuk ke Kuta?',
    answer: 'Sekitar 3 hingga 4 jam dengan kendaraan pribadi. Perjalanan sendiri sekitar 2,5 hingga 3 jam dalam kondisi lancar, tetapi lalu lintas di Jl. Legian dan pendekatan jalan pantai menambah 20–45 menit, terutama antara pukul 16:00 dan 19:30. Kedatangan feri pagi biasanya memiliki waktu tempuh tercepat.'
  },
  {
    question: 'Berapa jarak Gilimanuk ke Kuta?',
    answer: 'Sekitar 120–130 km melalui jalan darat, melewati jalur barat utama melalui Negara dan Tabanan sebelum bergabung dengan bypass Mengwi menuju Kuta.'
  },
  {
    question: 'Di mana sopir menjemput saya di Gilimanuk?',
    answer: 'Di Pelabuhan Gilimanuk (Pelabuhan Penyeberangan), di sisi barat pelabuhan saat Anda turun dari penyeberangan Ketapang. Kirimkan referensi feri dan perkiraan waktu tiba saat booking — kami melacak penyeberangan dan menyesuaikan jika terlambat.'
  },
  {
    question: 'Apakah ada bus langsung dari Gilimanuk ke Kuta?',
    answer: 'Tidak ada bus langsung. Bus umum dari Gilimanuk menuju terminal Denpasar (Ubung atau Mengwi), di mana Anda perlu koneksi kedua ke Kuta. Total waktu perjalanan termasuk menunggu dan transit biasanya melebihi 5–6 jam. Transfer pribadi lebih cepat dan door-to-door.'
  },
  {
    question: 'Apakah Kuta dekat Bandara Ngurah Rai?',
    answer: 'Ya. Kuta dan distrik selatannya, Tuban, berbatasan langsung dengan Bandara Ngurah Rai — biasanya 10–15 menit perjalanan. Ini menjadikan transfer Gilimanuk ke Kuta pilihan praktis jika Anda transit dari Jawa menuju penerbangan lanjutan.'
  },
  {
    question: 'Bisakah membawa papan selancar dari Gilimanuk ke Kuta?',
    answer: 'Bisa. Konfirmasi jumlah dan panjang papan saat booking agar kami menyiapkan kendaraan dengan ruang yang memadai. MPV standar memuat papan hingga sekitar 6\'8" dengan kursi belakang dilipat; papan yang lebih panjang mungkin memerlukan kendaraan lebih besar.'
  },
  {
    question: 'Apakah tersedia penjemputan pagi-pagi dari pelabuhan?',
    answer: 'Ya. Kami beroperasi mengikuti jadwal feri Ketapang–Gilimanuk, termasuk penyeberangan paling pagi. Konfirmasi waktu keberangkatan feri Anda saat booking dan sopir kami akan siap saat Anda tiba.'
  },
  {
    question: 'Apa rute dari Gilimanuk ke Kuta?',
    answer: 'Pelabuhan Gilimanuk → Jl. Raya Gilimanuk ke tenggara → Negara → Tabanan → bypass Mengwi → Kuta. Rute ini mengikuti jalan raya utama barat Bali untuk sebagian besar perjalanan sebelum memasuki koridor Kuta/bandara.'
  },
  {
    question: 'Bisakah saya berhenti di Tanah Lot dalam perjalanan ke Kuta?',
    answer: 'Bisa, atas permintaan. Tanah Lot terletak dekat rute utama, sekitar 40–50 menit sebelum Kuta. Pemberhentian yang direncanakan menambah total waktu perjalanan — konfirmasi dengan kami saat booking agar sopir dapat menyesuaikan jadwal.'
  }
];

const relatedRoutes = [
  { label: 'Transfer Gilimanuk ke Ubud', href: '/id/transfers/gilimanuk-to-ubud/' },
  { label: 'Transfer Gilimanuk ke Canggu', href: '/id/transfers/gilimanuk-to-canggu/' },
  { label: 'Transfer Gilimanuk ke Seminyak', href: '/id/transfers/gilimanuk-to-seminyak/' },
  { label: 'Semua Transfer Gilimanuk', href: '/id/transfers/' },
  { label: 'Transfer Bandara', href: '/id/airport-transfer/' },
  { label: 'Semua Rute Transfer', href: '/id/transfers/' }
];

const pageUrl = 'https://baliwesttransport.com/id/transfers/gilimanuk-to-kuta/';
const canonicalEn = 'https://baliwesttransport.com/transfers/gilimanuk-to-kuta/';
const organizationId = `${pageUrl}#organization`;
const travelAgencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://baliwesttransport.com/logo.png'
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Customer Service',
        availableLanguage: ['English', 'Indonesian'],
        url: 'https://wa.me/6282247648944'
      },
      areaServed: {
        '@type': 'Place',
        name: 'Bali, Indonesia'
      }
    },
    {
      '@type': 'TravelAgency',
      '@id': travelAgencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      parentOrganization: {
        '@id': organizationId
      },
      areaServed: {
        '@type': 'Place',
        name: 'Bali, Indonesia'
      }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Transfer Pribadi Gilimanuk ke Kuta',
      description: 'Layanan transfer pribadi door-to-door dari Pelabuhan Gilimanuk ke Kuta, Bali. Sopir menjemput di pelabuhan. Jarak sekitar 120–130 km, 3–4 jam tergantung lalu lintas. Dekat Bandara Ngurah Rai.',
      provider: {
        '@id': travelAgencyId
      },
      serviceType: 'Transfer Pribadi',
      areaServed: [
        {
          '@type': 'Place',
          name: 'Gilimanuk, Jembrana, Bali, Indonesia'
        },
        {
          '@type': 'Place',
          name: 'Kuta, Badung, Bali, Indonesia'
        }
      ],
      audience: {
        '@type': 'Audience',
        audienceType: 'Wisatawan yang tiba via feri Ketapang-Gilimanuk, menuju Kuta atau Bandara Ngurah Rai'
      },
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: 'https://wa.me/6282247648944',
        servicePhone: '+6282247648944',
        availableLanguage: ['English', 'Indonesian']
      },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
        seller: {
          '@id': travelAgencyId
        }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Beranda',
          item: 'https://baliwesttransport.com/id/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Transfer Bali',
          item: 'https://baliwesttransport.com/id/transfers/'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Transfer Gilimanuk ke Kuta',
          item: pageUrl
        }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id',
      about: {
        '@id': serviceId
      },
      mainEntity: [
        { '@id': serviceId },
        { '@id': faqId }
      ],
      breadcrumb: {
        '@id': breadcrumbId
      },
      publisher: {
        '@id': organizationId
      },
      datePublished: '2026-07-05',
      dateModified: '2026-07-05'
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} includeOrgSchema={false}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/kelingking-beach.jpg"
          alt="Transfer pribadi dari Gilimanuk ke Kuta Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Transfer Pribadi — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Transfer Pribadi Gilimanuk ke Kuta</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Door-to-Door dari Pelabuhan Penyeberangan
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan Transfer Anda
          </a>
          <a href="/id/transfers/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Lihat Semua Transfer</a>
        </div>
      </div>
    </section>

    <!-- Jawaban Cepat -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jawaban Cepat</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Transfer Pribadi dari Gilimanuk ke Kuta</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Pesan transfer pribadi dari Gilimanuk ke Kuta bersama Bali West Transport. Sopir menjemput Anda langsung di Pelabuhan Gilimanuk saat turun dari penyeberangan dari Jawa. Perjalanan menempuh sekitar 120–130 km dan memakan waktu 3 hingga 4 jam dengan kendaraan pribadi, tergantung lalu lintas menuju Kuta. Layanan door-to-door ke hotel, penginapan, atau villa mana pun di Kuta — dan Kuta adalah kawasan wisata Bali yang paling dekat dengan Bandara Ngurah Rai, sehingga ini juga pilihan transfer jika Anda akan segera terbang setelah tiba.
            </p>
          </div>
          <div class="space-y-4">
            <img src="/images/nusa-penida-viewpoint.jpg" alt="Pemandangan Bali menuju Kuta" class="w-full h-auto" loading="lazy" />
            <div class="grid grid-cols-2 gap-4">
              <img src="/images/beach-sunset-swing.jpg" alt="Sunset pantai Bali" class="w-full h-48 object-cover" loading="lazy" />
              <img src="https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=400&h=300&fit=crop" alt="Sawah terasering Bali" class="w-full h-48 object-cover" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ringkasan Rute -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Rute</p>
              <p class="font-serif text-2xl text-brand-dark">Gilimanuk ke Kuta</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Jarak</p>
              <p class="font-serif text-2xl text-brand-dark">120–130 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Waktu Tempuh</p>
              <p class="font-serif text-2xl text-brand-dark">3–4 jam</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Penawaran Fleksibel</span>
              <p class="text-brand-dark/50 text-sm mt-1">Beritahu kami tanggal & jumlah rombongan.</p>
            </div>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap">Minta Penawaran Terbaik</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Mengapa Memilih Transfer Ini -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Mengapa Memilih Transfer Ini</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Mengapa Transfer Pribadi dari Gilimanuk ke Kuta?</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Tiba di Gilimanuk setelah penyeberangan feri Ketapang–Gilimanuk menempatkan Anda di ujung barat Bali, tanpa transportasi umum langsung ke Kuta. Shuttle bersama memerlukan pergantian di Terminal Ubung atau Mengwi Denpasar, dan dari sana Anda masih perlu taksi atau ride-share terpisah ke hotel — menambah biaya, waktu tunggu, dan negosiasi kedua pada hari yang sudah panjang.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Transfer pribadi menghilangkan ketiga masalah sekaligus. Sopir sudah menunggu di pelabuhan saat Anda turun dari feri, bagasi langsung masuk ke kendaraan, dan Anda langsung menuju akomodasi — atau langsung ke bandara, jika Kuta adalah transit hari yang sama sebelum penerbangan.
            </p>
          </div>
          <div>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Kuta terletak sekitar 120–130 km di tenggara Gilimanuk di pantai selatan Bali, sedikit lebih dekat dari Seminyak karena rutenya tidak berlanjut lebih jauh ke atas pantai. Rute mengikuti koridor barat utama pulau melewati Negara dan Tabanan sebelum bergabung dengan bypass Mengwi menuju area Kuta/bandara.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Lalu lintas di pendekatan akhir — terutama di Jl. Raya Kuta dan Jl. Legian menjelang sunset, serta di sekitar bundaran bandara saat jam sibuk penerbangan — dapat menambah 20–45 menit. Sopir yang mengetahui jaringan jalan satu arah di area pantai Kuta membuat perbedaan nyata di segmen terakhir ini.
            </p>
            <div class="bg-brand-cream p-6 mt-4">
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Risiko Lalu Lintas</p>
              <p class="text-brand-dark/70 text-sm">Tinggi: Jl. Legian dan koridor jalan pantai Kuta, terutama pukul 16:00–19:30</p>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2 mt-4">Waktu Keberangkatan Terbaik</p>
              <p class="text-brand-dark/70 text-sm">Kedatangan feri pagi (06:00–10:00) tiba di Kuta sebelum kemacetan sore</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bandingkan Pilihan Anda -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Bandingkan Pilihan Anda</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Transfer Pribadi vs. Bus Umum vs. Taksi di Lokasi</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full bg-white border border-brand-dark/10">
            <thead>
              <tr class="border-b border-brand-dark/10">
                <th class="p-4 text-left text-brand-dark/40 text-xs uppercase tracking-widest"></th>
                <th class="p-4 text-left text-brand-dark font-serif text-lg">Transfer Pribadi<br/><span class="text-brand-gold text-xs uppercase tracking-widest font-sans">Bali West Transport</span></th>
                <th class="p-4 text-left text-brand-dark/70 font-serif text-lg">Bus Umum via Denpasar</th>
                <th class="p-4 text-left text-brand-dark/70 font-serif text-lg">Taksi / Ride-share di Lokasi</th>
              </tr>
            </thead>
            <tbody class="text-brand-dark/70">
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Total waktu</td>
                <td class="p-4 font-medium text-brand-dark">3–4 jam, langsung</td>
                <td class="p-4">5–6+ jam, dengan transit terminal</td>
                <td class="p-4">Tidak bisa diprediksi — tidak ada penjemputan tetap di pelabuhan</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Sopir di pelabuhan feri</td>
                <td class="p-4 font-medium text-brand-dark">Ya, dilacak sesuai penyeberangan Anda</td>
                <td class="p-4">Tidak</td>
                <td class="p-4">Tidak — Anda mengantri dan negosiasi saat tiba</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Harga diketahui sebelum berangkat</td>
                <td class="p-4 font-medium text-brand-dark">Ya, penawaran tetap dikonfirmasi via WhatsApp</td>
                <td class="p-4">Hanya harga tiket; biaya taksi belum diketahui</td>
                <td class="p-4">Tidak — dinegosiasi di tempat</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Titik pengantaran</td>
                <td class="p-4 font-medium text-brand-dark">Tepat di pintu hotel/villa Anda</td>
                <td class="p-4">Terminal Denpasar, lalu kendaraan kedua</td>
                <td class="p-4">Tergantung sopir, sering tidak door-to-door</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Penanganan bagasi</td>
                <td class="p-4 font-medium text-brand-dark">Tanpa batas sesuai kapasitas kendaraan</td>
                <td class="p-4">Batasan berat shuttle berlaku</td>
                <td class="p-4">Bervariasi, kebijaksanaan sopir</td>
              </tr>
              <tr>
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Metode booking</td>
                <td class="p-4 font-medium text-brand-dark">WhatsApp, dikonfirmasi dalam hitungan menit</td>
                <td class="p-4">Beli tiket di terminal</td>
                <td class="p-4">Tidak ada — diatur setelah Anda tiba</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Penjemputan & Pengantaran -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Penjemputan</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Penjemputan di Pelabuhan Gilimanuk</h2>
            <p class="text-brand-dark/70 mb-6">Sopir menjemput Anda di <strong>Pelabuhan Gilimanuk (Pelabuhan Penyeberangan)</strong>, di sisi barat pelabuhan saat Anda turun. Kirimkan perkiraan waktu tiba dan referensi booking feri saat memesan — kami memantau penyeberangan dan menyesuaikan jika ada keterlambatan agar Anda tidak perlu menunggu.</p>
            <p class="text-brand-dark/70 mb-6">Penjemputan tambahan tersedia dari:</p>
            <div class="space-y-3 mb-6">
              {pickupLocations.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
          </div>
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pengantaran</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Lokasi Pengantaran di Kuta</h2>
            <p class="text-brand-dark/70 mb-6">Pengantaran door-to-door ke alamat mana pun di Kuta, termasuk:</p>
            <div class="space-y-3 mb-8">
              {dropoffAreas.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <p class="text-brand-dark/50 text-sm">Jika pengantaran di gang sempit di belakang jalan pantai utama, konfirmasi alamat lengkap saat booking — sopir kami mengetahui jaringan gang di Kuta dan akan menemukan pintu masuk yang tepat.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Siapa yang Menggunakan Transfer Ini -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Siapa yang Menggunakan Transfer Ini</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Populer untuk Wisatawan Pertama, Peselancar, Keluarga, dan Penumpang Transit</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {userTypes.map((item) => (
            <div class="bg-white p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.title}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Gambaran Perjalanan -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Gambaran Perjalanan</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Rute dari Gilimanuk ke Kuta</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Perjalanan dari Gilimanuk ke Kuta mengikuti jalan raya pantai barat utama Bali untuk sebagian besar rutenya. Setelah meninggalkan pelabuhan, rute menuju tenggara melewati dataran sawah Kabupaten Jembrana, melewati Negara — ibu kota kabupaten dan tempat istirahat alami — sebelum melanjutkan ke Kabupaten Tabanan.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Dari Tabanan jalan bergabung dengan bypass Mengwi, yang langsung menuju koridor Kuta/bandara tanpa perlu melanjutkan lebih jauh ke atas pantai menuju Seminyak. Lalu lintas semakin padat dari Mengwi ke depan, dan kilometer terakhir di Jl. Raya Kuta dan menuju jaringan jalan pantai Legian adalah segmen tersibuk dari perjalanan, terutama menjelang sunset.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Sopir akan menggunakan pengetahuan rute lokal di pendekatan akhir untuk mengelola lalu lintas. Jika Anda memerlukan istirahat, Negara adalah titik terbaik — kira-kira di tengah perjalanan, dengan opsi rest area yang andal dan bahan bakar tersedia.
            </p>
          </div>
          <div>
            <img
              src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&h=600&fit=crop"
              alt="Pemandangan Bali sepanjang rute Gilimanuk ke Kuta"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Keunggulan Transfer Pribadi -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Keunggulan Transfer Pribadi</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Mengapa Memilih Transfer Pribadi?</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {benefits.map((item) => (
            <div class="bg-white p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.title}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Pertanyaan yang Sering Diajukan</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{faq.question}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Bawah -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-dark p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="font-serif text-2xl text-brand-cream mb-2">Siap booking? Kirim detail feri Anda via WhatsApp.</h3>
            <p class="text-brand-cream/60">Sertakan tanggal kedatangan, perkiraan waktu di Gilimanuk, dan jumlah penumpang. Kami akan mengkonfirmasi sopir dan kendaraan dalam hitungan menit.</p>
          </div>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan via WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Rute Transfer Gilimanuk Lainnya -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Rute Transfer Gilimanuk Lainnya</p>
          <h2 class="font-serif text-3xl text-brand-dark">Bepergian ke Bagian Bali Lainnya?</h2>
          <p class="text-brand-dark/60 mt-4">Lihat semua rute yang tersedia dari pelabuhan penyeberangan.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {relatedRoutes.map((route) => (
            <a href={route.href} class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
              <span class="text-brand-dark font-medium text-sm">{route.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Jelajahi Lebih Lanjut -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jelajahi Lebih Lanjut</p>
          <h2 class="font-serif text-3xl text-brand-dark">Selengkapnya dari Bali West Transport</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-4">
          <a href="/id/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Beranda</span>
          </a>
          <a href="/id/airport-transfer/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Transfer Bandara</span>
          </a>
          <a href="/id/tours/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Tur Pribadi</span>
          </a>
          <a href="/id/about/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Tentang Kami</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>
