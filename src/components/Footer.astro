---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-dark text-brand-cream py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 mb-16">
      <div class="md:col-span-2">
        <h3 class="font-serif text-3xl mb-6">Bali West Transport</h3>
        <p class="text-brand-cream/60 leading-relaxed max-w-md">
          {t('footer.about')}
        </p>
      </div>
      
      <div>
        <h4 class="text-brand-gold text-sm tracking-widest uppercase mb-6">{t('footer.quick_links')}</h4>
        <ul class="space-y-3 text-brand-cream/60">
          <li><a href={lang === 'en' ? '/' : `/${lang}`} class="hover:text-brand-cream transition-colors">{t('nav.home')}</a></li>
          <li><a href={lang === 'en' ? '/tours' : `/${lang}/tours`} class="hover:text-brand-cream transition-colors">{t('nav.tours')}</a></li>
          <li><a href={lang === 'en' ? '/transfers' : `/${lang}/transfers`} class="hover:text-brand-cream transition-colors">{t('nav.transfers')}</a></li>
          <li><a href={lang === 'en' ? '/airport-transfer/' : `/${lang}/airport-transfer/`} class="hover:text-brand-cream transition-colors">{lang === 'en' ? 'Airport Transfer' : 'Transfer Bandara'}</a></li>
          <li><a href={lang === 'en' ? '/about' : `/${lang}/about`} class="hover:text-brand-cream transition-colors">{t('nav.about')}</a></li>
        </ul>
      </div>
      
      <div>
        <details class="footer-dropdown-group" open>
          <summary class="flex items-center justify-between gap-3 text-brand-gold text-sm tracking-widest uppercase mb-6 cursor-pointer">
            {lang === 'en' ? 'Main Services' : 'Layanan Utama'}
            <svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <ul class="space-y-3 text-brand-cream/60">
            <li><a href={lang === 'en' ? '/transfers/' : `/${lang}/transfers/`} class="hover:text-brand-cream transition-colors">{lang === 'en' ? 'All Transfers' : 'Semua Transfer'}</a></li>
            <li><a href={lang === 'en' ? '/airport-transfer/' : `/${lang}/airport-transfer/`} class="hover:text-brand-cream transition-colors">{lang === 'en' ? 'Bali Airport Transfer' : 'Transfer Bandara Bali'}</a></li>
          </ul>
        </details>
        <details class="footer-dropdown-group mt-8" open>
          <summary class="flex items-center justify-between gap-3 text-brand-gold text-sm tracking-widest uppercase mb-6 cursor-pointer">
            {lang === 'en' ? 'Popular Routes' : 'Rute Populer'}
            <svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <ul class="space-y-3 text-brand-cream/60">
            <li><a href={lang === 'en' ? '/airport-transfer/ngurah-rai-airport-to-ubud/' : `/${lang}/airport-transfer/ngurah-rai-airport-to-ubud/`} class="hover:text-brand-cream transition-colors">{lang === 'en' ? 'Airport to Ubud' : 'Bandara ke Ubud'}</a></li>
            <li><a href={lang === 'en' ? '/airport-transfer/ngurah-rai-airport-to-canggu/' : `/${lang}/airport-transfer/ngurah-rai-airport-to-canggu/`} class="hover:text-brand-cream transition-colors">{lang === 'en' ? 'Airport to Canggu' : 'Bandara ke Canggu'}</a></li>
            <li><a href={lang === 'en' ? '/airport-transfer/ngurah-rai-airport-to-seminyak/' : `/${lang}/airport-transfer/ngurah-rai-airport-to-seminyak/`} class="hover:text-brand-cream transition-colors">{lang === 'en' ? 'Airport to Seminyak' : 'Bandara ke Seminyak'}</a></li>
            <li><a href={lang === 'en' ? '/airport-transfer/ngurah-rai-airport-to-uluwatu/' : `/${lang}/airport-transfer/ngurah-rai-airport-to-uluwatu/`} class="hover:text-brand-cream transition-colors">{lang === 'en' ? 'Airport to Uluwatu' : 'Bandara ke Uluwatu'}</a></li>
            <li><a href={lang === 'en' ? '/airport-transfer/ngurah-rai-airport-to-sanur/' : `/${lang}/airport-transfer/ngurah-rai-airport-to-sanur/`} class="hover:text-brand-cream transition-colors">{lang === 'en' ? 'Airport to Sanur' : 'Bandara ke Sanur'}</a></li>
            <li><a href={lang === 'en' ? '/transfers/gilimanuk-to-ubud/' : `/${lang}/transfers/gilimanuk-to-ubud/`} class="hover:text-brand-cream transition-colors">{lang === 'en' ? 'Gilimanuk to Ubud' : 'Gilimanuk ke Ubud'}</a></li>
            <li><a href={lang === 'en' ? '/transfers/gilimanuk-to-canggu/' : `/${lang}/transfers/gilimanuk-to-canggu/`} class="hover:text-brand-cream transition-colors">{lang === 'en' ? 'Gilimanuk to Canggu' : 'Gilimanuk ke Canggu'}</a></li>
          </ul>
        </details>
      </div>
      
      <div>
        <h4 class="text-brand-gold text-sm tracking-widest uppercase mb-6">{t('footer.contact')}</h4>
        <a 
          href={`https://wa.me/6282247648944?text=${encodeURIComponent(t('whatsapp.message'))}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-brand-cream/60 hover:text-brand-cream transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {t('footer.whatsapp')}
        </a>
        <a 
          href="tel:+6285737866348"
          class="inline-flex items-center gap-2 text-brand-cream/60 hover:text-brand-cream transition-colors mt-3"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          +62 857-3786-6348
        </a>
        <p class="text-brand-cream/40 text-sm mt-4">
          {t('footer.available')}
        </p>
      </div>
    </div>
    
    <div class="border-t border-brand-cream/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-brand-cream/40 text-sm">&copy; {currentYear} Bali West Transport. {t('footer.rights')}</p>
      <p class="text-brand-cream/40 text-sm">{t('footer.crafted')}</p>
    </div>
  </div>
</footer>

<style>
  .footer-dropdown-group > summary {
    list-style: none;
  }

  .footer-dropdown-group > summary::-webkit-details-marker {
    display: none;
  }

  .footer-dropdown-group[open] > summary svg {
    transform: rotate(180deg);
  }
</style>

