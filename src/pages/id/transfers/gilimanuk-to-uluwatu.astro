---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppFloat from '../../../components/WhatsAppFloat.astro';

const pageTitle = 'Transfer Pribadi Gilimanuk ke Uluwatu | Bali West Transport';
const pageDescription = 'Pesan transfer pribadi dari Pelabuhan Gilimanuk ke Uluwatu. Layanan door-to-door nyaman, perjalanan sekitar 4,5–5,5 jam melintasi Bali. Booking via WhatsApp, penawaran terbaik tersedia.';
const pageKeywords = 'transfer gilimanuk ke uluwatu, taksi gilimanuk uluwatu, transfer pribadi gilimanuk uluwatu, transportasi pelabuhan ke uluwatu';

const whatsappText = 'Halo, saya ingin memesan transfer pribadi dari Gilimanuk ke Uluwatu. Mohon informasi penawaran terbaik Anda.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const keunggulan = [
  'Tanpa perpindahan antara ferry, bus, dan taksi — satu perjalanan langsung',
  'Kenyamanan ber-AC untuk rute transfer domestik terpanjang di Bali',
  'Titik jemput dan antar fleksibel, termasuk vila tebing terpencil di Bukit',
  'Opsi singgah (Taman Budaya GWK, Tanah Lot, Pantai Selancar Medewi) tersedia atas permintaan',
  'Pengemudi berbahasa Inggris yang menguasai rute Gilimanuk–Uluwatu',
  'Layanan door-to-door dengan harga pasti — tanpa tawar-menawar saat tiba'
];

const lokasiJemput = [
  'Pelabuhan Gilimanuk',
  'Kota Gilimanuk dan hotel-hotel sekitarnya',
  'Area Pantai Karangsewu',
  'Titik penjemputan khusus di sepanjang jalur ferry Jawa–Bali atas permintaan'
];

const lokasiAntar = [
  'Area Pura Luhur Uluwatu',
  'Pantai Padang Padang',
  'Pantai Bingin',
  'Pantai Suluban (Blue Point)',
  'Pantai Balangan',
  'Pantai Melasti',
  'Pantai Green Bowl',
  'Pecatu dan vila/hotel sekitarnya'
];

const areaTujuan = [
  'Pura Luhur Uluwatu',
  'Padang Padang',
  'Pantai Bingin',
  'Suluban (Blue Point)',
  'Pantai Balangan',
  'Pecatu',
  'Taman Budaya GWK',
  'Pantai Melasti'
];

const pemandanganRute = [
  'Pedesaan Negara dan Tabanan',
  'Jalan lingkar Denpasar',
  'Garis pantai Jimbaran',
  'Tebing Semenanjung Bukit',
  'Taman Budaya GWK (opsi singgah)'
];

const faq = [
  {
    pertanyaan: 'Berapa lama transfer Gilimanuk ke Uluwatu?',
    jawaban: 'Perjalanan memakan waktu sekitar 4,5 hingga 5,5 jam dengan mobil pribadi, tergantung lalu lintas melalui Denpasar dan menuju Semenanjung Bukit.'
  },
  {
    pertanyaan: 'Berapa jauh Uluwatu dari Gilimanuk?',
    jawaban: 'Uluwatu berjarak sekitar 145 km dari Pelabuhan Gilimanuk, menjadikannya rute transfer tunggal terpanjang Bali West Transport.'
  },
  {
    pertanyaan: 'Bisakah saya singgah di tengah perjalanan?',
    jawaban: 'Bisa. Titik singgah populer termasuk Taman Budaya GWK, Pura Tanah Lot, dan Pantai Selancar Medewi. Beri tahu kami preferensi Anda saat memesan.'
  },
  {
    pertanyaan: 'Di mana saja saya bisa diantar di Uluwatu?',
    jawaban: 'Kami melayani semua area utama termasuk Pura Luhur Uluwatu, Padang Padang, Bingin, Suluban, Balangan, Melasti, serta vila dan hotel di Pecatu.'
  },
  {
    pertanyaan: 'Bagaimana cara memesan transfer ini?',
    jawaban: 'Hubungi kami langsung via WhatsApp dengan waktu kedatangan ferry, jumlah penumpang, dan alamat tujuan di Uluwatu untuk mendapatkan penawaran terbaik.'
  },
  {
    pertanyaan: 'Apakah transfer ini cocok untuk papan selancar atau bagasi tambahan?',
    jawaban: 'Ya, beri tahu kami sebelumnya jika Anda membawa papan selancar atau bagasi tambahan agar kami dapat menyiapkan kendaraan yang sesuai.'
  }
];

const ruteTerkait = [
  { label: 'Gilimanuk ke Ubud', href: '/id/transfers/gilimanuk-to-ubud/' },
  { label: 'Gilimanuk ke Kuta', href: '/id/transfers/gilimanuk-to-kuta/' },
  { label: 'Gilimanuk ke Sanur', href: '/id/transfers/gilimanuk-to-sanur/' },
  { label: 'Gilimanuk ke Seminyak', href: '/id/transfers/gilimanuk-to-seminyak/' },
  { label: 'Gilimanuk ke Canggu', href: '/id/transfers/gilimanuk-to-canggu/' },
  { label: 'Gilimanuk ke Nusa Dua', href: '/id/transfers/gilimanuk-to-nusa-dua/' },
  { label: 'Transfer Bandara ke Uluwatu', href: '/id/airport-transfer/ngurah-rai-airport-to-uluwatu/' }
];

const pageUrl = 'https://baliwesttransport.com/id/transfers/gilimanuk-to-uluwatu/';
const orgId = `${pageUrl}#organization`;
const agencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Bali',
        addressCountry: 'ID',
      },
    },
    {
      '@type': 'TravelAgency',
      '@id': agencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: { '@type': 'AdministrativeArea', name: 'Bali, Indonesia' },
      parentOrganization: { '@id': orgId },
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Transfer Gilimanuk ke Uluwatu',
      alternateName: 'Gilimanuk to Uluwatu Transfer',
      description: pageDescription,
      serviceType: 'Transfer pribadi',
      provider: { '@id': agencyId },
      availableLanguage: [
        { '@type': 'Language', name: 'Indonesian' },
        { '@type': 'Language', name: 'English' },
      ],
      areaServed: [
        { '@type': 'Place', name: 'Gilimanuk' },
        { '@type': 'Place', name: 'Uluwatu' },
        { '@type': 'Place', name: 'Bukit Peninsula' },
        { '@type': 'AdministrativeArea', name: 'Bali' },
        { '@type': 'Country', name: 'Indonesia' },
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: {
          '@type': 'ContactPoint',
          telephone: '+6282247648944',
          contactType: 'customer service',
          availableLanguage: ['Indonesian', 'English'],
        },
      },
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.pertanyaan,
        acceptedAnswer: { '@type': 'Answer', text: item.jawaban },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://baliwesttransport.com/id/' },
        { '@type': 'ListItem', position: 2, name: 'Transfer', item: 'https://baliwesttransport.com/id/transfers/' },
        { '@type': 'ListItem', position: 3, name: 'Transfer Gilimanuk ke Uluwatu', item: pageUrl },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id',
      isPartOf: { '@id': orgId },
      about: { '@id': serviceId },
      mainEntity: [{ '@id': serviceId }, { '@id': faqId }],
      breadcrumb: { '@id': breadcrumbId },
      publisher: { '@id': orgId },
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/kelingking-beach.jpg"
          alt="Transfer pribadi dari Gilimanuk ke Uluwatu Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Transfer Pribadi — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Transfer Gilimanuk ke Uluwatu</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Layanan antar jemput door-to-door dari Pelabuhan Gilimanuk ke Uluwatu dengan supir lokal profesional.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan Transfer Sekarang
          </a>
          <a href="/id/transfers/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Lihat Semua Transfer</a>
        </div>
      </div>
    </section>

    <!-- Intro -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jawaban Cepat</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Transfer Pribadi dari Gilimanuk ke Uluwatu</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Pesan transfer pribadi dari Gilimanuk ke Uluwatu bersama Bali West Transport. Perjalanan menempuh sekitar 145 km dan memakan waktu 4,5 hingga 5,5 jam tergantung kondisi lalu lintas, menjadikannya rute terpanjang dalam jaringan kami.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Nikmati perjalanan door-to-door dengan mobil pribadi yang nyaman langsung dari Pelabuhan Gilimanuk menuju hotel, vila, atau beach club Anda di Uluwatu — cocok untuk wisatawan yang tiba dari Jawa via ferry.
            </p>
          </div>
          <div class="space-y-4">
            <img src="/images/nusa-penida-viewpoint.jpg" alt="Pemandangan Bali di rute Gilimanuk ke Uluwatu" class="w-full h-auto" loading="lazy" />
            <div class="grid grid-cols-2 gap-4">
              <img src="/images/beach-sunset-swing.jpg" alt="Sunset tebing dekat Uluwatu" class="w-full h-48 object-cover" loading="lazy" />
              <img src="https://images.unsplash.com/photo-1518544866330-4d9ee7c3ea78?w=400&h=300&fit=crop" alt="Garis pantai tebing Uluwatu Bali" class="w-full h-48 object-cover" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ringkasan Rute -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Rute</p>
              <p class="font-serif text-2xl text-brand-dark">Gilimanuk ke Uluwatu</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Jarak</p>
              <p class="font-serif text-2xl text-brand-dark">~145 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Waktu</p>
              <p class="font-serif text-2xl text-brand-dark">4,5–5,5 jam</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Penawaran Terbaik</span>
              <p class="text-brand-dark/50 text-sm mt-1">Informasikan tanggal & jumlah penumpang.</p>
            </div>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
            >
              Minta Penawaran Terbaik
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Keunggulan -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Mengapa Memilih Kami</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Keunggulan Transfer Gilimanuk ke Uluwatu Kami</h2>
        </div>
        <p class="text-brand-dark/70 text-lg leading-relaxed max-w-3xl mx-auto text-center mb-12">
          Uluwatu adalah destinasi paling selatan di Bali, berada di ujung Semenanjung Bukit — perjalanan panjang lintas wilayah yang jauh lebih nyaman dengan mobil pribadi ber-AC dibandingkan bus umum dengan banyak perpindahan. Pengemudi kami menguasai rute melalui Negara, Tabanan, dan jalan lingkar Denpasar dengan baik.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {keunggulan.map((item) => (
            <div class="flex items-start gap-4 p-6 bg-brand-cream">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Lokasi Jemput & Antar -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Penjemputan</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Lokasi Penjemputan di Gilimanuk</h2>
            <p class="text-brand-dark/70 mb-6">Kami dapat menjemput dari:</p>
            <div class="space-y-3 mb-6">
              {lokasiJemput.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <p class="text-brand-dark/50 text-sm">Supir kami akan berkoordinasi sebelum keberangkatan untuk memastikan proses penjemputan berjalan lancar.</p>
          </div>
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pengantaran</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Lokasi Pengantaran di Uluwatu</h2>
            <p class="text-brand-dark/70 mb-6">Kami mengantarkan langsung ke:</p>
            <div class="space-y-3 mb-8">
              {lokasiAntar.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <div>
              <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Area Populer di Uluwatu</p>
              <div class="grid grid-cols-2 gap-3">
                {areaTujuan.map((area) => (
                  <div class="bg-white p-3 text-brand-dark/60 text-sm">{area}</div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Siapa yang Menggunakan -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Siapa yang Menggunakan Transfer Ini</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Ideal untuk Peselancar, Pengantin Baru & Wisatawan dari Jawa</h2>
            <ul class="space-y-3 text-brand-dark/70 text-lg leading-relaxed mb-8">
              <li>Wisatawan yang tiba melalui ferry Gilimanuk–Ketapang dari Jawa menuju pantai dan resor Uluwatu</li>
              <li>Peselancar menuju ombak kelas dunia di Uluwatu, Padang Padang, Bingin, atau Suluban</li>
              <li>Pasangan dan pengantin baru yang memesan vila tebing di Pecatu dan Semenanjung Bukit</li>
              <li>Rombongan yang berpindah dari Bali Barat menuju beach club Bali Selatan</li>
            </ul>
            <div>
              <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Sepanjang Rute</p>
              <div class="grid grid-cols-2 gap-3">
                {pemandanganRute.map((item) => (
                  <div class="bg-brand-cream p-3 text-brand-dark/70 text-sm">{item}</div>
                ))}
              </div>
            </div>
          </div>
          <div>
            <img
              src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&h=600&fit=crop"
              alt="Wisatawan tiba dari Jawa ke Bali via Pelabuhan Gilimanuk"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Gambaran Perjalanan -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Gambaran Perjalanan</p>
          <h2 class="font-serif text-4xl text-brand-dark mb-6">Dari Gilimanuk Menuju Semenanjung Bukit</h2>
          <p class="text-brand-dark/70 text-lg leading-relaxed">
            Dari Gilimanuk, rute menuju timur melalui jalan utama lintas pulau melewati Negara dan Tabanan, melintasi sawah dan kota-kota kecil sebelum menyambung ke jalan lingkar Denpasar. Dari sana, perjalanan berlanjut ke selatan melalui Jimbaran menuju Semenanjung Bukit, di mana jalan menyempit dan menanjak menuju medan tebing Uluwatu. Mengingat jaraknya, kami menyarankan keberangkatan pagi untuk menghindari kemacetan sore di Denpasar dan tiba di Uluwatu tepat waktu untuk menikmati matahari terbenam.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Pertanyaan yang Sering Diajukan</h2>
        </div>
        <div class="space-y-4">
          {faq.map((item) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-xl text-brand-dark mb-3">{item.pertanyaan}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.jawaban}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
