---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppFloat from '../../../components/WhatsAppFloat.astro';

const pageTitle = 'Transfer Bandara Ngurah Rai ke Seminyak | Antar Jemput Bandara Pribadi Bali';
const pageDescription = 'Pesan transfer pribadi dari Bandara Ngurah Rai ke Seminyak bersama Bali West Transport. Supir lokal profesional, kendaraan ber-AC, antar langsung ke hotel atau villa. Tersedia 24 jam.';
const pageKeywords = 'transfer bandara ngurah rai ke seminyak, antar jemput bandara bali ke seminyak, transfer bandara pribadi seminyak, bandara DPS ke seminyak, jemput bandara seminyak bali, bali west transport';

const whatsappText = 'Halo, saya ingin memesan transfer dari Bandara Ngurah Rai ke Seminyak. Mohon informasi penawaran terbaik Anda.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const keunggulan = [
  'Supir menunggu di area kedatangan bandara',
  'Harga tetap tanpa biaya tersembunyi',
  'Antar langsung ke hotel atau villa di seluruh Seminyak',
  'Kendaraan pribadi yang nyaman',
  'Penanganan bagasi yang lebih mudah',
  'Lebih tenang setelah penerbangan panjang',
  'Penjemputan bandara tersedia 24 jam',
  'Nyaman untuk wisatawan pertama kali ke Bali'
];

const areaSeminyak = [
  'Petitenget',
  'Oberoi',
  'Kayu Aya',
  'Batu Belig',
  'Area Double Six',
  'Area Sunset Road'
];

const pantaiSeminyak = [
  'Pantai Seminyak',
  'Pantai Petitenget',
  'Pantai Double Six',
  'Eat Street (Kayu Aya)'
];

const keunggulanTransferPribadi = [
  'Jemput bandara termasuk',
  'Harga tetap',
  'Kendaraan pribadi',
  'Transfer langsung',
  'Kedatangan lebih tenang'
];

const faq = [
  {
    pertanyaan: 'Apa cara terbaik dari Bandara Bali ke Seminyak?',
    jawaban: 'Untuk kebanyakan wisatawan, transfer bandara pribadi adalah pilihan paling nyaman karena menyediakan penjemputan langsung dan layanan antar ke hotel tanpa perlu antrian taksi atau negosiasi tarif.'
  },
  {
    pertanyaan: 'Berapa lama perjalanan dari Bandara Ngurah Rai ke Seminyak?',
    jawaban: 'Waktu tempuh biasanya sekitar 30–60 menit tergantung kondisi lalu lintas. Saat jam sibuk atau momen sunset, kemacetan bisa memperpanjang perjalanan.'
  },
  {
    pertanyaan: 'Apakah Seminyak dekat dengan Bandara Bali?',
    jawaban: 'Ya. Seminyak adalah salah satu kawasan wisata utama yang paling dekat dari Bandara Ngurah Rai, berjarak sekitar 10–13 kilometer tergantung lokasi hotel Anda.'
  },
  {
    pertanyaan: 'Bisakah memesan transfer bandara ke Seminyak sebelum tiba?',
    jawaban: 'Ya. Pemesanan transportasi bandara jauh hari sangat direkomendasikan, terutama saat periode perjalanan padat, untuk memastikan supir sudah siap dan terkonfirmasi saat Anda mendarat.'
  },
  {
    pertanyaan: 'Apakah penjemputan bandara tersedia larut malam?',
    jawaban: 'Ya. Bali West Transport menyediakan layanan penjemputan bandara sesuai jadwal kedatangan penerbangan Anda, termasuk penerbangan malam dan dini hari.'
  }
];

const ruteTerkait = [
  { label: 'Hub Transfer Bandara', href: '/id/airport-transfer/' },
  { label: 'Bandara ke Ubud', href: '/id/airport-transfer/ngurah-rai-airport-to-ubud/' },
  { label: 'Bandara ke Canggu', href: '/id/airport-transfer/ngurah-rai-airport-to-canggu/' },
  { label: 'Bandara ke Uluwatu', href: '/id/airport-transfer/ngurah-rai-airport-to-uluwatu/' },
  { label: 'Bandara ke Sanur', href: '/id/airport-transfer/ngurah-rai-airport-to-sanur/' },
  { label: 'Semua Transfer Bali', href: '/id/transfers/' }
];

const pageUrl = 'https://baliwesttransport.com/id/airport-transfer/ngurah-rai-airport-to-seminyak/';
const orgId = `${pageUrl}#organization`;
const agencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      address: { '@type': 'PostalAddress', addressLocality: 'Bali', addressCountry: 'ID' }
    },
    {
      '@type': 'TravelAgency',
      '@id': agencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: { '@type': 'AdministrativeArea', name: 'Bali, Indonesia' },
      parentOrganization: { '@id': orgId }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Transfer Bandara Ngurah Rai ke Seminyak',
      alternateName: 'Ngurah Rai Airport to Seminyak Transfer',
      description: pageDescription,
      serviceType: 'Transfer Bandara Pribadi',
      provider: { '@id': agencyId },
      availableLanguage: [{ '@type': 'Language', name: 'Indonesian' }, { '@type': 'Language', name: 'English' }],
      areaServed: [
        { '@type': 'Place', name: 'Bandara Ngurah Rai Internasional' },
        { '@type': 'Place', name: 'Seminyak' },
        { '@type': 'AdministrativeArea', name: 'Bali' }
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: { '@type': 'ContactPoint', telephone: '+6282247648944', contactType: 'customer service' }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.pertanyaan,
        acceptedAnswer: { '@type': 'Answer', text: item.jawaban }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://baliwesttransport.com/id/' },
        { '@type': 'ListItem', position: 2, name: 'Transfer Bandara', item: 'https://baliwesttransport.com/id/airport-transfer/' },
        { '@type': 'ListItem', position: 3, name: 'Transfer Bandara Ngurah Rai ke Seminyak', item: pageUrl }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id',
      isPartOf: { '@id': orgId },
      about: { '@id': serviceId },
      mainEntity: [{ '@id': serviceId }, { '@id': faqId }],
      breadcrumb: { '@id': breadcrumbId },
      publisher: { '@id': orgId }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} includeOrgSchema={false}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/kelingking-beach.jpg"
          alt="Transfer pribadi dari Bandara Ngurah Rai ke Seminyak Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Antar Jemput Bandara Pribadi — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Transfer Bandara Ngurah Rai ke Seminyak</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Antar jemput door-to-door dari Bandara Bali ke Seminyak dengan supir lokal profesional dan layanan antar langsung ke hotel atau villa.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan Transfer Sekarang
          </a>
          <a href="/id/airport-transfer/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Hub Transfer Bandara</a>
        </div>
      </div>
    </section>

    <!-- Intro + Info Cepat -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Antar Jemput Bandara Pribadi</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Transfer Pribadi dari Bandara Bali ke Seminyak</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Pesan transfer dari Bandara Ngurah Rai ke Seminyak bersama Bali West Transport. Perjalanan memakan waktu sekitar 30–60 menit tergantung lalu lintas, dengan layanan door-to-door yang nyaman untuk wisatawan yang tiba di Bandara Ngurah Rai Internasional (DPS).
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Seminyak adalah salah satu destinasi wisata paling populer di Bali, dikenal dengan resort mewah, restoran, kafe, beach club, dan kehidupan malam yang semarak. Karena Seminyak relatif dekat dari Bandara Ngurah Rai, banyak wisatawan lebih memilih transfer bandara pribadi untuk transportasi cepat dan bebas stres langsung ke akomodasi mereka.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Untuk wisatawan yang mengunjungi Seminyak untuk beach club, villa mewah, belanja, kehidupan malam, atau liburan santai di Bali, memesan transfer bandara pribadi adalah salah satu cara termudah dan ternyaman memulai perjalanan.
            </p>
          </div>
          <div class="bg-white p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-6">Informasi Cepat</p>
            <div class="space-y-4">
              {[
                ['Layanan', 'Transfer Bandara Bali ke Seminyak'],
                ['Lokasi Jemput', 'Bandara Ngurah Rai Internasional (DPS)'],
                ['Tujuan', 'Seminyak, Bali'],
                ['Jenis Kendaraan', 'Mobil Pribadi dengan Supir'],
                ['Estimasi Waktu Tempuh', '30–60 Menit'],
                ['Ketersediaan', '24 Jam'],
                ['Armada', 'Kendaraan Pribadi Ber-AC'],
                ['Jenis Layanan', 'Jemput Bandara & Antar ke Hotel'],
                ['Penyedia', 'Bali West Transport'],
              ].map(([label, value]) => (
                <div class="flex justify-between gap-4 border-b border-brand-dark/10 pb-4">
                  <span class="text-brand-dark/50 text-sm">{label}</span>
                  <span class="text-brand-dark font-medium text-sm text-right">{value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ringkasan Rute -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-cream p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Rute</p>
              <p class="font-serif text-2xl text-brand-dark">DPS → Seminyak</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Jarak</p>
              <p class="font-serif text-2xl text-brand-dark">10–13 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Waktu</p>
              <p class="font-serif text-2xl text-brand-dark">30–60 mnt</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Penawaran Fleksibel</span>
              <p class="text-brand-dark/50 text-sm mt-1">Informasikan tanggal & jumlah penumpang.</p>
            </div>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
            >
              Minta Penawaran Terbaik
            </a>
          </div>
        </div>
        <div class="mt-6 bg-brand-cream p-6">
          <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Estimasi Waktu Tempuh</p>
          <div class="grid grid-cols-3 gap-3">
            {[
              'Dini hari: 20–35 mnt',
              'Lalu lintas normal: 30–50 mnt',
              'Jam sibuk: 60+ mnt'
            ].map((item) => (
              <div class="bg-white p-3 text-brand-dark/70 text-sm text-center">{item}</div>
            ))}
          </div>
          <p class="text-brand-dark/50 text-sm mt-4">Kondisi lalu lintas di Bali dapat sangat mempengaruhi waktu tempuh, terutama saat jam sunset dan periode liburan padat.</p>
        </div>
      </div>
    </section>

    <!-- Mengapa Pilih Transfer Pribadi -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Cara Terbaik Menuju Seminyak</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Cara Terbaik dari Bandara Ngurah Rai ke Seminyak</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Bagi kebanyakan wisatawan, transfer bandara pribadi adalah pilihan paling nyaman karena menyediakan penjemputan langsung, harga tetap, dan layanan antar ke hotel.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {keunggulan.map((item) => (
            <div class="flex items-start gap-4 p-6 bg-white">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Area Seminyak -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jangkauan Pengantaran</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Transfer Bandara ke Semua Area Seminyak</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Bali West Transport menyediakan transfer bandara ke seluruh area Seminyak. Baik Anda menginap di villa mewah, hotel butik, resort tepi pantai, maupun Airbnb pribadi, transportasi bandara pribadi membuat kedatangan lebih mudah dan nyaman.
            </p>
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Area Seminyak yang Dilayani</p>
            <div class="grid grid-cols-2 gap-3 mb-6">
              {areaSeminyak.map((area) => (
                <div class="bg-brand-cream p-4 text-brand-dark/70 text-sm">{area}</div>
              ))}
            </div>
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Pantai Populer di Sekitar</p>
            <div class="grid grid-cols-2 gap-3">
              {pantaiSeminyak.map((pantai) => (
                <div class="bg-brand-cream p-4 text-brand-dark/70 text-sm">{pantai}</div>
              ))}
            </div>
          </div>
          <div class="space-y-4">
            <img
              src="/images/nusa-penida-viewpoint.jpg"
              alt="Pemandangan pesisir Bali dekat Seminyak"
              class="w-full h-64 object-cover"
              loading="lazy"
            />
            <img
              src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&h=400&fit=crop"
              alt="Beach club Seminyak Bali"
              class="w-full h-48 object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Transfer Pribadi vs Grab/Gojek/Taksi -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Perbandingan</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Transfer Pribadi vs Grab, Gojek, dan Taksi</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Pertanyaan yang sering muncul: lebih baik pakai Grab, Gojek, taksi, atau transfer pribadi dari Bandara Bali ke Seminyak?</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-white p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-4">Transfer Bandara Pribadi</p>
            <p class="font-serif text-xl text-brand-dark mb-4">Terbaik untuk</p>
            <div class="space-y-2 mb-6">
              {['Keluarga', 'Pasangan', 'Wisatawan bulan madu', 'Wisatawan pertama kali ke Bali', 'Wisatawan dengan banyak bagasi', 'Kedatangan malam hari'].map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-3 h-3 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70 text-sm">{item}</span>
                </div>
              ))}
            </div>
            <p class="font-serif text-lg text-brand-dark mb-3">Keunggulan</p>
            <div class="space-y-2">
              {keunggulanTransferPribadi.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-3 h-3 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-white p-8">
            <p class="text-brand-dark/40 text-xs tracking-widest uppercase mb-4">Grab atau Gojek</p>
            <p class="font-serif text-xl text-brand-dark mb-4">Populer di kalangan wisatawan hemat</p>
            <p class="text-brand-dark/50 text-sm mb-4">Kemungkinan kendala:</p>
            <div class="space-y-2">
              {['Kebingungan titik jemput di bandara', 'Surge pricing', 'Pembatalan driver', 'Menunggu saat periode ramai', 'Keterbatasan bagasi'].map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-brand-dark/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-3 h-3 text-brand-dark/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/60 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-white p-8">
            <p class="text-brand-dark/40 text-xs tracking-widest uppercase mb-4">Taksi Bandara</p>
            <p class="font-serif text-xl text-brand-dark mb-4">Tersedia di Bandara Ngurah Rai</p>
            <p class="text-brand-dark/50 text-sm mb-4">Kemungkinan kekurangan:</p>
            <div class="space-y-2">
              {['Antrian', 'Harga bervariasi', 'Pengalaman kurang dapat diprediksi saat ramai'].map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-brand-dark/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-3 h-3 text-brand-dark/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/60 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tentang Seminyak -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Tentang Seminyak</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Mengapa Wisatawan Memilih Seminyak</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Seminyak tetap menjadi salah satu destinasi paling banyak dikunjungi di Bali berkat perpaduan kemewahan, pantai, dan kehidupan sosial yang semarak. Banyak wisatawan memilih Seminyak karena akses mudah ke pantai, restoran, kehidupan malam, dan kawasan wisata terdekat.
            </p>
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Yang Ditawarkan Seminyak</p>
            <div class="grid grid-cols-2 gap-3">
              {['Villa mewah', 'Beach club', 'Kehidupan malam', 'Restoran', 'Pusat perbelanjaan', 'Spa dan wellness', 'Pantai sunset', 'Kuliner yang beragam'].map((item) => (
                <div class="bg-brand-cream p-3 text-brand-dark/70 text-sm">{item}</div>
              ))}
            </div>
          </div>
          <div>
            <img
              src="/images/beach-sunset-swing.jpg"
              alt="Sunset pantai Seminyak Bali"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Mengapa Bali West Transport -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Mengapa Pilih Kami</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Mengapa Memilih Bali West Transport?</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Bali West Transport menyediakan layanan transportasi pribadi di seluruh Bali untuk transfer bandara, transfer hotel, supir pribadi, dan tur Bali yang disesuaikan.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
          {[
            'Supir lokal profesional',
            'Layanan transportasi pribadi',
            'Kendaraan ber-AC yang nyaman',
            'Penjemputan bandara tersedia 24/7',
            'Antar langsung ke hotel dan villa',
            'Pilihan transportasi yang fleksibel',
            'Jangkauan layanan di seluruh Bali'
          ].map((alasan) => (
            <div class="flex items-start gap-4 p-6 bg-white">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{alasan}</span>
            </div>
          ))}
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          <a href="/id/airport-transfer/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Hub Transfer Bandara</span>
          </a>
          <a href="/id/tours/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Tur Pribadi Bali</span>
          </a>
          <a href="/id/about/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Tentang Bali West Transport</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Pertanyaan yang Sering Diajukan</h2>
        </div>
        <div class="space-y-4">
          {faq.map((item) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.pertanyaan}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.jawaban}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 bg-brand-dark text-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12 text-center">
        <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pesan Sekarang</p>
        <h2 class="font-serif text-4xl md:text-5xl mb-6">Pesan Transfer Bandara Ngurah Rai ke Seminyak</h2>
        <p class="text-brand-cream/70 text-lg mb-10 max-w-2xl mx-auto">
          Baik Anda menginap di Petitenget, Batu Belig, Oberoi, atau Double Six, Bali West Transport membantu perjalanan Anda dari Bandara Ngurah Rai ke Seminyak menjadi lebih mudah, aman, dan nyaman.
        </p>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-12 py-5 text-sm tracking-widest uppercase transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Pesan via WhatsApp
        </a>
      </div>
    </section>

    <!-- Rute Terkait -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Rute Transfer Bandara Lainnya</p>
          <h2 class="font-serif text-3xl text-brand-dark">Tujuan Transfer Bandara Bali Lainnya</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {ruteTerkait.map((rute) => (
            <a href={rute.href} class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
              <span class="text-brand-dark font-medium text-sm">{rute.label}</span>
            </a>
          ))}
        </div>
        <div class="mt-6 text-center">
          <a href="/airport-transfer/ngurah-rai-airport-to-seminyak/" class="text-brand-dark/40 hover:text-brand-dark/70 text-sm transition-colors">
            View this page in English
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>
