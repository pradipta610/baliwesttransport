---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';

const pageTitle = 'Gilimanuk to Kuta Transfer — Private Door-to-Door | Bali West Transport';
const pageDescription = 'Book a private transfer from Gilimanuk Ferry Port to Kuta. Door-to-door service, 120–130 km, 3–4 hours. Close to Ngurah Rai Airport. WhatsApp booking available.';
const pageKeywords = 'gilimanuk to kuta transfer, gilimanuk kuta private transfer, gilimanuk ferry port to kuta, transfer from gilimanuk to kuta bali, gilimanuk kuta airport';

const whatsappText = 'Hi, I would like to book a private Gilimanuk to Kuta transfer. Please send me your best offer.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const pickupLocations = [
  'Gilimanuk Ferry Port (Pelabuhan Gilimanuk)',
  'Hotels and guesthouses in Gilimanuk town',
  'Ketapang Port area on the Java side (for pre-arranged, cross-strait itineraries)'
];

const dropoffAreas = [
  'Jl. Legian and the Poppies Lane I & II corridor',
  'Kuta Beach and Jl. Pantai Kuta hotel strip',
  'Kuta Square, Beachwalk, and Discovery Mall area',
  'Tuban (southern Kuta, closest to Ngurah Rai Airport)',
  'Kuta Art Market and surrounding guesthouses'
];

const userTypes = [
  {
    title: 'Travellers Crossing from Java',
    description: 'Arriving via the Ketapang–Gilimanuk ferry from Banyuwangi, Surabaya, or Ijen. A private transfer is the most direct onward option from the harbour, and Kuta is the natural first stop if your next move is a flight out.'
  },
  {
    title: 'First-Time Bali Visitors',
    description: "Kuta is Bali's original tourist strip — familiar, walkable, and close to everything. Most first-time arrivals want a driver they can message directly rather than working out a bus-then-taxi chain on day one."
  },
  {
    title: 'Same-Day and Next-Day Flyers',
    description: 'Kuta sits minutes from Ngurah Rai Airport. If your Java–Bali overland trip ends with a flight home or onward, this is the shortest possible gap between ferry and airport, with one driver handling both legs if needed.'
  },
  {
    title: 'Surf Travellers',
    description: "Kuta Beach is Bali's classic beginner surf break. Board transport is accommodated in larger vehicles — confirm board size and count when booking."
  },
  {
    title: 'Families and Groups on a Budget',
    description: "Kuta's accommodation market is broader and more budget-friendly than Seminyak's villa strip. A private vehicle handles multiple suitcases without the weight restrictions of a shared shuttle, at a price confirmed before you travel."
  }
];

const benefits = [
  {
    title: 'No Connections',
    description: 'Shared transport from Gilimanuk to Kuta requires at least one change at a Denpasar terminal. Private transfer is point-to-point with no intermediate stops unless you request them.'
  },
  {
    title: 'Your Schedule, Not the Bus Schedule',
    description: 'Depart as soon as you step off the ferry — no waiting for a shared vehicle to fill, and no risk of missing a same-day flight because a shuttle ran late.'
  },
  {
    title: 'Door-to-Door to Your Hotel or the Airport',
    description: 'Whether Kuta is your final stop or a stopover before Ngurah Rai, your driver delivers you exactly where you need to be.'
  },
  {
    title: 'Luggage Flexibility',
    description: "Families and long-stay travellers routinely bring more than a shuttle's weight allowance permits. A private vehicle carries what your group brings."
  },
  {
    title: 'WhatsApp-First Booking and Contact',
    description: 'Confirm your journey, share your ferry arrival time, and track your driver — all via WhatsApp before and during the trip. No app to install, no account to create.'
  }
];

const faqs = [
  {
    question: 'How long does the transfer from Gilimanuk to Kuta take?',
    answer: 'Approximately 3 to 4 hours by private vehicle. The drive itself is around 2.5 to 3 hours in clear conditions, but traffic on the Jl. Legian and beach-road approach adds 20–45 minutes, particularly between 16:00 and 19:30. Morning ferry arrivals typically have the fastest journey times.'
  },
  {
    question: 'How far is Gilimanuk from Kuta?',
    answer: 'Approximately 120–130 km by road, following the main western corridor through Negara and Tabanan before joining the Mengwi bypass into Kuta.'
  },
  {
    question: 'Where does the driver meet me at Gilimanuk?',
    answer: 'At Gilimanuk Ferry Port (Pelabuhan Gilimanuk), on the western side of the harbour as you disembark from the Ketapang crossing. Send us your ferry reference and estimated arrival time when booking — we track the crossing and adjust if it runs late.'
  },
  {
    question: 'Is there a direct bus from Gilimanuk to Kuta?',
    answer: 'There is no direct bus. Public buses from Gilimanuk go to a Denpasar terminal (Ubung or Mengwi), where you need a second connection into Kuta. Total travel time including waiting and transfers typically exceeds 5–6 hours. A private transfer is faster and door-to-door.'
  },
  {
    question: 'Is Kuta close to Ngurah Rai Airport?',
    answer: 'Yes. Kuta and its southern district, Tuban, border Ngurah Rai Airport directly — typically 10–15 minutes by road. This makes a Gilimanuk-to-Kuta transfer the practical choice if you\'re connecting from Java to an onward flight.'
  },
  {
    question: 'Can you transport a surfboard from Gilimanuk to Kuta?',
    answer: "Yes. Confirm the number and length of boards when booking so we assign a vehicle with adequate space. Standard MPV fits boards up to around 6'8\" with the rear seat folded; longer boards may need a larger vehicle."
  },
  {
    question: 'Do you offer early morning pickups from the ferry port?',
    answer: 'Yes. We operate around the Ketapang–Gilimanuk ferry schedule, including the earliest morning crossings. Confirm your ferry departure time when booking and we will have your driver ready on arrival.'
  },
  {
    question: 'What is the route from Gilimanuk to Kuta?',
    answer: "Gilimanuk Ferry Port → Jl. Raya Gilimanuk south-east → Negara → Tabanan → Mengwi bypass → Kuta. The route stays on Bali's main western highway for most of the journey before entering the Kuta/airport corridor."
  },
  {
    question: 'Can I make a stop at Tanah Lot on the way to Kuta?',
    answer: 'Yes, on request. Tanah Lot sits close to the main route, roughly 40–50 minutes before Kuta. A planned stop adds to the total journey time — confirm with us when booking so your driver can adjust the schedule.'
  }
];

const relatedRoutes = [
  { label: 'Gilimanuk to Ubud Transfer', href: '/transfers/gilimanuk-to-ubud/' },
  { label: 'Gilimanuk to Canggu Transfer', href: '/transfers/gilimanuk-to-canggu/' },
  { label: 'Gilimanuk to Seminyak Transfer', href: '/transfers/gilimanuk-to-seminyak/' },
  { label: 'All Gilimanuk Transfers', href: '/transfers/' },
  { label: 'Airport Transfer', href: '/airport-transfer/' },
  { label: 'All Transfer Routes', href: '/transfers/' }
];

const pageUrl = 'https://baliwesttransport.com/transfers/gilimanuk-to-kuta/';
const organizationId = `${pageUrl}#organization`;
const travelAgencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://baliwesttransport.com/logo.png'
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Customer Service',
        availableLanguage: ['English', 'Indonesian'],
        url: 'https://wa.me/6282247648944'
      },
      areaServed: {
        '@type': 'Place',
        name: 'Bali, Indonesia'
      }
    },
    {
      '@type': 'TravelAgency',
      '@id': travelAgencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      parentOrganization: {
        '@id': organizationId
      },
      areaServed: {
        '@type': 'Place',
        name: 'Bali, Indonesia'
      }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Gilimanuk to Kuta Private Transfer',
      description: 'Private door-to-door transfer from Gilimanuk Ferry Port to Kuta, Bali. Driver meets you at the harbour. Journey approximately 120–130 km, 3–4 hours depending on traffic. Close to Ngurah Rai Airport.',
      provider: {
        '@id': travelAgencyId
      },
      serviceType: 'Private ferry port transfer',
      areaServed: [
        {
          '@type': 'Place',
          name: 'Gilimanuk, Jembrana, Bali, Indonesia'
        },
        {
          '@type': 'Place',
          name: 'Kuta, Badung, Bali, Indonesia'
        }
      ],
      audience: {
        '@type': 'Audience',
        audienceType: 'Travelers arriving via Ketapang-Gilimanuk ferry, connecting to Kuta or Ngurah Rai Airport'
      },
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: 'https://wa.me/6282247648944',
        servicePhone: '+6282247648944',
        availableLanguage: ['English', 'Indonesian']
      },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
        seller: {
          '@id': travelAgencyId
        }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://baliwesttransport.com/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Transfers',
          item: 'https://baliwesttransport.com/transfers/'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Gilimanuk to Kuta Transfer',
          item: pageUrl
        }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'en',
      about: {
        '@id': serviceId
      },
      mainEntity: [
        { '@id': serviceId },
        { '@id': faqId }
      ],
      breadcrumb: {
        '@id': breadcrumbId
      },
      publisher: {
        '@id': organizationId
      },
      datePublished: '2026-07-05',
      dateModified: '2026-07-05'
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/kelingking-beach.jpg"
          alt="Private transfer from Gilimanuk to Kuta Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Private Transfer — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Private Transfer Gilimanuk to Kuta</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Door-to-Door from the Ferry Port
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Book Your Transfer
          </a>
          <a href="/transfers/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">View All Transfers</a>
        </div>
      </div>
    </section>

    <!-- Quick Answer Block -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Quick Answer</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Private Transfer from Gilimanuk to Kuta</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Book a private transfer from Gilimanuk to Kuta with Bali West Transport. Your driver meets you directly at Gilimanuk Ferry Port when you step off the crossing from Java. The journey covers approximately 120–130 km and takes 3 to 4 hours by private vehicle, depending on traffic approaching Kuta. Door-to-door service to any hotel, guesthouse, or villa in Kuta — and Kuta is Bali's closest tourist area to Ngurah Rai Airport, so this is also the transfer of choice if you're flying out shortly after arriving.
            </p>
          </div>
          <div class="space-y-4">
            <img src="/images/nusa-penida-viewpoint.jpg" alt="Scenic Bali landscape on the way to Kuta" class="w-full h-auto" loading="lazy" />
            <div class="grid grid-cols-2 gap-4">
              <img src="/images/beach-sunset-swing.jpg" alt="Bali beach sunset" class="w-full h-48 object-cover" loading="lazy" />
              <img src="https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=400&h=300&fit=crop" alt="Bali rice terraces" class="w-full h-48 object-cover" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Route Overview Card -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Route</p>
              <p class="font-serif text-2xl text-brand-dark">Gilimanuk to Kuta</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Distance</p>
              <p class="font-serif text-2xl text-brand-dark">120–130 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Time</p>
              <p class="font-serif text-2xl text-brand-dark">3–4 hrs</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Flexible Offer</span>
              <p class="text-brand-dark/50 text-sm mt-1">Tell us your date & group size.</p>
            </div>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap">Ask Best Offer</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose This Transfer -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Why Choose This Transfer</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Why a Private Transfer from Gilimanuk to Kuta?</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Arriving at Gilimanuk after the Ketapang–Gilimanuk ferry crossing leaves you at the far western tip of Bali, with no direct public transport into Kuta. Shared shuttles require a connection at Ubung or Mengwi terminal in Denpasar, and from there you still need a separate taxi or ride-share to reach your hotel — adding cost, waiting time, and a second round of negotiation to an already long day.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              A private transfer removes all three problems at once. Your driver is waiting at the port when you step off the ferry, your luggage goes straight into the vehicle, and you go directly to your accommodation — or straight to the airport, if Kuta is a same-day stopover before a flight.
            </p>
          </div>
          <div>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Kuta sits roughly 120–130 km south-east of Gilimanuk on Bali's south coast, slightly closer than Seminyak since the route doesn't continue further up the coast. The drive follows the island's main western corridor through Negara and Tabanan before joining the Mengwi bypass into the Kuta/airport area.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Traffic on the final approach — particularly along Jl. Raya Kuta and Jl. Legian near sunset, and around the airport roundabout during flight peaks — can add 20–45 minutes. A driver who knows Kuta's one-way beach-road network makes a real difference on that last stretch.
            </p>
            <div class="bg-brand-cream p-6 mt-4">
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Traffic Risk</p>
              <p class="text-brand-dark/70 text-sm">High: Jl. Legian and the Kuta beach-road corridor, especially 16:00–19:30</p>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2 mt-4">Best Departure</p>
              <p class="text-brand-dark/70 text-sm">Morning ferry arrivals (06:00–10:00) reach Kuta before afternoon congestion builds</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Compare Your Options -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Compare Your Options</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Private Transfer vs. Public Bus vs. On-Arrival Taxi</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full bg-white border border-brand-dark/10">
            <thead>
              <tr class="border-b border-brand-dark/10">
                <th class="p-4 text-left text-brand-dark/40 text-xs uppercase tracking-widest"></th>
                <th class="p-4 text-left text-brand-dark font-serif text-lg">Private Transfer<br/><span class="text-brand-gold text-xs uppercase tracking-widest font-sans">Bali West Transport</span></th>
                <th class="p-4 text-left text-brand-dark/70 font-serif text-lg">Public Bus via Denpasar</th>
                <th class="p-4 text-left text-brand-dark/70 font-serif text-lg">On-Arrival Taxi / Ride-share</th>
              </tr>
            </thead>
            <tbody class="text-brand-dark/70">
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Total time</td>
                <td class="p-4 font-medium text-brand-dark">3–4 hrs, direct</td>
                <td class="p-4">5–6+ hrs, with terminal transfer</td>
                <td class="p-4">Unpredictable — no fixed pickup at port</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Driver at ferry port</td>
                <td class="p-4 font-medium text-brand-dark">Yes, tracked to your crossing</td>
                <td class="p-4">No</td>
                <td class="p-4">No — you queue and negotiate on arrival</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Price known before travel</td>
                <td class="p-4 font-medium text-brand-dark">Yes, fixed offer confirmed on WhatsApp</td>
                <td class="p-4">Ticket price only; taxi leg still unknown</td>
                <td class="p-4">No — negotiated on the spot</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Drop-off point</td>
                <td class="p-4 font-medium text-brand-dark">Your exact hotel/villa door</td>
                <td class="p-4">Denpasar terminal, then a second ride</td>
                <td class="p-4">Depends on driver, often not door-to-door</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Luggage handling</td>
                <td class="p-4 font-medium text-brand-dark">Unlimited within vehicle capacity</td>
                <td class="p-4">Shuttle weight limits apply</td>
                <td class="p-4">Variable, driver's discretion</td>
              </tr>
              <tr>
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Booking method</td>
                <td class="p-4 font-medium text-brand-dark">WhatsApp, confirmed within minutes</td>
                <td class="p-4">Buy ticket at terminal</td>
                <td class="p-4">None — arrange after you land</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Pickup & Drop-off -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pickup</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Pickup at Gilimanuk Ferry Port</h2>
            <p class="text-brand-dark/70 mb-6">Your driver meets you at <strong>Gilimanuk Ferry Port (Pelabuhan Gilimanuk)</strong>, on the western side of the harbour as you disembark. Send us your estimated arrival time and ferry booking reference when you book — we track the crossing and adjust for delays so you're never left waiting.</p>
            <p class="text-brand-dark/70 mb-6">Additional pickup is available from:</p>
            <div class="space-y-3 mb-6">
              {pickupLocations.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
          </div>
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Drop-off</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Drop-off Locations in Kuta</h2>
            <p class="text-brand-dark/70 mb-6">Door-to-door delivery to any address in Kuta, including:</p>
            <div class="space-y-3 mb-8">
              {dropoffAreas.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <p class="text-brand-dark/50 text-sm">If your drop-off is on a narrow gang (lane) behind the main beach road, confirm the exact address when booking — our drivers know Kuta's back-lane network and will find the right entrance.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Uses This Transfer -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Who Uses This Transfer</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Popular with First-Timers, Surfers, Families, and Same-Day Flyers</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {userTypes.map((item) => (
            <div class="bg-white p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.title}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Journey Overview -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Journey Overview</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">The Route from Gilimanuk to Kuta</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              The drive from Gilimanuk to Kuta follows Bali's main west-coast highway for most of its length. After leaving the harbour, the route heads south-east through the flat rice-field plains of Jembrana Regency, passing through Negara — the regional capital and a natural rest stop — before continuing into Tabanan Regency.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              From Tabanan the road joins the Mengwi bypass, which feeds directly into the Kuta/airport corridor without needing to continue further up the coast toward Seminyak. Traffic builds progressively from Mengwi onward, and the final kilometres along Jl. Raya Kuta and into the Legian/beach-road grid are the busiest stretch of the journey, especially close to sunset.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Your driver will use local route knowledge on the final approach to manage traffic. If you need a comfort stop, Negara is the best point — approximately halfway, with reliable rest-stop options and fuel available.
            </p>
          </div>
          <div>
            <img
              src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&h=600&fit=crop"
              alt="Scenic Bali landscape along the Gilimanuk to Kuta route"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits of Private Transfer -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Private Transfer Benefits</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Choose a Private Transfer?</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {benefits.map((item) => (
            <div class="bg-white p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.title}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Frequently Asked Questions</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{faq.question}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-dark p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="font-serif text-2xl text-brand-cream mb-2">Ready to book? Send us your ferry details on WhatsApp.</h3>
            <p class="text-brand-cream/60">Include your arrival date, estimated time at Gilimanuk, and number of passengers. We'll confirm your driver and vehicle within minutes.</p>
          </div>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Book on WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Related Gilimanuk Transfers -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Other Gilimanuk Transfer Routes</p>
          <h2 class="font-serif text-3xl text-brand-dark">Travelling to a Different Part of Bali?</h2>
          <p class="text-brand-dark/60 mt-4">View all available routes from the ferry port.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {relatedRoutes.map((route) => (
            <a href={route.href} class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
              <span class="text-brand-dark font-medium text-sm">{route.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Explore More -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Explore More</p>
          <h2 class="font-serif text-3xl text-brand-dark">More from Bali West Transport</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-4">
          <a href="/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Home</span>
          </a>
          <a href="/airport-transfer/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Airport Transfer</span>
          </a>
          <a href="/tours/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Private Tours</span>
          </a>
          <a href="/about/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">About Us</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>
