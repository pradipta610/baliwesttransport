                <th class="text-left px-6 py-4 font-medium tracking-wide">Estimated Travel Time</th>
              </tr>
            </thead>
            <tbody>
              {routeTable.map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-brand-cream' : 'bg-white'}>
                  <td class="px-6 py-4 text-brand-dark font-medium">{row.route}</td>
                  <td class="px-6 py-4 text-brand-dark/70">{row.distance}</td>
                  <td class="px-6 py-4 text-brand-dark/70">{row.time}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-brand-dark/50 text-sm mt-4">Travel times are estimates and may vary depending on traffic conditions and time of day.</p>
      </div>
    </section>

    <!-- Meet and Greet -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Airport Pickup</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Meet and Greet at Bali Airport</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Upon arrival at Ngurah Rai Airport, your driver will meet you after baggage collection with a name board. The driver will assist with luggage and escort you to your vehicle before beginning the journey to Uluwatu.
            </p>
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">This Service Is Especially Useful For</p>
            <div class="grid grid-cols-2 gap-3">
              {[
                'First-time visitors to Bali',
                'Families with children',
                'Groups with multiple bags',
                'Surf travellers with boards',
                'Late-night arrivals',
                'Early-morning flights'
              ].map((item) => (
                <div class="bg-white p-4 text-brand-dark/70 text-sm">{item}</div>
              ))}
            </div>
          </div>
          <div>
            <img
              src="/images/beach-sunset-swing.jpg"
              alt="Uluwatu Bali sunset beach transfer"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Why Bali West Transport -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Why Choose Us</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Choose Bali West Transport?</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Bali West Transport provides private transportation services across Bali for airport transfers, hotel transfers, private drivers, and customised Bali tours.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
          {[
            'Professional local drivers',
            'Private transportation service',
            'Comfortable air-conditioned vehicles',
            'Airport pickup available 24/7',
            'Direct hotel and villa transfer',
            'Flight monitoring for delayed arrivals',
            'Service coverage throughout Bali'
          ].map((reason) => (
            <div class="flex items-start gap-4 p-6 bg-brand-cream">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{reason}</span>
            </div>
          ))}
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          <a href="/airport-transfer/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Airport Transfer Hub</span>
          </a>
          <a href="/tours/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Private Bali Tours</span>
          </a>
          <a href="/about/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">About Bali West Transport</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Frequently Asked Questions</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="bg-white p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{faq.question}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 bg-brand-dark text-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12 text-center">
        <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Book Now</p>
        <h2 class="font-serif text-4xl md:text-5xl mb-6">Book Your Ngurah Rai Airport to Uluwatu Transfer</h2>
        <p class="text-brand-cream/70 text-lg mb-10 max-w-2xl mx-auto">
          Whether you are staying in Pecatu, Bingin, Padang Padang, Suluban, or Balangan, Bali West Transport provides comfortable and reliable private airport transfers from Ngurah Rai Airport directly to your accommodation.
        </p>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-12 py-5 text-sm tracking-widest uppercase transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Book Via WhatsApp
        </a>
      </div>
    </section>

    <!-- Related Routes -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Related Airport Transfer Routes</p>
          <h2 class="font-serif text-3xl text-brand-dark">Other Bali Airport Transfer Destinations</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {relatedRoutes.map((route) => (
            <a href={route.href} class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
              <span class="text-brand-dark font-medium text-sm">{route.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>

