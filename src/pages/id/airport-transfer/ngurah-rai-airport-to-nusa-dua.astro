---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppFloat from '../../../components/WhatsAppFloat.astro';

const pageTitle = 'Transfer Bandara Ngurah Rai ke Nusa Dua | Antar Jemput Bandara Pribadi Bali';
const pageDescription = 'Pesan transfer pribadi dari Bandara Ngurah Rai ke Nusa Dua — salah satu rute bandara tercepat di Bali lewat Tol Bali Mandara, antar langsung ke resort, Tanjung Benoa, dan Peninsula Island.';
const pageKeywords = 'transfer bandara ngurah rai ke nusa dua, bandara bali ke nusa dua, antar jemput bandara nusa dua, transfer bandara pribadi nusa dua, bandara DPS ke nusa dua, jemput bandara nusa dua bali, bali west transport';

const whatsappText = 'Halo, saya ingin memesan transfer dari Bandara Ngurah Rai ke Nusa Dua. Mohon informasi penawaran terbaik Anda.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const keunggulan = [
  'Supir menunggu di area kedatangan dengan papan nama',
  'Salah satu rute bandara tercepat di Bali lewat Tol Bali Mandara',
  'Antar langsung ke resort, hotel, dan villa di seluruh Nusa Dua',
  'Kendaraan pribadi ber-AC yang nyaman',
  'Bantuan pengangkatan bagasi termasuk',
  'Pemantauan penerbangan — penjemputan disesuaikan jika penerbangan terlambat',
  'Penjemputan bandara tersedia 24 jam',
  'Cocok untuk keluarga, pasangan, dan wisatawan bisnis atau konferensi'
];

const areaNusaDua = [
  'Kawasan Resort Nusa Dua',
  'Tanjung Benoa',
  'Bualu',
  'Peninsula Island (Sawangan)',
  'Pantai Geger',
  'Area Konvensi BNDCC'
];

const atraksiNusaDua = [
  'Water Blow',
  'Pantai Nusa Dua',
  'Pantai Geger',
  'Bali Collection Shopping Centre',
  'Watersport Tanjung Benoa',
  'Devdan Show'
];

const tabelRute = [
  { rute: 'Bandara Bali ke Kawasan Resort Nusa Dua', jarak: '10–13 km', waktu: '20–30 mnt' },
  { rute: 'Bandara Bali ke Tanjung Benoa', jarak: '13–16 km', waktu: '25–35 mnt' },
  { rute: 'Bandara Bali ke Bualu', jarak: '10–13 km', waktu: '20–30 mnt' },
  { rute: 'Bandara Bali ke Peninsula Island', jarak: '12–15 km', waktu: '25–35 mnt' },
  { rute: 'Bandara Bali ke Pantai Geger', jarak: '11–14 km', waktu: '22–32 mnt' },
];

const faq = [
  {
    pertanyaan: 'Berapa jauh Nusa Dua dari Bandara Bali?',
    jawaban: 'Nusa Dua berjarak sekitar 10 hingga 15 kilometer dari Bandara Internasional I Gusti Ngurah Rai, menjadikannya salah satu kawasan resort terdekat dari bandara.'
  },
  {
    pertanyaan: 'Berapa lama perjalanan dari Bandara Bali ke Nusa Dua?',
    jawaban: 'Perjalanan biasanya memakan waktu 20 hingga 35 menit dalam kondisi lalu lintas normal, dan bisa mencapai sekitar 55 menit pada jam sibuk. Nusa Dua adalah salah satu transfer bandara tercepat di Bali berkat Tol Bali Mandara yang menghubungkan langsung bandara ke semenanjung.'
  },
  {
    pertanyaan: 'Apa cara terbaik dari Bandara Ngurah Rai ke Nusa Dua?',
    jawaban: 'Transfer bandara pribadi adalah salah satu pilihan paling nyaman karena menyediakan supir yang menunggu di area kedatangan, bantuan bagasi, dan antar langsung ke resort atau hotel tanpa perlu antri taksi atau tawar-menawar harga.'
  },
  {
    pertanyaan: 'Bisakah saya naik Grab atau Gojek dari Bandara Ngurah Rai ke Nusa Dua?',
    jawaban: 'Aplikasi ride-hailing dapat dipesan dari bandara, namun penjemputan sering dibatasi ke area tertentu yang jauh dari pintu kedatangan, dan ketersediaannya bisa terbatas saat jam sibuk. Transfer pribadi yang sudah dipesan sebelumnya menghindari hal ini, karena supir sudah menunggu langsung di area kedatangan.'
  },
  {
    pertanyaan: 'Apakah tersedia transfer ke Tanjung Benoa dan Peninsula Island?',
    jawaban: 'Ya. Transfer bandara tersedia ke seluruh kawasan Nusa Dua termasuk Tanjung Benoa, Bualu, Peninsula Island (Sawangan), dan Pantai Geger.'
  },
  {
    pertanyaan: 'Apakah Nusa Dua cocok untuk wisatawan bisnis dan konferensi?',
    jawaban: 'Ya. Nusa Dua adalah kawasan resort dan konferensi utama di Bali, rumah bagi Bali Nusa Dua Convention Center dan jaringan resort internasional besar, sehingga menjadi tujuan umum bagi pelaku bisnis dengan jadwal yang padat.'
  },
  {
    pertanyaan: 'Bisakah memesan transfer bandara sebelum tiba di Bali?',
    jawaban: 'Ya. Pemesanan lebih awal sangat dianjurkan, terutama pada periode liburan dan konferensi yang padat, untuk memastikan supir sudah siap dan terkonfirmasi saat Anda mendarat.'
  }
];

const ruteTerkait = [
  { label: 'Hub Transfer Bandara', href: '/id/airport-transfer/' },
  { label: 'Bandara ke Kuta', href: '/id/airport-transfer/ngurah-rai-airport-to-kuta/' },
  { label: 'Bandara ke Uluwatu', href: '/id/airport-transfer/ngurah-rai-airport-to-uluwatu/' },
  { label: 'Bandara ke Sanur', href: '/id/airport-transfer/ngurah-rai-airport-to-sanur/' },
  { label: 'Bandara ke Seminyak', href: '/id/airport-transfer/ngurah-rai-airport-to-seminyak/' },
  { label: 'Gilimanuk ke Nusa Dua', href: '/id/transfers/gilimanuk-to-nusa-dua/' },
  { label: 'Semua Transfer Bali', href: '/id/transfers/' }
];

const pageUrl = 'https://baliwesttransport.com/id/airport-transfer/ngurah-rai-airport-to-nusa-dua/';
const orgId = `${pageUrl}#organization`;
const agencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      address: { '@type': 'PostalAddress', addressLocality: 'Bali', addressCountry: 'ID' }
    },
    {
      '@type': 'TravelAgency',
      '@id': agencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: { '@type': 'AdministrativeArea', name: 'Bali, Indonesia' },
      parentOrganization: { '@id': orgId }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Transfer Bandara Ngurah Rai ke Nusa Dua',
      alternateName: 'Ngurah Rai Airport to Nusa Dua Transfer',
      description: pageDescription,
      serviceType: 'Transfer Bandara Pribadi',
      provider: { '@id': agencyId },
      availableLanguage: [{ '@type': 'Language', name: 'Indonesian' }, { '@type': 'Language', name: 'English' }],
      areaServed: [
        { '@type': 'Place', name: 'Bandara Ngurah Rai Internasional' },
        { '@type': 'Place', name: 'Nusa Dua' },
        { '@type': 'Place', name: 'Tanjung Benoa' },
        { '@type': 'Place', name: 'Bualu' },
        { '@type': 'Place', name: 'Peninsula Island' },
        { '@type': 'Place', name: 'Pantai Geger' },
        { '@type': 'AdministrativeArea', name: 'Bali' }
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: { '@type': 'ContactPoint', telephone: '+6282247648944', contactType: 'customer service' }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.pertanyaan,
        acceptedAnswer: { '@type': 'Answer', text: item.jawaban }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://baliwesttransport.com/id/' },
        { '@type': 'ListItem', position: 2, name: 'Transfer Bandara', item: 'https://baliwesttransport.com/id/airport-transfer/' },
        { '@type': 'ListItem', position: 3, name: 'Transfer Bandara Ngurah Rai ke Nusa Dua', item: pageUrl }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id',
      isPartOf: { '@id': orgId },
      about: { '@id': serviceId },
      mainEntity: [{ '@id': serviceId }, { '@id': faqId }],
      breadcrumb: { '@id': breadcrumbId },
      publisher: { '@id': orgId }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/beach-sunset-swing.jpg"
          alt="Transfer pribadi dari Bandara Ngurah Rai ke Nusa Dua Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Antar Jemput Bandara Pribadi — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Transfer Bandara Ngurah Rai ke Nusa Dua</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Antar jemput door-to-door dari Bandara Bali ke Nusa Dua — melayani Tanjung Benoa, Bualu, Peninsula Island, dan Pantai Geger.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan Transfer Sekarang
          </a>
          <a href="/id/airport-transfer/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Hub Transfer Bandara</a>
        </div>
      </div>
    </section>

    <!-- Intro + Info Cepat -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Antar Jemput Bandara Pribadi</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Transfer Pribadi dari Bandara Bali ke Nusa Dua</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Pesan transfer dari Bandara Ngurah Rai ke Nusa Dua bersama Bali West Transport. Perjalanan memakan waktu sekitar 20 hingga 35 menit tergantung lalu lintas, dengan layanan door-to-door yang nyaman untuk wisatawan yang tiba di Bandara Internasional I Gusti Ngurah Rai (DPS).
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Nusa Dua adalah salah satu kawasan resort utama di Bali, dikenal dengan area resort yang tertata rapi, pantai yang tenang untuk berenang, hotel bintang lima internasional, dan Bali Nusa Dua Convention Center. Transfer bandara yang sudah dipesan sebelumnya memungkinkan wisatawan menghindari antrian taksi, tawar-menawar harga, dan ketidakpastian transportasi setelah mendarat — dan karena Nusa Dua terletak tepat di jalur Tol Bali Mandara, ini menjadi salah satu kawasan resort tercepat untuk dijangkau dari bandara.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Baik Anda datang untuk liburan keluarga di pantai, bulan madu, pernikahan, atau konferensi bisnis, memesan transfer bandara pribadi adalah salah satu cara paling nyaman untuk langsung menuju Nusa Dua dari Bandara Bali.
            </p>
          </div>
          <div class="bg-white p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-6">Informasi Cepat</p>
            <div class="space-y-4">
              {[
                ['Layanan', 'Transfer Bandara Bali ke Nusa Dua'],
                ['Lokasi Jemput', 'Bandara Ngurah Rai Internasional (DPS)'],
                ['Tujuan', 'Nusa Dua, Bali (Bukit Peninsula)'],
                ['Jenis Kendaraan', 'Mobil Pribadi dengan Supir'],
                ['Estimasi Waktu Tempuh', '20–35 Menit'],
                ['Ketersediaan', '24 Jam'],
                ['Armada', 'Kendaraan Pribadi Ber-AC'],
                ['Jenis Layanan', 'Jemput Bandara & Antar ke Hotel'],
                ['Penyedia', 'Bali West Transport'],
              ].map(([label, value]) => (
                <div class="flex justify-between gap-4 border-b border-brand-dark/10 pb-4">
                  <span class="text-brand-dark/50 text-sm">{label}</span>
                  <span class="text-brand-dark font-medium text-sm text-right">{value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ringkasan Rute -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-cream p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Rute</p>
              <p class="font-serif text-2xl text-brand-dark">DPS → Nusa Dua</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Jarak</p>
              <p class="font-serif text-2xl text-brand-dark">10–15 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Waktu</p>
              <p class="font-serif text-2xl text-brand-dark">20–35 mnt</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Penawaran Fleksibel</span>
              <p class="text-brand-dark/50 text-sm mt-1">Informasikan tanggal & jumlah penumpang.</p>
            </div>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
            >
              Minta Penawaran Terbaik
            </a>
          </div>
        </div>
        <div class="mt-6 bg-brand-cream p-6">
          <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Estimasi Waktu Tempuh</p>
          <div class="grid grid-cols-3 gap-3">
            {[
              'Dini hari: 15–20 mnt',
              'Lalu lintas normal: 25–35 mnt',
              'Jam sibuk: 40–55 mnt'
            ].map((item) => (
              <div class="bg-white p-3 text-brand-dark/70 text-sm text-center">{item}</div>
            ))}
          </div>
          <p class="text-brand-dark/50 text-sm mt-4">Nusa Dua diuntungkan oleh Tol Bali Mandara yang terhubung langsung dari bandara — kemacetan lebih jarang terjadi di sini dibanding rute menuju Kuta, Seminyak, atau Canggu. Kedatangan malam saat musim konferensi di BNDCC bisa mengalami sedikit antrean tambahan di gerbang masuk resort.</p>
        </div>
      </div>
    </section>

    <!-- Mengapa Pilih Transfer Pribadi -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Cara Terbaik Menuju Nusa Dua</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Mengapa Pilih Transfer Bandara Pribadi ke Nusa Dua</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Bagi kebanyakan wisatawan, transfer bandara pribadi adalah cara paling nyaman menuju Nusa Dua karena menyediakan jemput di bandara, kesepakatan tetap, dan antar langsung ke hotel atau resort.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {keunggulan.map((item) => (
            <div class="flex items-start gap-4 p-6 bg-white">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Area Nusa Dua yang Dilayani -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jangkauan Pengantaran</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Transfer Bandara ke Semua Area Nusa Dua</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Bali West Transport menyediakan transfer bandara ke seluruh semenanjung Nusa Dua. Baik Anda menginap di resort tepi pantai, villa di Bualu, apartemen di Peninsula Island, maupun menghadiri konferensi dekat BNDCC, kami melayani semua area utama.
            </p>
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Area Nusa Dua yang Dilayani</p>
            <div class="grid grid-cols-2 gap-3 mb-6">
              {areaNusaDua.map((area) => (
                <div class="bg-brand-cream p-4 text-brand-dark/70 text-sm">{area}</div>
              ))}
            </div>
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Atraksi Populer di Sekitar</p>
            <div class="grid grid-cols-2 gap-3">
              {atraksiNusaDua.map((atraksi) => (
                <div class="bg-brand-cream p-4 text-brand-dark/70 text-sm">{atraksi}</div>
              ))}
            </div>
          </div>
          <div class="space-y-4">
            <img
              src="/images/nusa-penida-viewpoint.jpg"
              alt="Transfer bandara ke Nusa Dua Bali kawasan resort"
              class="w-full h-64 object-cover"
              loading="lazy"
            />
            <img
              src="/images/kelingking-beach.jpg"
              alt="Pantai dan kawasan resort Nusa Dua Bali"
              class="w-full h-48 object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Perbandingan Pilihan Transportasi -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Perbandingan</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Cara dari Bandara Bali ke Nusa Dua</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Tersedia beberapa pilihan transportasi dari Bandara Ngurah Rai ke Nusa Dua. Berikut perbandingannya untuk membantu Anda memilih.</p>
        </div>
        <div class="grid md:grid-cols-4 gap-4 mb-12">
          {[
            { jenis: 'Transfer Bandara Pribadi', cocok: 'Keluarga, pasangan, wisatawan bisnis, rombongan', bagasi: 'Ya', langsung: 'Ya' },
            { jenis: 'Taksi Bandara', cocok: 'Perjalanan fleksibel', bagasi: 'Ya', langsung: 'Ya' },
            { jenis: 'Ride-Hailing (Grab/Gojek)', cocok: 'Wisatawan hemat', bagasi: 'Terbatas', langsung: 'Ya' },
            { jenis: 'Sewa Motor', cocok: 'Wisatawan solo', bagasi: 'Sangat terbatas', langsung: 'Ya' },
          ].map((opt) => (
            <div class="bg-white p-6">
              <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">{opt.jenis}</p>
              <div class="space-y-3 text-sm">
                <div>
                  <span class="text-brand-dark/40 block text-xs mb-1">Cocok Untuk</span>
                  <span class="text-brand-dark/70">{opt.cocok}</span>
                </div>
                <div>
                  <span class="text-brand-dark/40 block text-xs mb-1">Ramah Bagasi</span>
                  <span class="text-brand-dark/70">{opt.bagasi}</span>
                </div>
                <div>
                  <span class="text-brand-dark/40 block text-xs mb-1">Transfer Langsung</span>
                  <span class="text-brand-dark/70">{opt.langsung}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
        <p class="text-brand-dark/60 text-sm text-center">Wisatawan yang bepergian bersama keluarga, rombongan pernikahan, banyak koper, atau dengan jadwal konferensi yang ketat umumnya lebih memilih transfer bandara pribadi demi kenyamanan dan kepastian.</p>
