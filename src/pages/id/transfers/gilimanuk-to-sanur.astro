---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppFloat from '../../../components/WhatsAppFloat.astro';

const pageTitle = 'Transfer Gilimanuk ke Sanur — Antar Jemput Pribadi Door-to-Door | Bali West Transport';
const pageDescription = 'Transfer pribadi dari Pelabuhan Gilimanuk ke Sanur Bali. Door-to-door, 130–140 km, 4–4,5 jam. Disesuaikan dengan jadwal fast boat Nusa Penida/Lembongan. Booking via WhatsApp.';
const pageKeywords = 'transfer gilimanuk ke sanur, antar jemput gilimanuk sanur, transfer pribadi gilimanuk sanur, pelabuhan gilimanuk ke sanur, gilimanuk sanur pelabuhan, sanur fast boat nusa penida';

const whatsappText = 'Halo, saya ingin memesan transfer pribadi Gilimanuk ke Sanur. Mohon kirimkan penawaran terbaik.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const pickupLocations = [
  'Pelabuhan Gilimanuk (Pelabuhan Penyeberangan)',
  'Hotel dan penginapan di kota Gilimanuk',
  'Area Pelabuhan Ketapang di sisi Jawa (untuk perjalanan lintas selat yang sudah diatur sebelumnya)'
];

const dropoffAreas = [
  'Pantai Sanur dan jalur hotel Jl. Danau Tamblingan',
  'Pelabuhan Sanur (terminal fast boat ke Nusa Penida, Lembongan, dan Kepulauan Gili)',
  'Pantai Mertasari dan Pantai Segara Ayu',
  'Renon (kawasan pemerintahan/residensial Denpasar, populer untuk wisatawan jangka panjang)'
];

const harbourFacts = [
  { fact: 'Jam operasional', detail: '06:00–18:00 setiap hari (tutup saat Nyepi)' },
  { fact: 'Waktu tempuh ke Nusa Penida / Lembongan', detail: 'Sekitar 30–45 menit' },
  { fact: 'Waktu tempuh ke Kepulauan Gili', detail: 'Sekitar 3 jam' },
  { fact: 'Keberangkatan paling awal', detail: 'Sekitar 06:30' },
  { fact: 'Keberangkatan terakhir (Nusa Penida / Lembongan)', detail: 'Sekitar 17:00' },
  { fact: 'Check-in yang disarankan', detail: '45–60 menit sebelum keberangkatan' }
];

const userTypes = [
  {
    title: 'Wisatawan Menuju Nusa Penida, Lembongan & Gili',
    description: 'Kelompok terbesar di rute ini. Menyeberang dari Jawa, melewati Gilimanuk, langsung ke Pelabuhan Sanur untuk fast boat di hari yang sama atau pagi berikutnya — beritahu kami jadwal boat Anda dan kami atur penjemputan sesuai.'
  },
  {
    title: 'Wisatawan dari Jawa',
    description: 'Tiba melalui feri Ketapang–Gilimanuk dari Banyuwangi, Surabaya, atau Ijen, dengan Sanur sebagai tujuan akhir atau batu loncatan ke pulau-pulau.'
  },
  {
    title: 'Keluarga dan Wisatawan Jangka Panjang',
    description: 'Sanur lebih tenang dari Kuta atau Seminyak, dengan promenade pantai yang mudah dijalan kaki dan suasana lebih residensial — pilihan umum untuk keluarga dan wisatawan yang tinggal beberapa minggu.'
  },
  {
    title: 'Pensiunan dan Wisatawan Berulang',
    description: 'Sanur sudah lama populer di kalangan wisatawan jangka panjang dan yang lebih tua yang menginginkan tempat santai tanpa kebisingan kehidupan malam. Transfer pribadi tanpa pergantian terminal dan tanpa mengantri semakin penting untuk kelompok ini.'
  }
];

const benefits = [
  {
    title: 'Tanpa Pindah Kendaraan',
    description: 'Transportasi umum dari Gilimanuk ke Sanur memerlukan minimal satu kali pindah di terminal Denpasar, ditambah taksi lanjutan. Transfer pribadi langsung tanpa perantara.'
  },
  {
    title: 'Disesuaikan dengan Jadwal Boat Anda',
    description: 'Jika Anda mengejar fast boat dari Pelabuhan Sanur, waktu penjemputan dibangun berdasarkan jadwal keberangkatan boat Anda — bukan sebaliknya.'
  },
  {
    title: 'Door-to-Door ke Hotel atau Pelabuhan',
    description: 'Baik Sanur adalah tujuan akhir atau batu loncatan ke pulau-pulau, sopir mengantar tepat ke tempat yang Anda tuju.'
  },
  {
    title: 'Fleksibilitas Bagasi',
    description: 'Wisatawan jangka panjang dan island-hopping sering membawa lebih dari batas berat shuttle. Kendaraan pribadi membawa semua barang bawaan rombongan Anda.'
  },
  {
    title: 'Booking dan Kontak via WhatsApp',
    description: 'Konfirmasi detail feri, bagikan jadwal fast boat, dan hubungi sopir — semua melalui WhatsApp, tanpa perlu install aplikasi atau buat akun.'
  }
];

const faqs = [
  {
    question: 'Berapa lama transfer dari Gilimanuk ke Sanur?',
    answer: 'Sekitar 4 hingga 4,5 jam dengan kendaraan pribadi. Ini adalah rute Gilimanuk standar terpanjang kami, karena Sanur terletak di pantai timur Bali, di sisi jauh Denpasar dari pelabuhan feri.'
  },
  {
    question: 'Berapa jarak Gilimanuk ke Sanur?',
    answer: 'Sekitar 130–140 km melalui jalan darat, melewati koridor barat utama melalui Negara dan Tabanan sebelum melanjutkan melewati Denpasar menuju pantai timur.'
  },
  {
    question: 'Bisakah penjemputan disesuaikan dengan jadwal fast boat dari Pelabuhan Sanur?',
    answer: 'Bisa. Beritahu kami jadwal fast boat dan operator saat booking, dan kami mengatur waktu penjemputan di Gilimanuk mundur dari jadwal keberangkatan tersebut, dengan buffer untuk check-in 45–60 menit yang disarankan.'
  },
  {
    question: 'Jam berapa Pelabuhan Sanur beroperasi?',
    answer: 'Pelabuhan Sanur beroperasi dari 06:00 hingga 18:00 setiap hari, tutup saat Nyepi. Keberangkatan fast boat terakhir ke Nusa Penida dan Lembongan biasanya sekitar pukul 17:00.'
  },
  {
    question: 'Apakah ada bus langsung dari Gilimanuk ke Sanur?',
    answer: 'Tidak ada bus langsung. Bus umum menuju terminal Denpasar, di mana taksi atau ride-share lanjutan diperlukan untuk mencapai Sanur — biasanya melebihi 6 jam total.'
  },
  {
    question: 'Apakah tiket fast boat perlu dipesan terpisah?',
    answer: 'Ya. Kami menangani transfer darat dari Gilimanuk ke Pelabuhan Sanur; tiket fast boat ke Nusa Penida, Lembongan, atau Kepulauan Gili dipesan terpisah melalui operator boat.'
  },
  {
    question: 'Di mana sopir menjemput saya di Gilimanuk?',
    answer: 'Di Pelabuhan Gilimanuk (Pelabuhan Penyeberangan), di sisi barat pelabuhan saat Anda turun dari penyeberangan Ketapang.'
  },
  {
    question: 'Bisakah saya berhenti di Tanah Lot dalam perjalanan ke Sanur?',
    answer: 'Bisa, atas permintaan. Tanah Lot terletak dekat rute sebelum Mengwi. Pemberhentian yang direncanakan menambah total waktu perjalanan — konfirmasi saat booking.'
  }
];

const relatedRoutes = [
  { label: 'Transfer Gilimanuk ke Kuta', href: '/id/transfers/gilimanuk-to-kuta/' },
  { label: 'Transfer Gilimanuk ke Seminyak', href: '/id/transfers/gilimanuk-to-seminyak/' },
  { label: 'Transfer Gilimanuk ke Ubud', href: '/id/transfers/gilimanuk-to-ubud/' },
  { label: 'Transfer Gilimanuk ke Canggu', href: '/id/transfers/gilimanuk-to-canggu/' },
  { label: 'Semua Transfer Gilimanuk', href: '/id/transfers/' },
  { label: 'Semua Rute Transfer', href: '/id/transfers/' }
];

const pageUrl = 'https://baliwesttransport.com/id/transfers/gilimanuk-to-sanur/';
const canonicalEn = 'https://baliwesttransport.com/transfers/gilimanuk-to-sanur/';
const organizationId = `${pageUrl}#organization`;
const travelAgencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://baliwesttransport.com/logo.png'
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Customer Service',
        availableLanguage: ['English', 'Indonesian'],
        url: 'https://wa.me/6282247648944'
      },
      areaServed: {
        '@type': 'Place',
        name: 'Bali, Indonesia'
      }
    },
    {
      '@type': 'TravelAgency',
      '@id': travelAgencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      parentOrganization: {
        '@id': organizationId
      },
      areaServed: {
        '@type': 'Place',
        name: 'Bali, Indonesia'
      }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Transfer Pribadi Gilimanuk ke Sanur',
      description: 'Layanan transfer pribadi door-to-door dari Pelabuhan Gilimanuk ke Sanur, Bali. Sopir menjemput di pelabuhan. Jarak sekitar 130–140 km, 4–4,5 jam. Disesuaikan dengan jadwal fast boat ke Nusa Penida, Lembongan, dan Kepulauan Gili.',
      provider: {
        '@id': travelAgencyId
      },
      serviceType: 'Transfer Pribadi',
      areaServed: [
        {
          '@type': 'Place',
          name: 'Gilimanuk, Jembrana, Bali, Indonesia'
        },
        {
          '@type': 'Place',
          name: 'Sanur, Denpasar, Bali, Indonesia'
        }
      ],
      audience: {
        '@type': 'Audience',
        audienceType: 'Wisatawan yang tiba via feri Ketapang-Gilimanuk, menuju Sanur atau fast boat lanjutan ke Nusa Penida, Lembongan dan Kepulauan Gili'
      },
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: 'https://wa.me/6282247648944',
        servicePhone: '+6282247648944',
        availableLanguage: ['English', 'Indonesian']
      },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
        seller: {
          '@id': travelAgencyId
        }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Beranda',
          item: 'https://baliwesttransport.com/id/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Transfer Bali',
          item: 'https://baliwesttransport.com/id/transfers/'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Transfer Gilimanuk ke Sanur',
          item: pageUrl
        }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id',
      about: {
        '@id': serviceId
      },
      mainEntity: [
        { '@id': serviceId },
        { '@id': faqId }
      ],
      breadcrumb: {
        '@id': breadcrumbId
      },
      publisher: {
        '@id': organizationId
      },
      datePublished: '2026-07-05',
      dateModified: '2026-07-05'
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/kelingking-beach.jpg"
          alt="Transfer pribadi dari Gilimanuk ke Sanur Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Transfer Pribadi — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Transfer Pribadi Gilimanuk ke Sanur</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Door-to-Door dari Pelabuhan Penyeberangan — Disesuaikan dengan Jadwal Boat Anda
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan Transfer Anda
          </a>
          <a href="/id/transfers/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Lihat Semua Transfer</a>
        </div>
      </div>
    </section>

    <!-- Jawaban Cepat -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jawaban Cepat</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Transfer Pribadi dari Gilimanuk ke Sanur</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Pesan transfer pribadi dari Gilimanuk ke Sanur bersama Bali West Transport. Sopir menjemput Anda di Pelabuhan Gilimanuk saat turun dari penyeberangan Ketapang dari Jawa. Perjalanan menempuh sekitar 130–140 km dan memakan waktu 4 hingga 4,5 jam dengan kendaraan pribadi, mengikuti rute melalui Negara, Tabanan, dan Mengwi sebelum melanjutkan sepanjang ring luar Denpasar menuju pantai timur. Layanan door-to-door ke hotel atau villa mana pun di Sanur — dan jika Anda melanjutkan ke Nusa Penida, Nusa Lembongan, atau Kepulauan Gili, kami mengatur waktu penjemputan agar Anda tiba di Pelabuhan Sanur dengan waktu untuk check-in sebelum fast boat berangkat.
            </p>
          </div>
          <div class="space-y-4">
            <img src="/images/nusa-penida-viewpoint.jpg" alt="Pemandangan Bali menuju Sanur" class="w-full h-auto" loading="lazy" />
            <div class="grid grid-cols-2 gap-4">
              <img src="/images/beach-sunset-swing.jpg" alt="Sunset pantai Bali" class="w-full h-48 object-cover" loading="lazy" />
              <img src="https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=400&h=300&fit=crop" alt="Sawah terasering Bali" class="w-full h-48 object-cover" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ringkasan Rute -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Rute</p>
              <p class="font-serif text-2xl text-brand-dark">Gilimanuk ke Sanur</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Jarak</p>
              <p class="font-serif text-2xl text-brand-dark">130–140 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Waktu Tempuh</p>
              <p class="font-serif text-2xl text-brand-dark">4–4,5 jam</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Penawaran Fleksibel</span>
              <p class="text-brand-dark/50 text-sm mt-1">Beritahu kami tanggal, jumlah rombongan & jadwal boat Anda.</p>
            </div>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap">Minta Penawaran Terbaik</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Mengapa Memilih Transfer Ini -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Mengapa Memilih Transfer Ini</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Mengapa Transfer Pribadi dari Gilimanuk ke Sanur?</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Gilimanuk terletak di ujung barat Bali, dan Sanur terletak di pantai timur — ini adalah rute Gilimanuk standar terpanjang kami, tanpa transportasi umum langsung yang menghubungkan keduanya. Bus dari Gilimanuk berhenti di terminal Denpasar (Ubung atau Mengwi), dan Sanur masih memerlukan perjalanan taksi terpisah setelahnya, di atas waktu tunggu yang tidak bisa diprediksi untuk bus itu sendiri.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Transfer pribadi menyelesaikan masalah jarak dan masalah waktu sekaligus. Sopir sudah menunggu di pelabuhan saat feri Anda merapat, dan jika Anda melanjutkan dengan fast boat, kami mengatur waktu penjemputan berdasarkan jadwal keberangkatan boat Anda — bukan perkiraan kedatangan umum — yang penting, karena fast boat Pelabuhan Sanur beroperasi dengan jadwal tetap yang tidak menunggu koneksi bus yang terlambat.
            </p>
          </div>
          <div>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Rute melewati Negara dan Tabanan di jalan raya pantai barat utama Bali, kemudian bergabung dengan bypass Mengwi sebelum melewati ring selatan Denpasar menuju Sanur — koridor yang sama untuk transfer Kuta dan Seminyak, diperpanjang lebih jauh ke timur.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Lalu lintas cenderung padat di arterial Denpasar menuju Sanur (Jl. Bypass Ngurah Rai, Jl. Hang Tuah) saat jam sibuk sore, dan lagi di jalan depan pelabuhan Sanur saat fast boat baru merapat. Sopir yang tahu cara menghindari parkir pelabuhan saat puncak kedatangan boat menghemat waktu nyata di pendekatan akhir.
            </p>
            <div class="bg-brand-cream p-6 mt-4">
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Risiko Lalu Lintas</p>
              <p class="text-brand-dark/70 text-sm">Tinggi: Arterial Denpasar menuju Sanur dan jalan depan pelabuhan, terutama saat fast boat baru tiba (sekitar setiap jam, pagi hingga siang)</p>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2 mt-4">Waktu Keberangkatan Terbaik</p>
              <p class="text-brand-dark/70 text-sm">Kedatangan feri pagi (06:00–09:00) memberikan buffer paling banyak jika mengejar fast boat hari yang sama — keberangkatan terakhir Nusa Penida/Lembongan dari Pelabuhan Sanur sekitar pukul 17:00</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bandingkan Pilihan Anda -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Bandingkan Pilihan Anda</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Transfer Pribadi vs. Bus Umum vs. Taksi di Lokasi</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full bg-white border border-brand-dark/10">
            <thead>
              <tr class="border-b border-brand-dark/10">
                <th class="p-4 text-left text-brand-dark/40 text-xs uppercase tracking-widest"></th>
                <th class="p-4 text-left text-brand-dark font-serif text-lg">Transfer Pribadi<br/><span class="text-brand-gold text-xs uppercase tracking-widest font-sans">Bali West Transport</span></th>
                <th class="p-4 text-left text-brand-dark/70 font-serif text-lg">Bus Umum via Denpasar</th>
                <th class="p-4 text-left text-brand-dark/70 font-serif text-lg">Taksi / Ride-share di Lokasi</th>
              </tr>
            </thead>
            <tbody class="text-brand-dark/70">
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Total waktu</td>
                <td class="p-4 font-medium text-brand-dark">4–4,5 jam, langsung</td>
                <td class="p-4">6+ jam, dengan transit terminal</td>
                <td class="p-4">Tidak bisa diprediksi — tidak ada penjemputan tetap di pelabuhan</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Sesuai jadwal fast boat</td>
                <td class="p-4 font-medium text-brand-dark">Ya — penjemputan diatur berdasarkan jadwal boat</td>
                <td class="p-4">Tidak — jadwal bus tetap, boat tidak menunggu</td>
                <td class="p-4">Tidak — Anda negosiasi saat tiba</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Sopir di pelabuhan feri</td>
                <td class="p-4 font-medium text-brand-dark">Ya, dilacak sesuai penyeberangan Anda</td>
                <td class="p-4">Tidak</td>
                <td class="p-4">Tidak — Anda mengantri dan negosiasi saat tiba</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Harga diketahui sebelum berangkat</td>
                <td class="p-4 font-medium text-brand-dark">Ya, penawaran tetap dikonfirmasi via WhatsApp</td>
                <td class="p-4">Hanya harga tiket; biaya taksi belum diketahui</td>
                <td class="p-4">Tidak — dinegosiasi di tempat</td>
              </tr>
              <tr class="border-b border-brand-dark/5">
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Titik pengantaran</td>
                <td class="p-4 font-medium text-brand-dark">Pelabuhan Sanur, atau tepat di pintu hotel/villa</td>
                <td class="p-4">Terminal Denpasar, lalu kendaraan kedua</td>
                <td class="p-4">Tergantung sopir, sering tidak door-to-door</td>
              </tr>
              <tr>
                <td class="p-4 text-brand-dark/40 text-xs uppercase tracking-widest font-medium">Metode booking</td>
                <td class="p-4 font-medium text-brand-dark">WhatsApp, dikonfirmasi dalam hitungan menit</td>
                <td class="p-4">Beli tiket di terminal</td>
                <td class="p-4">Tidak ada — diatur setelah Anda tiba</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Info Pelabuhan Sanur -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Perjalanan Lanjutan</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Koneksi ke Nusa Penida, Lembongan, atau Kepulauan Gili dari Sanur</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Pelabuhan Sanur adalah terminal fast boat utama Bali untuk pulau-pulau tenggara, dan beroperasi dengan jadwal harian tetap — ini adalah satu bagian dari perjalanan Anda yang benar-benar bisa kacau jika transfer terlambat, jadi layak direncanakan dengan matang.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Tiket boat dipesan terpisah dari transfer darat — kami tidak menjual tiket fast boat, tapi kami mengatur waktu penjemputan di Gilimanuk berdasarkan jadwal keberangkatan yang sudah Anda pesan, sehingga Anda tiba di Sanur dengan buffer, bukan berlari ke dermaga.
            </p>
          </div>
          <div>
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-6">Fakta Pelabuhan Sanur</h3>
              <div class="space-y-4">
                {harbourFacts.map((item) => (
                  <div class="flex justify-between items-start gap-4 border-b border-brand-dark/10 pb-4">
                    <span class="text-brand-dark/40 text-xs uppercase tracking-widest font-medium">{item.fact}</span>
                    <span class="text-brand-dark font-medium text-right">{item.detail}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Penjemputan & Pengantaran -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Penjemputan</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Penjemputan di Pelabuhan Gilimanuk</h2>
            <p class="text-brand-dark/70 mb-6">Sopir menjemput Anda di <strong>Pelabuhan Gilimanuk (Pelabuhan Penyeberangan)</strong> di sisi barat pelabuhan saat Anda turun. Kirimkan referensi booking feri dan perkiraan waktu tiba saat memesan, beserta jadwal fast boat jika relevan — kami memantau keduanya dan menyesuaikan keberangkatan Anda.</p>
            <p class="text-brand-dark/70 mb-6">Penjemputan tambahan tersedia dari:</p>
            <div class="space-y-3 mb-6">
              {pickupLocations.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
          </div>
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pengantaran</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Lokasi Pengantaran di Sanur</h2>
            <p class="text-brand-dark/70 mb-6">Pengantaran door-to-door ke alamat mana pun di Sanur, termasuk:</p>
            <div class="space-y-3 mb-8">
              {dropoffAreas.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <p class="text-brand-dark/50 text-sm">Jika akomodasi Anda di gang kecil dari jalan utama pantai, konfirmasi alamat lengkap saat booking agar sopir dapat merencanakan pendekatan akhir.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Siapa yang Menggunakan Transfer Ini -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Siapa yang Menggunakan Transfer Ini</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Populer untuk Island-Hopper, Keluarga, dan Overlander Jawa</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {userTypes.map((item) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.title}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Gambaran Perjalanan -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Gambaran Perjalanan</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Rute dari Gilimanuk ke Sanur</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Perjalanan mengikuti jalan raya pantai barat utama Bali dari Gilimanuk melewati dataran sawah Kabupaten Jembrana, melewati Negara — ibu kota kabupaten dan tempat istirahat alami di tengah perjalanan — sebelum melanjutkan ke Kabupaten Tabanan.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Dari Tabanan jalan bergabung dengan bypass Mengwi dan melanjutkan melewati arterial luar Denpasar, bukan ke koridor bandara yang digunakan untuk transfer Kuta dan Seminyak. Ini adalah rute terpanjang dari ketiga rute tersebut, dan segmen akhir melalui ring selatan Denpasar menuju Sanur adalah tempat variabilitas lalu lintas perjalanan paling tinggi — terutama sekitar siang dan sore.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Jika Anda ingin berhenti, Negara adalah titik tengah terbaik untuk makan atau istirahat. Beberapa wisatawan di rute ini juga bertanya tentang mampir singkat ke Tanah Lot, yang terletak dekat koridor sebelum Mengwi — ini dapat diatur atas permintaan dan menambah total waktu perjalanan.
            </p>
          </div>
          <div>
            <img
              src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&h=600&fit=crop"
              alt="Pemandangan Bali sepanjang rute Gilimanuk ke Sanur"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Keunggulan Transfer Pribadi -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Keunggulan Transfer Pribadi</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Mengapa Memilih Transfer Pribadi?</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {benefits.map((item) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{item.title}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Pertanyaan yang Sering Diajukan</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="bg-white p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{faq.question}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Bawah -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-dark p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="font-serif text-2xl text-brand-cream mb-2">Siap booking? Kirim detail feri Anda — dan jadwal fast boat jika island-hopping — via WhatsApp.</h3>
            <p class="text-brand-cream/60">Kami akan mengkonfirmasi sopir, kendaraan, dan waktu penjemputan dalam hitungan menit.</p>
          </div>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan via WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Rute Transfer Gilimanuk Lainnya -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Rute Transfer Gilimanuk Lainnya</p>
          <h2 class="font-serif text-3xl text-brand-dark">Bepergian ke Bagian Bali Lainnya?</h2>
          <p class="text-brand-dark/60 mt-4">Lihat semua rute yang tersedia dari pelabuhan penyeberangan.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {relatedRoutes.map((route) => (
            <a href={route.href} class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
              <span class="text-brand-dark font-medium text-sm">{route.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Jelajahi Lebih Lanjut -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jelajahi Lebih Lanjut</p>
          <h2 class="font-serif text-3xl text-brand-dark">Selengkapnya dari Bali West Transport</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-4">
          <a href="/id/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Beranda</span>
          </a>
          <a href="/id/airport-transfer/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Transfer Bandara</span>
          </a>
          <a href="/id/tours/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Tur Pribadi</span>
          </a>
          <a href="/id/about/" class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Tentang Kami</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>
