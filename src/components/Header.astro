---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { href: lang === 'en' ? '/' : `/${lang}`, label: t('nav.home') },
  { href: lang === 'en' ? '/tours' : `/${lang}/tours`, label: t('nav.tours') },
  { href: lang === 'en' ? '/transfers' : `/${lang}/transfers`, label: t('nav.transfers') },
  { href: lang === 'en' ? '/about' : `/${lang}/about`, label: t('nav.about') },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent">
  <nav class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between h-20">
      <div class="flex items-center gap-8">
        <a href={lang === 'en' ? '/' : `/${lang}`} class="flex items-center gap-3 transition-colors duration-300">
          <img src="/baliwesttransport-favicon.png" alt="Bali West Transport Logo" class="h-12 w-auto" />
          <span id="logo-text" class="font-serif text-xl font-semibold tracking-wide hidden sm:inline">Bali West Transport</span>
        </a>
        
        <div class="hidden md:flex items-center gap-8">
          {navLinks.map((link) => (
            <a 
              href={link.href} 
              class="nav-link transition-colors duration-300 text-sm tracking-widest uppercase"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
      
      <div class="flex items-center gap-6">
        <div class="hidden sm:block">
          <LanguagePicker />
        </div>

        <a 
          href={`https://wa.me/6281234567890?text=${encodeURIComponent(t('whatsapp.message'))}`}
          target="_blank"
          rel="noopener noreferrer"
          id="book-btn"
          class="hidden sm:flex px-6 py-2.5 text-xs tracking-widest uppercase transition-all duration-300 items-center gap-2"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {t('nav.book')}
        </a>
        
        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 transition-colors duration-300" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-6 bg-brand-cream/95 backdrop-blur-md absolute left-0 right-0 px-6 border-b border-black/5 shadow-lg">
      <div class="py-4 border-b border-black/5 mb-2">
        <LanguagePicker />
      </div>
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="block py-3 text-brand-dark/70 hover:text-brand-dark transition-colors text-sm tracking-widest uppercase"
        >
          {link.label}
        </a>
      ))}
      <a 
        href={`https://wa.me/6281234567890?text=${encodeURIComponent(t('whatsapp.message'))}`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex bg-brand-dark text-brand-cream px-6 py-2.5 text-xs tracking-widest uppercase items-center gap-2 w-full justify-center"
      >
        {t('nav.book')}
      </a>
    </div>
  </nav>
</header>

<style>
  /* Default state (Top) */
  #main-header {
    @apply bg-gradient-to-b from-brand-dark/80 to-transparent backdrop-blur-[1px];
  }
  
  #logo-text, .nav-link, #mobile-menu-btn {
    @apply text-white drop-shadow-sm;
  }

  /* Target child component button */
  #main-header :global(.lang-picker-btn) {
    @apply text-white drop-shadow-sm;
  }
  
  .nav-link:hover {
    @apply text-brand-gold;
  }

  #main-header :global(.lang-picker-btn:hover) {
    @apply text-brand-gold;
  }
  
  #book-btn {
    @apply bg-brand-gold text-brand-dark;
  }
  
  #book-btn:hover {
    @apply bg-white;
  }

  /* Scrolled state */
  #main-header.is-scrolled {
    @apply bg-brand-cream/95 backdrop-blur-md shadow-md from-transparent to-transparent;
  }
  
  #main-header.is-scrolled #logo-text {
    @apply text-brand-dark drop-shadow-none;
  }
  
  #main-header.is-scrolled .nav-link {
    @apply text-brand-dark/70 drop-shadow-none;
  }

  #main-header.is-scrolled :global(.lang-picker-btn) {
    @apply text-brand-dark/70 drop-shadow-none;
  }
  
  #main-header.is-scrolled .nav-link:hover {
    @apply text-brand-dark;
  }

  #main-header.is-scrolled :global(.lang-picker-btn:hover) {
    @apply text-brand-dark;
  }
  
  #main-header.is-scrolled #book-btn {
    @apply bg-brand-dark text-brand-cream;
  }
  
  #main-header.is-scrolled #book-btn:hover {
    @apply bg-brand-dark-lighter;
  }
  
  #main-header.is-scrolled #mobile-menu-btn {
    @apply text-brand-dark;
  }

  /* Mobile menu overrides for language picker */
  #mobile-menu :global(.lang-picker-btn) {
    @apply text-brand-dark/70 drop-shadow-none;
  }
  #mobile-menu :global(.lang-picker-btn:hover) {
    @apply text-brand-dark;
  }
</style>

<script>
  const header = document.getElementById('main-header');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');

  function updateHeader() {
    if (window.scrollY > 20 || !mobileMenu?.classList.contains('hidden')) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
  }

  window.addEventListener('scroll', updateHeader);
  
  // Also update on mobile menu toggle
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    updateHeader();
  });
  
  // Initial check
  updateHeader();
</script>
