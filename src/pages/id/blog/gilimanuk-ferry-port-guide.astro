          <td class="p-4 text-brand-dark">3,5–4,5 jam</td>
        </tr>
        <tr class="bg-white">
          <td class="p-4 text-brand-dark">Canggu</td>
          <td class="p-4 text-brand-dark">2,5–3 jam</td>
        </tr>
