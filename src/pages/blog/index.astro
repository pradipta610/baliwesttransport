---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';

const pageTitle = 'Bali Travel Guides | Transport Tips & Island Insights — Bali West Transport';
const pageDescription = 'Practical Bali travel guides covering airport transfers, island transport, getting around Bali, and planning your trip. Written by local transport experts at Bali West Transport.';
const pageKeywords = 'bali travel guide, bali airport transfer guide, getting around bali, bali transport tips, bali taxi guide, private transfer bali';

const posts = [
  {
    title: 'How to Get from Gilimanuk to Ubud: Bus, Shuttle & Private Transfer (2026)',
    excerpt: 'Just arrived at Gilimanuk Ferry Port after the Ketapang ferry? Here are the three ways to reach Ubud — public bus, tourist shuttle, and private transfer — with travel times, costs, and tips for avoiding the common mistakes.',
    category: 'Gilimanuk Transfer',
    publishDate: '12 June 2026',
    readTime: '9 min read',
    image: '/images/beach-sunset-swing.jpg',
    imageAlt: 'Road through Bali on the journey from Gilimanuk to Ubud',
    href: '/blog/how-to-get-from-gilimanuk-to-ubud/',
  },
  {
    title: 'Airport Transfer vs Taxi in Bali: Which Is Right for You?',
    excerpt: 'Arriving at Ngurah Rai Airport and not sure whether to pre-book a private transfer or grab a taxi on arrival? This guide breaks down every option available at Bali Airport — what each involves, who it suits, and when to choose which.',
    category: 'Airport Transfer',
    publishDate: '8 June 2026',
    readTime: '7 min read',
    image: '/images/nusa-penida-viewpoint.jpg',
    imageAlt: 'Bali Airport transfer options',
    href: '/blog/airport-transfer-vs-taxi-bali/',
  },
];

const pageUrl = 'https://baliwesttransport.com/blog/';

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'en',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://baliwesttransport.com/#organization',
        name: 'Bali West Transport',
        url: 'https://baliwesttransport.com/',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://baliwesttransport.com/' },
        { '@type': 'ListItem', position: 2, name: 'Travel Guides', item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main>

    <!-- Hero -->
    <section class="relative bg-brand-dark pt-40 pb-24 overflow-hidden">
      <div class="absolute inset-0">
        <img src="/images/kelingking-beach.jpg" alt="Bali travel guides" class="w-full h-full object-cover opacity-20" />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/50 to-brand-dark"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-12">
        <div class="mb-6">
          <span class="inline-block bg-brand-gold/20 text-brand-gold text-xs tracking-[0.2em] uppercase px-4 py-2 border border-brand-gold/30">Travel Guides</span>
        </div>
        <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl text-brand-cream mb-6 leading-tight max-w-3xl">Bali Travel Guides</h1>
        <p class="text-brand-cream/60 text-xl max-w-2xl leading-relaxed">Practical transport guides for travellers planning a trip to Bali — written by people who drive these routes every day.</p>
      </div>
    </section>

    <!-- Posts Grid -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <article class="bg-white group">
              <a href={post.href} class="block">
                <div class="overflow-hidden">
                  <img
                    src={post.image}
                    alt={post.imageAlt}
                    class="w-full h-52 object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
                <div class="p-8">
                  <div class="flex items-center gap-4 mb-4">
                    <span class="text-brand-gold text-xs tracking-[0.15em] uppercase">{post.category}</span>
                    <span class="w-px h-3 bg-brand-dark/20"></span>
                    <span class="text-brand-dark/40 text-xs">{post.readTime}</span>
                  </div>
                  <h2 class="font-serif text-xl text-brand-dark mb-3 leading-snug group-hover:text-brand-gold transition-colors">{post.title}</h2>
                  <p class="text-brand-dark/60 text-sm leading-relaxed mb-6">{post.excerpt}</p>
                  <span class="inline-flex items-center gap-2 text-brand-dark text-xs tracking-[0.15em] uppercase font-medium group-hover:text-brand-gold transition-colors">
                    Read Guide
                    <svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Transfer Services CTA -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-[0.2em] uppercase mb-4">Our Services</p>
          <h2 class="font-serif text-4xl text-brand-dark">Book a Private Bali Transfer</h2>
          <p class="text-brand-dark/60 mt-4 max-w-xl mx-auto">Ready to book? Bali West Transport provides private airport transfers, intercity transfers, and full-day tours across Bali.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <a href="/airport-transfer/" class="bg-brand-cream p-6 hover:bg-brand-gold/10 transition-colors">
            <p class="text-brand-gold text-xs tracking-[0.15em] uppercase mb-2">Hub</p>
            <span class="text-brand-dark font-medium">Airport Transfer Bali</span>
          </a>
          <a href="/airport-transfer/ngurah-rai-airport-to-ubud/" class="bg-brand-cream p-6 hover:bg-brand-gold/10 transition-colors">
            <p class="text-brand-gold text-xs tracking-[0.15em] uppercase mb-2">Airport Transfer</p>
            <span class="text-brand-dark font-medium">Airport to Ubud</span>
          </a>
          <a href="/airport-transfer/ngurah-rai-airport-to-canggu/" class="bg-brand-cream p-6 hover:bg-brand-gold/10 transition-colors">
            <p class="text-brand-gold text-xs tracking-[0.15em] uppercase mb-2">Airport Transfer</p>
            <span class="text-brand-dark font-medium">Airport to Canggu</span>
          </a>
          <a href="/airport-transfer/ngurah-rai-airport-to-seminyak/" class="bg-brand-cream p-6 hover:bg-brand-gold/10 transition-colors">
            <p class="text-brand-gold text-xs tracking-[0.15em] uppercase mb-2">Airport Transfer</p>
            <span class="text-brand-dark font-medium">Airport to Seminyak</span>
          </a>
          <a href="/airport-transfer/ngurah-rai-airport-to-uluwatu/" class="bg-brand-cream p-6 hover:bg-brand-gold/10 transition-colors">
            <p class="text-brand-gold text-xs tracking-[0.15em] uppercase mb-2">Airport Transfer</p>
            <span class="text-brand-dark font-medium">Airport to Uluwatu</span>
          </a>
          <a href="/airport-transfer/ngurah-rai-airport-to-sanur/" class="bg-brand-cream p-6 hover:bg-brand-gold/10 transition-colors">
            <p class="text-brand-gold text-xs tracking-[0.15em] uppercase mb-2">Airport Transfer</p>
            <span class="text-brand-dark font-medium">Airport to Sanur</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>
