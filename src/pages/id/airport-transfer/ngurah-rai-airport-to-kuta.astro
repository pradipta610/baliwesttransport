---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppFloat from '../../../components/WhatsAppFloat.astro';

const pageTitle = 'Transfer Bandara Ngurah Rai ke Kuta | Antar Jemput Bandara Pribadi Bali';
const pageDescription = 'Pesan transfer pribadi dari Bandara Ngurah Rai ke Kuta bersama Bali West Transport. Jarak sebenarnya, estimasi waktu yang jujur, dan antar langsung ke hotel Anda. Kendaraan ber-AC, supir profesional, tersedia 24 jam.';
const pageKeywords = 'transfer bandara ngurah rai ke kuta, antar jemput bandara bali ke kuta, transfer bandara pribadi kuta, bandara DPS ke kuta, jemput bandara kuta bali, transfer kuta bali, bali west transport';

const whatsappText = 'Halo, saya ingin memesan transfer dari Bandara Ngurah Rai ke Kuta. Mohon informasi penawaran terbaik Anda.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const keunggulan = [
  'Supir menunggu di area kedatangan, tanpa antre di loket taksi',
  'Penawaran tetap disepakati sebelum Anda mendarat, tanpa tawar-menawar',
  'Kendaraan ber-AC yang nyaman dengan ruang untuk papan selancar dan bagasi ekstra',
  'Pemantauan penerbangan untuk keterlambatan',
  'Bantuan bagasi sudah termasuk',
  'Antar langsung ke hotel Anda, bukan ke titik drop-off bersama',
  'Cocok untuk solo traveler, pasangan, dan rombongan',
  'Berguna untuk transit singkat antar penerbangan atau kapal ferry'
];

const alasanKuta = [
  'Pantai wisata pertama di Bali dan spot selancar paling ramah untuk pemula',
  'Kawasan wisata utama yang paling dekat dengan Bandara Ngurah Rai',
  'Pilihan hotel budget dan menengah paling beragam di Bali Selatan',
  'Beachwalk Mall, Discovery Shopping Mall, dan Pasar Seni Kuta',
  'Salah satu titik menonton matahari terbenam paling terkenal di Bali',
  'Restoran dan kehidupan malam di sepanjang Jalan Legian'
];

const infoRute = [
  ['Rute', 'Bandara Ngurah Rai (DPS) → Kuta'],
  ['Jarak', '5–8 km'],
  ['Estimasi Waktu', '10–30 menit'],
  ['Jenis Layanan', 'Transfer Bandara Pribadi'],
  ['Cocok Untuk', 'Wisatawan pertama kali, peselancar, backpacker, transit singkat'],
  ['Kode Bandara', 'DPS'],
  ['Area Tujuan', 'Pantai Kuta, Kuta Square, perbatasan Legian, Tuban'],
];

const tabelRute = [
  { kondisi: 'Larut Malam', waktu: '8–15 menit' },
  { kondisi: 'Lalu Lintas Normal', waktu: '15–25 menit' },
  { kondisi: 'Jam Sibuk / Jam Matahari Terbenam', waktu: '30–45 menit' },
];

const pilihanTransfer = [
  {
    judul: 'Transfer Bandara Pribadi',
    terbaik: 'Wisatawan yang mau harga pasti dan antar langsung ke hotel',
    detail: 'Meskipun jaraknya pendek, transfer yang dipesan lebih dulu berarti tidak perlu jalan ke titik penjemputan, tanpa negosiasi harga, dan supir yang sudah tahu lokasi hotel Anda.'
  },
  {
    judul: 'Taksi Bandara',
    terbaik: 'Wisatawan fleksibel yang memilih transportasi on-arrival',
    detail: 'Taksi resmi tersedia tepat di luar area kedatangan dan menjadi pilihan yang masuk akal untuk jarak pendek ke Kuta jika Anda tidak keberatan mengantre.'
  },
  {
    judul: 'Grab dan Gojek',
    terbaik: 'Solo traveler dengan bagasi ringan',
    detail: 'Aplikasi ojol harus menjemput dari zona khusus yang jauh dari terminal, yang justru bisa menambah waktu berjalan dan menunggu lebih lama dari waktu perjalanannya sendiri.'
  },
  {
    judul: 'Jalan Kaki',
    terbaik: 'Wisatawan yang menginap di Tuban tanpa bagasi',
    detail: 'Sebagian wilayah Tuban berbatasan langsung dengan bandara, sehingga berjalan kaki secara teknis memungkinkan untuk beberapa hotel, namun tidak praktis dengan bagasi atau di tengah cuaca panas dan lembap Bali.'
  },
];

const periodeTiba = [
  { periode: 'Pagi Hari', waktu: '10–20 menit', catatan: 'Umumnya periode tercepat untuk jarak pendek menuju Kuta.' },
  { periode: 'Siang Hari', waktu: '15–30 menit', catatan: 'Lalu lintas menumpuk bertahap di sepanjang Jalan Raya Tuban dan Jalan Kartika Plaza.' },
  { periode: 'Sore / Jam Matahari Terbenam', waktu: '25–45 menit', catatan: 'Jalan di sepanjang pantai padat karena wisatawan menuju Pantai Kuta untuk menikmati sunset.' },
  { periode: 'Dini Hari', waktu: '8–15 menit', catatan: 'Waktu tercepat sepanjang hari untuk menuju Kuta dari bandara.' },
];

const faq = [
  {
    pertanyaan: 'Berapa jauh Kuta dari Bandara Bali?',
    jawaban: 'Kuta adalah salah satu kawasan wisata terdekat dari Bandara Ngurah Rai, sekitar 5 hingga 8 kilometer tergantung lokasi hotel Anda antara Tuban dan pusat Kuta.'
  },
  {
    pertanyaan: 'Bisakah berjalan kaki dari bandara ke Kuta?',
    jawaban: 'Sebagian wilayah Tuban di sisi selatan Kuta memang berbatasan dengan bandara, sehingga secara teknis bisa dijangkau dengan jalan kaki untuk beberapa hotel. Namun ini tidak disarankan jika membawa bagasi, dan sebagian besar Kuta tetap membutuhkan kendaraan.'
  },
  {
    pertanyaan: 'Sebenarnya berapa lama transfer dari bandara ke Kuta?',
    jawaban: 'Meskipun jaraknya pendek, waktu tempuh biasanya berkisar 10 hingga 30 menit, dan bisa memanjang menjadi 30 hingga 45 menit saat jam sibuk atau menjelang matahari terbenam ketika jalan di sepanjang pantai ramai.'
  },
  {
    pertanyaan: 'Kenapa harus pesan transfer pribadi untuk jarak sependek ini?',
    jawaban: 'Untuk perjalanan sependek ini, nilainya bukan pada kenyamanan perjalanan panjang, melainkan kepraktisan: tidak perlu antre di loket taksi, harga sudah disepakati sebelum mendarat, dan antar langsung ke hotel Anda beserta bagasi atau papan selancar.'
  },
  {
    pertanyaan: 'Apakah Kuta cocok untuk wisatawan pertama kali ke Bali?',
    jawaban: 'Ya. Kuta memiliki pantai selancar paling ramah untuk pemula di Bali, pilihan akomodasi budget dan menengah paling beragam, serta menjadi kawasan wisata terdekat dari bandara sehingga logistik kedatangan jadi sederhana.'
  },
  {
    pertanyaan: 'Apa perbedaan Kuta, Legian, dan Tuban?',
    jawaban: 'Ketiga kawasan ini berdampingan di sepanjang garis pantai yang sama. Tuban paling tenang dan paling dekat dengan bandara, Kuta adalah yang paling ramai dan pusat aktivitas, sementara Legian di utara umumnya lebih tenang dengan kesan sedikit lebih mewah.'
  }
];

const ruteTerkait = [
  { label: 'Hub Transfer Bandara', href: '/id/airport-transfer/' },
  { label: 'Bandara ke Seminyak', href: '/id/airport-transfer/ngurah-rai-airport-to-seminyak/' },
  { label: 'Bandara ke Canggu', href: '/id/airport-transfer/ngurah-rai-airport-to-canggu/' },
  { label: 'Bandara ke Uluwatu', href: '/id/airport-transfer/ngurah-rai-airport-to-uluwatu/' },
  { label: 'Bandara ke Nusa Dua', href: '/id/airport-transfer/ngurah-rai-airport-to-nusa-dua/' },
  { label: 'Semua Transfer Bali', href: '/id/transfers/' }
];

const pageUrl = 'https://baliwesttransport.com/id/airport-transfer/ngurah-rai-airport-to-kuta/';
const orgId = `${pageUrl}#organization`;
const agencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      address: { '@type': 'PostalAddress', addressLocality: 'Bali', addressCountry: 'ID' }
    },
    {
      '@type': 'TravelAgency',
      '@id': agencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: { '@type': 'AdministrativeArea', name: 'Bali, Indonesia' },
      parentOrganization: { '@id': orgId }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Transfer Bandara Ngurah Rai ke Kuta',
      alternateName: 'Ngurah Rai Airport to Kuta Transfer',
      description: pageDescription,
      serviceType: 'Transfer Bandara Pribadi',
      provider: { '@id': agencyId },
      availableLanguage: [{ '@type': 'Language', name: 'Indonesian' }, { '@type': 'Language', name: 'English' }],
      areaServed: [
        { '@type': 'Place', name: 'Bandara Ngurah Rai Internasional' },
        { '@type': 'Place', name: 'Kuta' },
        { '@type': 'Place', name: 'Tuban' },
        { '@type': 'Place', name: 'Legian' },
        { '@type': 'AdministrativeArea', name: 'Bali' }
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: { '@type': 'ContactPoint', telephone: '+6282247648944', contactType: 'customer service' }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.pertanyaan,
        acceptedAnswer: { '@type': 'Answer', text: item.jawaban }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://baliwesttransport.com/id/' },
        { '@type': 'ListItem', position: 2, name: 'Transfer Bandara', item: 'https://baliwesttransport.com/id/airport-transfer/' },
        { '@type': 'ListItem', position: 3, name: 'Transfer Bandara Ngurah Rai ke Kuta', item: pageUrl }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id',
      isPartOf: { '@id': orgId },
      about: { '@id': serviceId },
      mainEntity: [{ '@id': serviceId }, { '@id': faqId }],
      breadcrumb: { '@id': breadcrumbId },
      publisher: { '@id': orgId }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} includeOrgSchema={false}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img src="/images/beach-sunset-swing.jpg" alt="Transfer pribadi dari Bandara Ngurah Rai ke Kuta Bali" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Antar Jemput Bandara Pribadi — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Transfer Bandara Ngurah Rai ke Kuta</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-3xl mx-auto font-light drop-shadow-md">
          Antar jemput pribadi dari Bandara Bali ke Pantai Kuta, Kuta Square, dan perbatasan Legian.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan Transfer Sekarang
          </a>
          <a href="/id/airport-transfer/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Hub Transfer Bandara</a>
        </div>
      </div>
    </section>

    <!-- Intro + Info Cepat -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jawaban Cepat</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Perjalanan dari Bandara Bali ke Kuta</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Kuta adalah salah satu transfer terpendek di Bali, hanya berjarak 5 hingga 8 kilometer dari Bandara Ngurah Rai. Saat lalu lintas lengang, perjalanan bisa memakan waktu sesingkat 10 menit, meskipun umumnya membutuhkan 15 hingga 30 menit, dan bisa lebih dari 30 menit menjelang matahari terbenam saat jalan di sepanjang pantai ramai. Kami memilih menyampaikan ini secara jujur daripada melebih-lebihkan sebagai perjalanan lima menit.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Untuk jarak sependek ini, nilai dari transfer pribadi bukan pada perjalanan yang panjang dan nyaman, melainkan kepraktisan: tidak perlu antre di loket taksi, harga sudah disepakati sebelum mendarat, dan antar langsung ke hotel Anda, bukan ke titik drop-off bersama.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Rute ini cocok untuk wisatawan pertama kali ke Bali, peselancar dengan papan atau perlengkapan ekstra, backpacker, dan siapa pun dengan transit singkat antar penerbangan atau ferry yang ingin satu urusan lebih sedikit setelah mendarat.
            </p>
          </div>
          <div class="bg-white p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-6">Informasi Cepat</p>
            <div class="space-y-4">
              {infoRute.map(([label, value]) => (
                <div class="flex justify-between gap-4 border-b border-brand-dark/10 pb-4">
                  <span class="text-brand-dark/50 text-sm">{label}</span>
                  <span class="text-brand-dark font-medium text-sm text-right">{value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ringkasan Rute -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-cream p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Rute</p>
              <p class="font-serif text-2xl text-brand-dark">DPS → Kuta</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Jarak</p>
              <p class="font-serif text-2xl text-brand-dark">5–8 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Waktu</p>
              <p class="font-serif text-2xl text-brand-dark">10–30 mnt</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Penawaran Terbaik</span>
              <p class="text-brand-dark/50 text-sm mt-1">Informasikan tanggal, jam penerbangan, dan nama hotel Anda.</p>
            </div>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap">
              Minta Penawaran Terbaik
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Mengapa Kuta -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Mengapa Kuta</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Mengapa Menginap di Kuta?</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Kuta adalah kawasan wisata pantai pertama di Bali dan tetap yang paling mudah diakses, berada tepat di sebelah bandara dengan pilihan akomodasi budget dan menengah paling beragam di Bali.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {alasanKuta.map((alasan) => (
            <div class="flex items-start gap-4 p-6 bg-white">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{alasan}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Jarak & Rute -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jarak & Rute</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Seberapa Jauh Bandara Bali dari Kuta?</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Jarak dari Bandara Bali ke Kuta hanya sekitar 5 hingga 8 kilometer, menjadikannya salah satu kawasan wisata terdekat dari Bandara Ngurah Rai. Tidak ada jalan tol di rute ini; lalu lintas melewati Jalan Raya Tuban, Jalan Kartika Plaza, dan Jalan Legian.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Karena jaraknya sangat pendek, kondisi lalu lintas lebih menentukan daripada jumlah kilometer. Jalan yang lengang pukul 3 pagi bisa berarti perjalanan 8 menit, sementara rute yang sama menjelang matahari terbenam, saat semua orang menuju Pantai Kuta, bisa memakan waktu tiga sampai empat kali lipat.
            </p>
          </div>
          <div class="bg-brand-cream p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-6">Rata-rata Waktu Tempuh</p>
            <div class="space-y-4">
              {tabelRute.map((baris) => (
                <div class="flex justify-between gap-4 border-b border-brand-dark/10 pb-4">
                  <span class="text-brand-dark/50 text-sm">{baris.kondisi}</span>
                  <span class="text-brand-dark font-medium text-sm text-right">{baris.waktu}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pilihan Transfer -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pilihan Transportasi</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Cara Terbaik dari Bandara Ngurah Rai ke Kuta</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-4">
          {pilihanTransfer.map((pilihan) => (
            <div class="bg-white p-6">
              <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">{pilihan.judul}</p>
              <p class="text-brand-dark font-medium mb-3">{pilihan.terbaik}</p>
              <p class="text-brand-dark/70 text-sm leading-relaxed">{pilihan.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Kuta, Legian, Tuban -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Kuta, Legian & Tuban</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Anda Menginap di Bagian Kuta yang Mana?</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Kuta, Legian, dan Tuban berada di sepanjang garis pantai yang sama, sehingga "Kuta" pada pemesanan hotel bisa berarti waktu transfer yang sangat berbeda. Tuban paling dekat dengan bandara dan umumnya lebih tenang, pusat Kuta paling ramai dengan kehidupan malam dan pusat perbelanjaan terbanyak, sementara Legian di utara lebih tenang dengan kesan sedikit lebih mewah.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
