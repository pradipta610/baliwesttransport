---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';

const pageTitle = 'Gilimanuk to Nusa Dua Private Transfer | Bali West Transport';
const pageDescription = 'Book a private transfer from Gilimanuk Ferry Port to Nusa Dua. Comfortable door-to-door service, ~4.5–5.5 hour journey to Bali\'s luxury resort enclave. WhatsApp booking, best offer available.';
const pageKeywords = 'gilimanuk to nusa dua transfer, gilimanuk to nusa dua taxi, private transfer gilimanuk nusa dua, ferry port to nusa dua transport';

const whatsappText = 'Hi, I would like to book a private Gilimanuk to Nusa Dua transfer. Please send me your best offer.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const benefits = [
  'No transfers between ferry, bus, and taxi — one direct ride',
  'Air-conditioned comfort for one of Bali\'s longest domestic transfer routes',
  'Direct drop-off at your resort\'s gated entrance — no need to arrange a separate onward taxi',
  'Optional stops (GWK Cultural Park, Tanah Lot, Medewi Surf Beach) available on request',
  'English-speaking drivers familiar with the Gilimanuk–Nusa Dua route',
  'Fixed door-to-door service — no haggling on arrival'
];

const pickupLocations = [
  'Gilimanuk Ferry Port (Pelabuhan Gilimanuk)',
  'Gilimanuk town and surrounding hotels',
  'Karangsewu Beach area',
  'Custom pickup points along the Java–Bali ferry crossing on request'
];

const dropoffLocations = [
  'Nusa Dua Beach (Pantai Mengiat) and international resort hotels',
  'Geger Beach',
  'Tanjung Benoa',
  'Bali Collection shopping and dining complex',
  'Bali Nusa Dua Convention Centre (BNDCC)',
  'Pandawa Beach area (nearby, available on request)',
  'All major Nusa Dua resorts (St. Regis, Ritz-Carlton, Conrad, Kempinski, Grand Hyatt, Sofitel, Mulia, Westin and more)'
];

const popularDestinations = [
  'Nusa Dua Beach',
  'Geger Beach',
  'Tanjung Benoa',
  'Bali Collection',
  'BNDCC',
  'Pandawa Beach',
  'St. Regis / Ritz-Carlton',
  'Sofitel / Mulia'
];

const journeyHighlights = [
  'Negara and Tabanan countryside',
  'Denpasar bypass',
  'Jimbaran coastline',
  'Bukit Peninsula resort enclave',
  'GWK Cultural Park (optional stop)'
];

const faqs = [
  {
    question: 'How long does the Gilimanuk to Nusa Dua transfer take?',
    answer: 'The journey takes approximately 4.5 to 5.5 hours by private car, depending on traffic through Denpasar and into the Bukit Peninsula.'
  },
  {
    question: 'How far is Nusa Dua from Gilimanuk?',
    answer: 'Nusa Dua is approximately 148 km from Gilimanuk Ferry Port, making it one of Bali West Transport\'s longest transfer routes.'
  },
  {
    question: 'Can I stop along the way?',
    answer: 'Yes. Popular stops include GWK Cultural Park, Tanah Lot Temple, and Medewi Surf Beach. Let us know your preferred stops when booking.'
  },
  {
    question: 'Which Nusa Dua hotels do you serve?',
    answer: 'We provide direct drop-off at all major Nusa Dua resorts, including St. Regis, Ritz-Carlton, Conrad, Kempinski, Grand Hyatt, Sofitel, Mulia, and Westin, as well as Tanjung Benoa and Geger Beach hotels.'
  },
  {
    question: 'How do I book this transfer?',
    answer: 'Contact us directly via WhatsApp with your ferry arrival time, passenger count, and resort name in Nusa Dua to receive your best offer.'
  },
  {
    question: 'Is Nusa Dua a gated resort area?',
    answer: 'Yes, Nusa Dua is a landscaped, secured resort zone. Our drivers are familiar with the entry procedures and will take you directly to your hotel\'s gate.'
  }
];

const relatedRoutes = [
  { label: 'Gilimanuk to Uluwatu', href: '/transfers/gilimanuk-to-uluwatu/' },
  { label: 'Gilimanuk to Kuta', href: '/transfers/gilimanuk-to-kuta/' },
  { label: 'Gilimanuk to Sanur', href: '/transfers/gilimanuk-to-sanur/' },
  { label: 'Gilimanuk to Seminyak', href: '/transfers/gilimanuk-to-seminyak/' },
  { label: 'Gilimanuk to Ubud', href: '/transfers/gilimanuk-to-ubud/' },
  { label: 'Gilimanuk to Canggu', href: '/transfers/gilimanuk-to-canggu/' }
];

const pageUrl = 'https://baliwesttransport.com/transfers/gilimanuk-to-nusa-dua/';
const organizationId = `${pageUrl}#organization`;
const travelAgencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6285737866348',
      sameAs: []
    },
    {
      '@type': 'TravelAgency',
      '@id': travelAgencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6285737866348',
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Bali, Indonesia'
      },
      parentOrganization: {
        '@id': organizationId
      }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Gilimanuk to Nusa Dua Private Transfer',
      description: 'Book a private transfer from Gilimanuk to Nusa Dua with Bali West Transport. The journey covers approximately 148 km and takes around 4.5 to 5.5 hours depending on traffic, crossing Bali from the western ferry port to the island\'s premier resort enclave. Travel by comfortable private car door-to-door straight to your hotel in Nusa Dua — ideal for travellers arriving from Java via ferry and heading to South Bali\'s luxury resorts.',
      serviceType: 'Private transfer',
      provider: {
        '@id': travelAgencyId
      },
      areaServed: [
        {
          '@type': 'Place',
          name: 'Gilimanuk'
        },
        {
          '@type': 'Place',
          name: 'Nusa Dua'
        },
        {
          '@type': 'Place',
          name: 'Bukit Peninsula'
        },
        {
          '@type': 'AdministrativeArea',
          name: 'Bali'
        }
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: {
          '@type': 'ContactPoint',
          telephone: '+6285737866348',
          contactType: 'customer service'
        }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://baliwesttransport.com/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Transfers',
          item: 'https://baliwesttransport.com/transfers/'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Gilimanuk to Nusa Dua Transfer',
          item: pageUrl
        }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: {
        '@id': organizationId
      },
      about: {
        '@id': serviceId
      },
      mainEntity: [
        {
          '@id': serviceId
        },
        {
          '@id': faqId
        }
      ],
      breadcrumb: {
        '@id': breadcrumbId
      },
      publisher: {
        '@id': organizationId
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/beach-sunset-swing.jpg"
          alt="Private transfer from Gilimanuk to Nusa Dua Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Private Transfer — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Gilimanuk to Nusa Dua Transfer</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Door-to-door private transfer from Gilimanuk Ferry Port to Nusa Dua's luxury resort enclave with professional local drivers.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Book Your Transfer
          </a>
          <a href="/transfers/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">View All Transfers</a>
        </div>
      </div>
    </section>

    <!-- Intro Text -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Quick Answer</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Private Transfer from Gilimanuk to Nusa Dua</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Book a private transfer from Gilimanuk to Nusa Dua with Bali West Transport. The journey covers approximately 148 km and takes around 4.5 to 5.5 hours depending on traffic, crossing Bali from the western ferry port to the island's premier resort enclave.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Travel by comfortable private car door-to-door straight to your hotel in Nusa Dua — ideal for travellers arriving from Java via ferry and heading to South Bali's luxury resorts.
            </p>
          </div>
          <div class="space-y-4">
            <img
              src="/images/nusa-penida-viewpoint.jpg"
              alt="Scenic Bali landscape on the way to Nusa Dua"
              class="w-full h-auto"
              loading="lazy"
            />
            <div class="grid grid-cols-2 gap-4">
              <img
                src="/images/kelingking-beach.jpg"
                alt="Bali coastline near South Bali resorts"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <img
                src="https://images.unsplash.com/photo-1573790387438-4da905039392?w=400&h=300&fit=crop"
                alt="Nusa Dua resort beach Bali"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Route Overview Card -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Route</p>
              <p class="font-serif text-2xl text-brand-dark">Gilimanuk to Nusa Dua</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Distance</p>
              <p class="font-serif text-2xl text-brand-dark">~148 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Time</p>
              <p class="font-serif text-2xl text-brand-dark">4.5–5.5 hrs</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Best Offer</span>
              <p class="text-brand-dark/50 text-sm mt-1">Tell us your date & group size.</p>
            </div>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Ask Best Offer
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Why Choose Us</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Choose Our Gilimanuk to Nusa Dua Transfer?</h2>
        </div>
        <p class="text-brand-dark/70 text-lg leading-relaxed max-w-3xl mx-auto text-center mb-12">
          Nusa Dua is a master-planned resort district on the southeastern tip of the Bukit Peninsula, home to some of Bali's most prestigious international hotel brands. It's a long, cross-island drive from Gilimanuk — far more comfortable in a private, air-conditioned vehicle than switching between buses and taxis. Our drivers know the route through Negara, Tabanan, and the Denpasar bypass well, and are familiar with Nusa Dua's gated resort access points.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {benefits.map((benefit) => (
            <div class="flex items-start gap-4 p-6 bg-brand-cream">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{benefit}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pickup & Drop-off -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pickup</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Pickup Locations in Gilimanuk</h2>
            <p class="text-brand-dark/70 mb-6">We can arrange pickup from:</p>
            <div class="space-y-3 mb-6">
              {pickupLocations.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <p class="text-brand-dark/50 text-sm">Our driver will coordinate with you before arrival to ensure a smooth pickup experience.</p>
          </div>
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Drop-off</p>
            <h2 class="font-serif text-3xl text-brand-dark mb-6">Drop-off Locations in Nusa Dua</h2>
            <p class="text-brand-dark/70 mb-6">We provide direct drop-off to:</p>
            <div class="space-y-3 mb-8">
              {dropoffLocations.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70">{item}</span>
                </div>
              ))}
            </div>
            <div>
              <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Popular Areas in Nusa Dua</p>
              <div class="grid grid-cols-2 gap-3">
                {popularDestinations.map((destination) => (
                  <div class="bg-white p-3 text-brand-dark/60 text-sm">{destination}</div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Uses This Transfer -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Who Uses This Transfer</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Ideal for Resort Guests, Honeymooners & Event Attendees</h2>
            <ul class="space-y-3 text-brand-dark/70 text-lg leading-relaxed mb-8">
              <li>Travellers arriving via the Gilimanuk–Ketapang ferry from Java heading directly to a Nusa Dua resort</li>
              <li>Couples and honeymooners booking Nusa Dua's luxury beachfront hotels</li>
              <li>Families wanting a calm, gated resort area with white sand beaches and calm swimming water</li>
              <li>Conference and event attendees heading to the Bali Nusa Dua Convention Centre</li>
            </ul>
            <div>
              <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Along the Route</p>
              <div class="grid grid-cols-2 gap-3">
                {journeyHighlights.map((item) => (
                  <div class="bg-brand-cream p-3 text-brand-dark/70 text-sm">{item}</div>
                ))}
              </div>
            </div>
          </div>
          <div>
            <img
              src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&h=600&fit=crop"
              alt="Travellers arriving from Java to Bali via Gilimanuk Ferry"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Journey Overview -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Journey Overview</p>
          <h2 class="font-serif text-4xl text-brand-dark mb-6">From Gilimanuk to Bali's Resort Enclave</h2>
          <p class="text-brand-dark/70 text-lg leading-relaxed">
            From Gilimanuk, the route heads east along Bali's main cross-island road through Negara and Tabanan, skirting rice terraces and small towns before joining the Denpasar bypass. From there, it continues south through Jimbaran and into the Bukit Peninsula, arriving at Nusa Dua's landscaped resort enclave — a striking contrast to the rural roads crossed earlier in the journey. Given the distance, we recommend an early departure to avoid Denpasar's afternoon traffic and arrive at your resort in good time to enjoy the rest of the day.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">FAQ</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Frequently Asked Questions</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="bg-brand-cream p-8">
              <h3 class="font-serif text-2xl text-brand-dark mb-3">{faq.question}</h3>
              <p class="text-brand-dark/70 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="font-serif text-2xl text-brand-dark mb-2">Book Your Gilimanuk to Nusa Dua Transfer</h3>
            <p class="text-brand-dark/60">WhatsApp us now for a best offer and secure, comfortable transport across Bali.</p>
          </div>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Book Your Transfer Now
          </a>
        </div>
      </div>
    </section>

    <!-- Related Routes -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">More Routes</p>
          <h2 class="font-serif text-3xl text-brand-dark">Other Transfer Routes</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {relatedRoutes.map((route) => (
            <a href={route.href} class="bg-brand-cream p-6 text-center hover:bg-brand-gold/10 transition-colors">
              <span class="text-brand-dark font-medium text-sm">{route.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Explore More -->
    <section class="py-16 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Explore More</p>
          <h2 class="font-serif text-3xl text-brand-dark">More from Bali West Transport</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-4">
          <a href="/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Home</span>
          </a>
          <a href="/transfers/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">All Transfers</span>
          </a>
          <a href="/tours/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">Private Tours</span>
          </a>
          <a href="/about/" class="bg-white p-6 text-center hover:bg-brand-gold/10 transition-colors">
            <span class="text-brand-dark font-medium">About Us</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</Layout>
