---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppFloat from '../../../components/WhatsAppFloat.astro';

const pageTitle = 'Transfer Bandara Ngurah Rai ke Nusa Dua | Antar Jemput Bandara Pribadi Bali';
const pageDescription = 'Pesan transfer pribadi dari Bandara Ngurah Rai ke Nusa Dua bersama Bali West Transport lewat Jalan Tol Bali Mandara. Antar langsung ke resort di kawasan Nusa Dua. Kendaraan ber-AC, supir profesional, tersedia 24 jam.';
const pageKeywords = 'transfer bandara ngurah rai ke nusa dua, antar jemput bandara bali ke nusa dua, transfer bandara pribadi nusa dua, bandara DPS ke nusa dua, jemput bandara nusa dua bali, transfer nusa dua bali, tol bali mandara, bali west transport';

const whatsappText = 'Halo, saya ingin memesan transfer dari Bandara Ngurah Rai ke Nusa Dua. Mohon informasi penawaran terbaik Anda.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const keunggulan = [
  'Supir menunggu di area kedatangan bandara',
  'Penawaran fleksibel tanpa biaya tersembunyi',
  'Tanpa negosiasi harga setelah mendarat',
  'Kendaraan pribadi eksklusif ber-AC yang nyaman',
  'Pemantauan penerbangan untuk keterlambatan',
  'Bantuan bagasi sudah termasuk',
  'Antar langsung ke dalam gerbang kawasan resort Nusa Dua',
  'Cocok untuk pasangan, keluarga, dan rombongan MICE'
];

const alasanNusaDua = [
  'Pantai tenang terlindung karang, aman untuk anak-anak dan berenang',
  'Kawasan resort tertata rapi dan berpagar yang dikelola ITDC',
  'Jalan lebar, tenang, dan tertata dengan lalu lintas jalanan minim',
  'Salah satu kawasan dengan konsentrasi resort bintang 5 terbanyak di Bali',
  'Bali Nusa Dua Convention Centre untuk acara MICE dan konferensi',
  'Lapangan golf, wahana air, dan Water Blow di dekatnya'
];

const infoRute = [
  ['Rute', 'Bandara Ngurah Rai (DPS) → Nusa Dua'],
  ['Jarak', '12–20 km'],
  ['Estimasi Waktu', '20–40 menit'],
  ['Jalan Utama', 'Jalan Tol Bali Mandara'],
  ['Jenis Layanan', 'Transfer Bandara Pribadi'],
  ['Cocok Untuk', 'Pasangan bulan madu, keluarga, tamu MICE, pegolf'],
  ['Kode Bandara', 'DPS'],
  ['Area Tujuan', 'Kawasan resort Nusa Dua, zona ITDC, Tanjung Benoa'],
];

const tabelRute = [
  { kondisi: 'Larut Malam', waktu: '15–20 menit' },
  { kondisi: 'Lalu Lintas Normal (via tol)', waktu: '20–30 menit' },
  { kondisi: 'Jam Sibuk', waktu: '35–50 menit' },
];

const pilihanTransfer = [
  {
    judul: 'Transfer Bandara Pribadi',
    terbaik: 'Pasangan, keluarga, rombongan MICE, dan tamu resort',
    detail: 'Transfer bandara pribadi adalah pilihan paling nyaman untuk penjemputan langsung, bantuan bagasi, dan antar tepat ke resort Anda di dalam gerbang kawasan Nusa Dua.'
  },
  {
    judul: 'Taksi Bandara',
    terbaik: 'Wisatawan fleksibel yang memilih transportasi on-arrival',
    detail: 'Taksi resmi tersedia di luar area kedatangan, namun pemesanan terlebih dahulu dapat mengurangi antrean dan ketidakpastian setelah perjalanan panjang.'
  },
  {
    judul: 'Grab dan Gojek',
    terbaik: 'Solo traveler dan pengguna aplikasi',
    detail: 'Aplikasi ojol beroperasi dari area khusus di bandara, meskipun titik penjemputan dan waktu tunggu bisa bervariasi saat ramai.'
  },
  {
    judul: 'Taksi Bluebird',
    terbaik: 'Wisatawan yang sudah familiar dengan layanan taksi Bali',
    detail: 'Bluebird Group dikenal luas di Bali dan bisa menjadi alternatif ketika tersedia di sekitar area bandara.'
  },
];

const periodeTiba = [
  { periode: 'Pagi Hari', waktu: '15–25 menit', catatan: 'Umumnya periode termudah untuk transfer bandara lewat jalan tol.' },
  { periode: 'Siang Hari', waktu: '25–40 menit', catatan: 'Lalu lintas mulai menumpuk di sekitar simpang Jimbaran dan Simpang Siur sebelum pintu tol.' },
  { periode: 'Malam Hari', waktu: '30–50 menit', catatan: 'Biasanya periode tersibuk untuk transfer bandara di kawasan Bali Selatan.' },
  { periode: 'Dini Hari', waktu: '15–20 menit', catatan: 'Seringkali waktu tercepat untuk perjalanan antara bandara dan Nusa Dua.' },
];

const faq = [
  {
    pertanyaan: 'Berapa lama perjalanan dari Bandara Ngurah Rai ke Nusa Dua?',
    jawaban: 'Sebagian besar perjalanan membutuhkan waktu antara 20 hingga 40 menit tergantung kondisi lalu lintas, waktu kedatangan, dan resort tempat Anda menginap di dalam kawasan Nusa Dua.'
  },
  {
    pertanyaan: 'Berapa jauh Bandara Bali dari Nusa Dua?',
    jawaban: 'Jarak dari Bandara Bali ke Nusa Dua sekitar 12 hingga 20 kilometer, sebagian besar dilalui melalui Jalan Tol Bali Mandara.'
  },
  {
    pertanyaan: 'Apakah ada jalan tol dari bandara ke Nusa Dua?',
    jawaban: 'Ya. Jalan Tol Bali Mandara menghubungkan bandara langsung ke Nusa Dua dan Pelabuhan Benoa di atas laut, yang biasanya lebih cepat dan lebih pasti dibanding rute lama melalui Kuta dan Jimbaran.'
  },
  {
    pertanyaan: 'Apakah Nusa Dua cocok untuk keluarga dan bulan madu?',
    jawaban: 'Ya. Nusa Dua adalah kawasan resort berpagar yang tertata rapi dengan pantai tenang terlindung karang, jalan lebar dan asri, serta konsentrasi resort bintang 5 yang tinggi, sehingga populer di kalangan keluarga, pasangan, dan pengantin baru.'
  },
  {
    pertanyaan: 'Apa perbedaan Nusa Dua dengan Kuta atau Seminyak?',
    jawaban: 'Nusa Dua adalah kawasan resort terkelola yang dikembangkan oleh ITDC (dahulu BTDC) dengan akses gerbang yang terkontrol, sementara Kuta dan Seminyak adalah area terbuka dengan jalan umum, toko, dan kehidupan malam.'
  },
  {
    pertanyaan: 'Apa pilihan transfer terbaik dari Bandara Bali ke Nusa Dua?',
    jawaban: 'Transfer bandara pribadi umumnya menjadi pilihan paling andal karena menyediakan penjemputan langsung, bantuan bagasi, dan antar tepat ke resort Anda di dalam zona Nusa Dua.'
  }
];

const ruteTerkait = [
  { label: 'Hub Transfer Bandara', href: '/id/airport-transfer/' },
  { label: 'Bandara ke Ubud', href: '/id/airport-transfer/ngurah-rai-airport-to-ubud/' },
  { label: 'Bandara ke Uluwatu', href: '/id/airport-transfer/ngurah-rai-airport-to-uluwatu/' },
  { label: 'Bandara ke Sanur', href: '/id/airport-transfer/ngurah-rai-airport-to-sanur/' },
  { label: 'Bandara ke Kuta', href: '/id/airport-transfer/ngurah-rai-airport-to-kuta/' },
  { label: 'Semua Transfer Bali', href: '/id/transfers/' }
];

const pageUrl = 'https://baliwesttransport.com/id/airport-transfer/ngurah-rai-airport-to-nusa-dua/';
const orgId = `${pageUrl}#organization`;
const agencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      address: { '@type': 'PostalAddress', addressLocality: 'Bali', addressCountry: 'ID' }
    },
    {
      '@type': 'TravelAgency',
      '@id': agencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: { '@type': 'AdministrativeArea', name: 'Bali, Indonesia' },
      parentOrganization: { '@id': orgId }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Transfer Bandara Ngurah Rai ke Nusa Dua',
      alternateName: 'Ngurah Rai Airport to Nusa Dua Transfer',
      description: pageDescription,
      serviceType: 'Transfer Bandara Pribadi',
      provider: { '@id': agencyId },
      availableLanguage: [{ '@type': 'Language', name: 'Indonesian' }, { '@type': 'Language', name: 'English' }],
      areaServed: [
        { '@type': 'Place', name: 'Bandara Ngurah Rai Internasional' },
        { '@type': 'Place', name: 'Nusa Dua' },
        { '@type': 'Place', name: 'Tanjung Benoa' },
        { '@type': 'AdministrativeArea', name: 'Bali' }
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: { '@type': 'ContactPoint', telephone: '+6282247648944', contactType: 'customer service' }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.pertanyaan,
        acceptedAnswer: { '@type': 'Answer', text: item.jawaban }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://baliwesttransport.com/id/' },
        { '@type': 'ListItem', position: 2, name: 'Transfer Bandara', item: 'https://baliwesttransport.com/id/airport-transfer/' },
        { '@type': 'ListItem', position: 3, name: 'Transfer Bandara Ngurah Rai ke Nusa Dua', item: pageUrl }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id',
      isPartOf: { '@id': orgId },
      about: { '@id': serviceId },
      mainEntity: [{ '@id': serviceId }, { '@id': faqId }],
      breadcrumb: { '@id': breadcrumbId },
      publisher: { '@id': orgId }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} includeOrgSchema={false}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img src="/images/nusa-penida-viewpoint.jpg" alt="Transfer pribadi dari Bandara Ngurah Rai ke Nusa Dua Bali" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Antar Jemput Bandara Pribadi — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Transfer Bandara Ngurah Rai ke Nusa Dua</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-3xl mx-auto font-light drop-shadow-md">
          Antar jemput pribadi dari Bandara Bali ke kawasan resort Nusa Dua lewat Jalan Tol Bali Mandara.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pesan Transfer Sekarang
          </a>
          <a href="/id/airport-transfer/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Hub Transfer Bandara</a>
        </div>
      </div>
    </section>

    <!-- Intro + Info Cepat -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jawaban Cepat</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Perjalanan dari Bandara Bali ke Nusa Dua</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Nusa Dua adalah salah satu transfer bandara paling lancar di Bali Selatan karena sebagian besar rutenya melewati Jalan Tol Bali Mandara, jalan tol layang yang dibangun langsung di atas laut menghubungkan bandara, Pelabuhan Benoa, dan kawasan resort Nusa Dua. Perjalanan biasanya membutuhkan waktu 20 hingga 40 menit dan mencakup jarak sekitar 12 hingga 20 kilometer tergantung resort tempat Anda menginap.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Sebagian besar wisatawan yang menuju Nusa Dua memilih transfer bandara pribadi karena menawarkan antar langsung hingga ke dalam gerbang resort, bantuan bagasi, dan terhindar dari negosiasi harga setelah mendarat.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Rute ini sangat berguna untuk pasangan bulan madu, keluarga, dan wisatawan MICE atau konferensi yang menuju resort dan fasilitas konvensi di dalam kawasan Nusa Dua.
            </p>
          </div>
          <div class="bg-white p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-6">Informasi Cepat</p>
            <div class="space-y-4">
              {infoRute.map(([label, value]) => (
                <div class="flex justify-between gap-4 border-b border-brand-dark/10 pb-4">
                  <span class="text-brand-dark/50 text-sm">{label}</span>
                  <span class="text-brand-dark font-medium text-sm text-right">{value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ringkasan Rute -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-cream p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Rute</p>
              <p class="font-serif text-2xl text-brand-dark">DPS → Nusa Dua</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Jarak</p>
              <p class="font-serif text-2xl text-brand-dark">12–20 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Waktu</p>
              <p class="font-serif text-2xl text-brand-dark">20–40 mnt</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Penawaran Terbaik</span>
              <p class="text-brand-dark/50 text-sm mt-1">Informasikan tanggal, jam penerbangan, dan nama resort Anda.</p>
            </div>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap">
              Minta Penawaran Terbaik
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Mengapa Nusa Dua -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Mengapa Nusa Dua</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Mengapa Menginap di Nusa Dua?</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Nusa Dua adalah kawasan resort tertata rapi di pesisir tenggara Bali, dikembangkan oleh Indonesia Tourism Development Corporation (ITDC, dahulu BTDC) sejak tahun 1970-an sebagai zona wisata terkontrol dan kelas atas.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {alasanNusaDua.map((alasan) => (
            <div class="flex items-start gap-4 p-6 bg-white">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{alasan}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Jarak & Rute -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Jarak & Rute</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Seberapa Jauh Bandara Bali dari Nusa Dua?</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Jarak dari Bandara Bali ke Nusa Dua sekitar 12 hingga 20 kilometer. Sebagian besar perjalanan melewati Jalan Tol Bali Mandara, jalan tol layang di atas laut yang menghubungkan bandara langsung ke Pelabuhan Benoa dan Nusa Dua tanpa melewati jalanan padat Kuta atau Jimbaran.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Lalu lintas cenderung menumpuk di pintu masuk dan keluar tol saat jam sibuk pagi dan sore, liburan sekolah, serta periode konferensi atau acara besar di Bali Nusa Dua Convention Centre.
            </p>
          </div>
          <div class="bg-brand-cream p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-6">Rata-rata Waktu Tempuh</p>
            <div class="space-y-4">
              {tabelRute.map((baris) => (
                <div class="flex justify-between gap-4 border-b border-brand-dark/10 pb-4">
                  <span class="text-brand-dark/50 text-sm">{baris.kondisi}</span>
                  <span class="text-brand-dark font-medium text-sm text-right">{baris.waktu}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pilihan Transfer -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Pilihan Transportasi</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Cara Terbaik dari Bandara Ngurah Rai ke Nusa Dua</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-4">
          {pilihanTransfer.map((pilihan) => (
            <div class="bg-white p-6">
              <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">{pilihan.judul}</p>
              <p class="text-brand-dark font-medium mb-3">{pilihan.terbaik}</p>
              <p class="text-brand-dark/70 text-sm leading-relaxed">{pilihan.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Kawasan Berpagar -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Di Dalam Zona Resort</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Tiba di Kawasan Resort Berpagar</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Berbeda dari Kuta atau Seminyak, akses ke Nusa Dua melalui gerbang masuk yang dikontrol dan dikelola oleh ITDC. Resort, lapangan golf, dan pusat konvensi berada di sepanjang jalan lebar dan asri di dalam zona tersebut, sehingga supir transfer yang sudah memahami tata jalan internal dapat mengantar Anda langsung ke lobi tanpa kebingungan di gerbang.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              Jika Anda menghadiri konferensi atau acara di Bali Nusa Dua Convention Centre, sisihkan waktu tambahan saat jam sibuk kedatangan dan keberangkatan acara, karena lalu lintas event menambah kepadatan arus bandara.
            </p>
          </div>
          <img src="/images/kelingking-beach.jpg" alt="Pesisir Bali Selatan dekat Nusa Dua" class="w-full h-auto object-cover" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- Waktu Tempuh per Periode Kedatangan -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
