---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';

const pageTitle = 'Ngurah Rai Airport to Ubud Transfer | Private Airport Transfer Bali';
const pageDescription = 'Book a private transfer from Ngurah Rai Airport to Ubud with Bali West Transport. Professional local drivers, air-conditioned vehicles, and direct hotel or villa drop-off service. Available 24 hours.';
const pageKeywords = 'Ngurah Rai Airport to Ubud transfer, private airport transfer Bali to Ubud, DPS airport to Ubud, Bali airport pickup Ubud, airport transfer Ubud Bali, Bali West Transport';

const whatsappText = 'Hi, I would like to book a private transfer from Ngurah Rai Airport to Ubud. Please send me your best offer.';
const whatsappUrl = `https://wa.me/6282247648944?text=${encodeURIComponent(whatsappText)}`;

const benefits = [
  'Private vehicle exclusively for you and your group',
  'Direct airport pickup and hotel drop-off service',
  'Professional local drivers with extensive Bali route knowledge',
  'Comfortable air-conditioned vehicles',
  'Fixed pricing with no hidden fees',
  'Airport pickup available 24 hours',
  'Suitable for solo travellers, couples, families, and groups',
  'Easier travel after long international flights'
];

const ubудAreas = [
  'Central Ubud',
  'Tegallalang',
  'Campuhan',
  'Sayan',
  'Kedewatan',
  'Penestanan',
  'Mas Village',
  'Pejeng',
  'Goa Gajah Area'
];

const privateTransferBenefits = [
  'Driver waits at airport',
  'Fixed price',
  'No fare negotiation',
  'Private vehicle',
  'Direct transfer'
];

const taxiDrawbacks = [
  'Queue waiting time',
  'Surge pricing',
  'Pickup point confusion',
  'Limited luggage space',
  'Driver cancellations'
];

const whoShouldBook = [
  'Honeymoon travellers',
  'Families with children',
  'Solo travellers',
  'Digital nomads',
  'Wellness travellers',
  'International tourists',
  'Travellers arriving late at night'
];

const whyChooseUs = [
  'Professional local drivers',
  'Comfortable air-conditioned vehicles',
  'Private transportation service',
  'Airport pickup available 24/7',
  'Direct hotel and villa drop-off',
  'Flexible Bali transportation options',
  'Service coverage across Bali'
];

const faqs = [
  {
    question: 'What is the best way to get from Ngurah Rai Airport to Ubud?',
    answer: 'The most comfortable option is booking a private airport transfer with direct hotel pickup and drop-off service. This avoids taxi queues, fare negotiation, and transportation confusion after landing.'
  },
  {
    question: 'How long does it take from Bali Airport to Ubud?',
    answer: 'Average travel time is around 1.5–2.5 hours depending on traffic conditions and hotel location. During busy periods or holiday seasons, travel time may be longer.'
  },
  {
    question: 'How far is Ubud from Ngurah Rai Airport?',
    answer: 'The distance from Ngurah Rai Airport to Ubud is approximately 35–40 kilometres depending on your hotel location within the Ubud area.'
  },
  {
    question: 'Can I pre-book airport transfer to Ubud?',
    answer: 'Yes. Pre-booking is recommended, especially during Bali holiday seasons and peak travel periods, to ensure your driver is ready upon arrival.'
  },
  {
    question: 'Is airport pickup in Bali available late at night?',
    answer: 'Yes. Bali West Transport offers airport pickup services based on your flight arrival schedule, including late-night and early-morning arrivals.'
  }
];

const relatedRoutes = [
  { label: 'Airport Transfer Hub', href: '/airport-transfer/' },
  { label: 'Airport to Canggu', href: '/airport-transfer/ngurah-rai-airport-to-canggu/' },
  { label: 'Airport to Seminyak', href: '/airport-transfer/ngurah-rai-airport-to-seminyak/' },
  { label: 'Airport to Uluwatu', href: '/airport-transfer/ngurah-rai-airport-to-uluwatu/' },
  { label: 'Airport to Sanur', href: '/airport-transfer/' },
  { label: 'Gilimanuk to Ubud Transfer', href: '/transfers/gilimanuk-to-ubud/' }
];

const pageUrl = 'https://baliwesttransport.com/airport-transfer/ngurah-rai-airport-to-ubud/';
const organizationId = `${pageUrl}#organization`;
const travelAgencyId = `${pageUrl}#travel-agency`;
const serviceId = `${pageUrl}#service`;
const faqId = `${pageUrl}#faq`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const webPageId = `${pageUrl}#webpage`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      logo: 'https://baliwesttransport.com/baliwesttransport-favicon.png',
      telephone: '+6282247648944',
      sameAs: []
    },
    {
      '@type': 'TravelAgency',
      '@id': travelAgencyId,
      name: 'Bali West Transport',
      url: 'https://baliwesttransport.com/',
      telephone: '+6282247648944',
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Bali, Indonesia'
      },
      parentOrganization: { '@id': organizationId }
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Ngurah Rai Airport to Ubud Transfer',
      description: pageDescription,
      serviceType: 'Private Airport Transfer',
      provider: { '@id': travelAgencyId },
      areaServed: [
        { '@type': 'Place', name: 'Ngurah Rai International Airport' },
        { '@type': 'Place', name: 'Ubud' },
        { '@type': 'AdministrativeArea', name: 'Bali' }
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: pageUrl,
        servicePhone: {
          '@type': 'ContactPoint',
          telephone: '+6282247648944',
          contactType: 'customer service'
        }
      }
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://baliwesttransport.com/' },
        { '@type': 'ListItem', position: 2, name: 'Airport Transfer', item: 'https://baliwesttransport.com/airport-transfer/' },
        { '@type': 'ListItem', position: 3, name: 'Ngurah Rai Airport to Ubud Transfer', item: pageUrl }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': organizationId },
      about: { '@id': serviceId },
      mainEntity: [{ '@id': serviceId }, { '@id': faqId }],
      breadcrumb: { '@id': breadcrumbId },
      publisher: { '@id': organizationId }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center">
      <div class="absolute inset-0">
        <img
          src="/images/nusa-penida-viewpoint.jpg"
          alt="Private transfer from Ngurah Rai Airport to Ubud Bali"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white pt-20">
        <p class="text-brand-gold text-sm tracking-[0.3em] uppercase mb-6 drop-shadow-md">Private Airport Transfer — Bali West Transport</p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-8 leading-tight drop-shadow-lg">Ngurah Rai Airport to Ubud Transfer</h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 max-w-2xl mx-auto font-light drop-shadow-md">
          Private door-to-door transfer from Bali Airport to Ubud with professional local drivers and direct hotel drop-off.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark px-10 py-4 text-sm tracking-widest uppercase transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Book Your Transfer
          </a>
          <a href="/airport-transfer/" class="border border-white/50 hover:bg-white/10 text-white px-10 py-4 text-sm tracking-widest uppercase transition-all">Airport Transfer Hub</a>
        </div>
      </div>
    </section>

    <!-- Quick Answer + Intro -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Private Airport Transfer</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Private Transfer from Ngurah Rai Airport to Ubud</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              Book a private transfer from Ngurah Rai Airport to Ubud with Bali West Transport. The journey takes approximately 1.5–2.5 hours depending on traffic and provides a comfortable door-to-door transport solution for travellers arriving via Ngurah Rai International Airport (DPS).
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-6">
              A private airport transfer allows travellers to avoid taxi negotiations, long waiting times, and transportation confusion after landing in Bali. Your driver will pick you up directly from the airport and take you safely to your hotel, villa, Airbnb, or resort in Ubud.
            </p>
            <p class="text-brand-dark/70 text-lg leading-relaxed">
              For travellers visiting Ubud for yoga retreats, honeymoon trips, rice terrace tours, waterfalls, or cultural experiences, booking a private transfer from the airport is one of the easiest and most comfortable transportation options.
            </p>
          </div>
          <div class="bg-white p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-6">Quick Information</p>
            <div class="space-y-4">
              {[
                ['Service', 'Bali Airport Transfer to Ubud'],
                ['Pickup Location', 'Ngurah Rai International Airport (DPS)'],
                ['Destination', 'Ubud, Bali'],
                ['Transport Type', 'Private Car with Driver'],
                ['Estimated Travel Time', '1.5–2.5 Hours'],
                ['Availability', '24 Hours'],
                ['Vehicle', 'Private Air-Conditioned Car'],
                ['Service Type', 'Airport Pickup & Hotel Drop-Off'],
                ['Provider', 'Bali West Transport'],
              ].map(([label, value]) => (
                <div class="flex justify-between gap-4 border-b border-brand-dark/10 pb-4">
                  <span class="text-brand-dark/50 text-sm">{label}</span>
                  <span class="text-brand-dark font-medium text-sm text-right">{value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Route Overview Card -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="bg-brand-cream p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-brand-dark/10">
          <div class="grid grid-cols-3 gap-8 flex-1">
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Route</p>
              <p class="font-serif text-2xl text-brand-dark">DPS → Ubud</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Distance</p>
              <p class="font-serif text-2xl text-brand-dark">35–40 km</p>
            </div>
            <div>
              <p class="text-brand-dark/40 text-xs uppercase tracking-widest mb-2">Est. Time</p>
              <p class="font-serif text-2xl text-brand-dark">1.5–2.5 hrs</p>
            </div>
          </div>
          <div class="md:border-l md:border-brand-dark/10 md:pl-8 flex flex-col items-start gap-4">
            <div>
              <span class="font-serif text-4xl text-brand-gold">Flexible Offer</span>
              <p class="text-brand-dark/50 text-sm mt-1">Tell us your date & group size.</p>
            </div>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-brand-dark hover:bg-brand-dark-lighter text-brand-cream px-8 py-4 text-sm tracking-widest uppercase transition-colors whitespace-nowrap"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Ask Best Offer
            </a>
          </div>
        </div>
        <div class="mt-6 bg-brand-cream p-6">
          <p class="text-brand-gold text-xs tracking-widest uppercase mb-3">Travel Times May Vary By</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {['Arrival time', 'Weather conditions', 'Holiday season traffic', 'Hotel location in Ubud'].map((item) => (
              <div class="bg-white p-3 text-brand-dark/70 text-sm text-center">{item}</div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Why Book Private Transfer -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Why Book a Private Transfer</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Book a Private Airport Transfer to Ubud?</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">Many travellers arriving in Bali look for the best way to reach Ubud directly from the airport. A private transfer is often preferred because it offers:</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {benefits.map((benefit) => (
            <div class="flex items-start gap-4 p-6 bg-white">
              <div class="w-8 h-8 bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-brand-dark/70">{benefit}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Ubud Areas -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Drop-off Coverage</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Popular Ubud Areas for Airport Transfer</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-8">
              Bali West Transport provides airport transfers to all major Ubud areas. Whether you stay at a luxury resort, jungle villa, yoga retreat, or private Airbnb, private airport pickup makes the journey smoother and more convenient.
            </p>
            <div class="grid grid-cols-2 gap-3">
              {ubудAreas.map((area) => (
                <div class="bg-brand-cream p-4 text-brand-dark/70 text-sm">{area}</div>
              ))}
            </div>
          </div>
          <div class="space-y-4">
            <img
              src="/images/kelingking-beach.jpg"
              alt="Scenic Bali on the way to Ubud from airport"
              class="w-full h-64 object-cover"
              loading="lazy"
            />
            <img
              src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&h=400&fit=crop"
              alt="Ubud rice terraces Bali"
              class="w-full h-48 object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Private Transfer vs Taxi / Ride-Hailing -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Comparison</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Is Private Airport Transfer Better Than Taxi or Grab?</h2>
          <p class="text-brand-dark/60 mt-4 max-w-2xl mx-auto">For many travellers, yes. Because the trip from Bali Airport to Ubud is relatively long, most visitors prefer booking transportation in advance.</p>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-8">
            <p class="text-brand-gold text-xs tracking-widest uppercase mb-4">Private Airport Transfer</p>
            <p class="font-serif text-2xl text-brand-dark mb-4">Best for</p>
            <div class="space-y-2 mb-6">
              {['Families', 'Couples', 'First-time Bali visitors', 'Travellers with luggage', 'Late-night arrivals', 'Long-stay travellers'].map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-3 h-3 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70 text-sm">{item}</span>
                </div>
              ))}
            </div>
            <p class="font-serif text-xl text-brand-dark mb-3">Benefits</p>
            <div class="space-y-2">
              {privateTransferBenefits.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-brand-gold/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-3 h-3 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/70 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-white p-8">
            <p class="text-brand-dark/40 text-xs tracking-widest uppercase mb-4">Taxi or Ride-Hailing Apps</p>
            <p class="font-serif text-2xl text-brand-dark mb-4">Possible Drawbacks</p>
            <div class="space-y-2">
              {taxiDrawbacks.map((item) => (
                <div class="flex items-center gap-3">
                  <div class="w-5 h-5 bg-brand-dark/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-3 h-3 text-brand-dark/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </div>
                  <span class="text-brand-dark/60 text-sm">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Should Book -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Ideal For</p>
            <h2 class="font-serif text-4xl text-brand-dark mb-6">Who Should Book an Airport Transfer to Ubud?</h2>
            <p class="text-brand-dark/70 text-lg leading-relaxed mb-8">
              Private airport transfers are ideal for travellers who value comfort, convenience, and a stress-free arrival. After a long international flight, direct transportation to Ubud helps reduce travel stress and makes arrival easier.
            </p>
            <div class="grid grid-cols-2 gap-3">
              {whoShouldBook.map((type) => (
                <div class="bg-brand-cream p-4 text-brand-dark/70 text-sm">{type}</div>
              ))}
            </div>
          </div>
          <div>
            <img
              src="/images/beach-sunset-swing.jpg"
              alt="Travellers enjoying Bali"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Why Bali West Transport -->
    <section class="py-24 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-16">
          <p class="text-brand-gold text-sm tracking-widest uppercase mb-4">Why Choose Us</p>
          <h2 class="font-serif text-4xl md:text-5xl text-brand-dark">Why Travellers Choose Bali West Transport</h2>
